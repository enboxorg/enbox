# Fly.io Environment Variables Template
# Non-secret values are set in fly.toml [env] section.
# Secrets must be set via: fly secrets set KEY=VALUE

# ===== DATABASE CONFIGURATION =====
# Fly Postgres automatically provides DATABASE_URL when you attach a Postgres cluster.
# Set these secrets to the DATABASE_URL value:
#
#   fly secrets set \
#     DWN_TTL_CACHE_URL="postgres://user:pass@host:5432/db" \
#     DWN_STORAGE_MESSAGES="postgres://user:pass@host:5432/db" \
#     DWN_STORAGE_DATA="postgres://user:pass@host:5432/db" \
#     DWN_STORAGE_RESUMABLE_TASKS="postgres://user:pass@host:5432/db"

# ===== SERVER CONFIGURATION (set in fly.toml [env]) =====
# DS_PORT=8080
# DWN_BASE_URL=https://enbox-dwn.fly.dev
# DS_WEBSOCKET_SERVER=on
# MAX_RECORD_DATA_SIZE=1gb
# DWN_SERVER_LOG_LEVEL=info

# ===== TENANT REGISTRATION + PROVIDER AUTH =====
# Enable provider-auth-v0 open registration (built-in JWT plugin).
# The JWT secret is used to sign/verify registration tokens.
# Set DWN_REGISTRATION_STORE_URL to the database URL to enable registration.
#
#   fly secrets set \
#     DWN_REGISTRATION_STORE_URL="<DATABASE_URL>" \
#     DWN_PROVIDER_AUTH_JWT_SECRET="$(openssl rand -base64 32)"
#
# DWN_PROVIDER_AUTH_ENABLED is set in fly.toml [env].
# The built-in open-auth endpoints (/provider-auth/authorize, /token, /refresh)
# are auto-configured when DWN_PROVIDER_AUTH_JWT_SECRET is set without a plugin path.

# ===== OPTIONAL CONFIGURATION =====
# Uncomment and set as secrets or in fly.toml [env] as needed:

# Enable debug logging (useful for debugging deployments)
# DWN_SERVER_LOG_LEVEL=debug

# Terms of service (if required)
# DWN_TERMS_OF_SERVICE_FILE_PATH=/app/terms-of-service.txt

# ===== FLY.IO SETUP COMMANDS =====
# 1. Create the app:
#    fly apps create enbox-dwn
#
# 2. Create Fly Postgres cluster:
#    fly postgres create --name enbox-db
#
# 3. Attach Postgres to the app:
#    fly postgres attach enbox-db -a enbox-dwn
#
# 4. Set database secrets (use the DATABASE_URL from step 3):
#    fly secrets set \
#      DWN_TTL_CACHE_URL="<DATABASE_URL>" \
#      DWN_STORAGE_MESSAGES="<DATABASE_URL>" \
#      DWN_STORAGE_DATA="<DATABASE_URL>" \
#      DWN_STORAGE_RESUMABLE_TASKS="<DATABASE_URL>"
#
# 5. Enable tenant registration with provider auth:
#    fly secrets set \
#      DWN_REGISTRATION_STORE_URL="<DATABASE_URL>" \
#      DWN_PROVIDER_AUTH_JWT_SECRET="$(openssl rand -base64 32)"
#
# 6. Deploy:
#    fly deploy
#
# 7. Verify:
#    curl https://enbox-dwn.fly.dev/info
#    # Should include: "registrationRequirements":["provider-auth-v0"]
