{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["tsconfig.json", "build/**"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "lint": {},
    "lint:fix": {},
    "test:node": {
      "dependsOn": ["^build"],
      "cache": false
    }
  }
}
