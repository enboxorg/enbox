{
  "name": "@enbox/dids",
  "version": "0.0.2",
  "description": "TBD DIDs library",
  "type": "module",
  "main": "./dist/esm/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/types/index.d.ts",
  "scripts": {
    "clean": "rimraf dist coverage tests/compiled",
    "build:esm": "rimraf dist/esm dist/types && bun tsc -p tsconfig.json",
    "build:browser": "rimraf dist/browser.mjs dist/browser.js && bun build/bundles.js",
    "build:tests:node": "rimraf tests/compiled && bun tsc -p tests/tsconfig.json",
    "build:tests:browser": "rimraf tests/compiled && bun build/esbuild-tests.cjs",
    "build": "bun run clean && bun run build:esm && bun run build:browser",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "test:node": "bun run build:tests:node && bunx c8 mocha",
    "test:browser": "bun run build:tests:browser && bunx web-test-runner"
  },
  "homepage": "https://github.com/enboxorg/enbox/tree/main/packages/dids#readme",
  "bugs": "https://github.com/enboxorg/enbox/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/enboxorg/enbox.git",
    "directory": "packages/dids"
  },
  "license": "Apache-2.0",
  "contributors": [
    {
      "name": "Liran Cohen",
      "url": "https://github.com/LiranCohen"
    },
    {
      "name": "Daniel Buchner",
      "url": "https://github.com/csuwildcat"
    },
    {
      "name": "Frank Hinek",
      "url": "https://github.com/frankhinek"
    },
    {
      "name": "Moe Jangda",
      "url": "https://github.com/mistermoe"
    }
  ],
  "files": [
    "dist",
    "src"
  ],
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/index.js"
    },
    "./utils": {
      "types": "./dist/types/utils.d.ts",
      "import": "./dist/esm/utils.js"
    }
  },
  "react-native": "./dist/esm/index.js",
  "keywords": [
    "decentralized",
    "decentralized-identity",
    "DID",
    "did:ion",
    "did:key",
    "did-utils",
    "self-sovereign-identity",
    "web5"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "bun": ">=1.0.0"
  },
  "dependencies": {
    "@decentralized-identity/ion-sdk": "1.0.4",
    "@dnsquery/dns-packet": "6.1.1",
    "@enbox/common": "workspace:*",
    "@enbox/crypto": "workspace:*",
    "abstract-level": "1.0.4",
    "bencode": "4.0.0",
    "buffer": "6.0.3",
    "level": "8.0.1",
    "ms": "2.1.3"
  },
  "devDependencies": {
    "@playwright/test": "1.45.3",
    "@types/bencode": "2.0.4",
    "@types/chai": "4.3.16",
    "@types/chai-as-promised": "7.1.8",
    "@types/mocha": "10.0.7",
    "@types/ms": "0.7.34",
    "@types/node": "20.14.8",
    "@types/sinon": "17.0.3",
    "@typescript-eslint/eslint-plugin": "8.32.1",
    "@typescript-eslint/parser": "8.32.1",
    "@web/test-runner": "0.18.2",
    "@web/test-runner-playwright": "0.11.0",
    "c8": "9.1.0",
    "chai": "5.1.1",
    "chai-as-promised": "7.1.2",
    "esbuild": "0.23.0",
    "eslint": "9.7.0",
    "eslint-plugin-mocha": "10.4.3",
    "mocha": "10.7.0",
    "mocha-junit-reporter": "2.2.1",
    "playwright": "1.45.3",
    "rimraf": "5.0.7",
    "sinon": "18.0.0",
    "source-map-loader": "5.0.0",
    "typescript": "5.5.4"
  }
}
