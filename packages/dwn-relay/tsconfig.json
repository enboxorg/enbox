{
  "compilerOptions": {
    "lib": ["DOM", "ES6"],
    "allowJs": true,
    "target": "ESNext",
    "module": "NodeNext",
    "declaration": true,
    "declarationMap": true,
    "rootDir": ".",
    "outDir": "./dist/esm",
    "sourceMap": true,
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist"]
}
