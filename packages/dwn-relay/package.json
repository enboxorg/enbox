{
  "name": "@enbox/dwn-relay",
  "type": "module",
  "version": "0.0.1",
  "description": "Storage-constrained DWN relay/cache server",
  "files": [
    "dist",
    "src"
  ],
  "main": "./dist/esm/src/index.js",
  "module": "./dist/esm/src/index.js",
  "exports": {
    ".": {
      "import": "./dist/esm/src/index.js"
    }
  },
  "bin": {
    "dwn-relay": "./dist/esm/src/main.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/enboxorg/enbox.git",
    "directory": "packages/dwn-relay"
  },
  "homepage": "https://github.com/enboxorg/enbox/tree/main/packages/dwn-relay#readme",
  "bugs": {
    "url": "https://github.com/enboxorg/enbox/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@enbox/common": "workspace:*",
    "@enbox/crypto": "workspace:*",
    "@enbox/dids": "workspace:*",
    "@enbox/dwn-clients": "workspace:*",
    "@enbox/dwn-sdk-js": "workspace:*",
    "@enbox/dwn-server": "workspace:*",
    "@enbox/dwn-sql-store": "workspace:*",
    "loglevel": "^1.9.1",
    "loglevel-plugin-prefix": "^0.8.4"
  },
  "devDependencies": {
    "@types/bun": "^1.3.9",
    "@types/node": "20.14.8",
    "@typescript-eslint/eslint-plugin": "8.32.1",
    "@typescript-eslint/parser": "8.32.1",
    "esbuild": "0.16.17",
    "eslint": "9.7.0",
    "rimraf": "^5.0.0",
    "typescript": "5.5.4"
  },
  "scripts": {
    "build:esm": "bun run clean && tsc",
    "build": "bun run clean && bun run build:esm",
    "clean": "rimraf dist",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "test:node": "bun test .test.ts",
    "server": "bun run build:esm && bun dist/esm/src/main.js"
  }
}
