{
  "$schema": "https://codesandbox.io/schemas/tasks.json",
  "setupTasks": [
    {
      "name": "Installing Dependencies",
      "command": "bun install"
    }
  ],
  "tasks": {
    "dev": {
      "name": "Build DWN SDK",
      "command": "bun run build",
      "runAtStart": true,
      "restartOn": {
        "files": ["bun.lock"]
      }
    },
    "tests": {
      "name": "Run tests",
      "command": "bun run test:node"
    }
  }
}
