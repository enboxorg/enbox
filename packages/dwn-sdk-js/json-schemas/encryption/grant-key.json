{
  "$id": "https://identity.foundation/dwn/json-schemas/encryption/grant-key.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "grantId",
    "scope",
    "keyMaterial"
  ],
  "properties": {
    "grantId": {
      "type": "string"
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scheme",
        "protocol"
      ],
      "properties": {
        "scheme": {
          "const": "protocolPath"
        },
        "protocol": {
          "type": "string"
        },
        "protocolPath": {
          "type": "string"
        }
      }
    },
    "keyMaterial": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "derivationScheme",
        "derivationPath",
        "keyId",
        "publicKeyJwk",
        "privateKeyJwk"
      ],
      "properties": {
        "algorithm": {
          "const": "X25519-HKDF-SHA256+A256KW"
        },
        "derivationScheme": {
          "const": "protocolPath"
        },
        "derivationPath": {
          "type": "array",
          "minItems": 2,
          "maxItems": 12,
          "prefixItems": [
            {
              "const": "protocolPath"
            },
            {
              "type": "string",
              "minLength": 1
            }
          ],
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "keyId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{43}$"
        },
        "publicKeyJwk": {
          "$ref": "#/$defs/x25519PublicKey"
        },
        "privateKeyJwk": {
          "$ref": "#/$defs/x25519PrivateKey"
        }
      }
    }
  },
  "$defs": {
    "x25519PublicKey": {
      "allOf": [
        {
          "$ref": "https://identity.foundation/dwn/json-schemas/public-jwk.json"
        }
      ],
      "type": "object",
      "required": [
        "kty",
        "crv",
        "x"
      ],
      "properties": {
        "kty": {
          "const": "OKP"
        },
        "crv": {
          "const": "X25519"
        },
        "x": {
          "$ref": "https://identity.foundation/dwn/json-schemas/defs.json#/$defs/base64url"
        }
      }
    },
    "x25519PrivateKey": {
      "allOf": [
        {
          "$ref": "https://identity.foundation/dwn/json-schemas/general-jwk.json"
        }
      ],
      "type": "object",
      "required": [
        "kty",
        "crv",
        "x",
        "d"
      ],
      "properties": {
        "kty": {
          "const": "OKP"
        },
        "crv": {
          "const": "X25519"
        },
        "x": {
          "$ref": "https://identity.foundation/dwn/json-schemas/defs.json#/$defs/base64url"
        },
        "d": {
          "$ref": "https://identity.foundation/dwn/json-schemas/defs.json#/$defs/base64url"
        }
      }
    }
  }
}
