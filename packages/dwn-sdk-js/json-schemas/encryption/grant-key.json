{
  "$id": "https://identity.foundation/dwn/json-schemas/encryption/grant-key.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "grantId",
    "scope",
    "derivationPath",
    "keyId",
    "publicKeyJwk",
    "privateKeyJwk"
  ],
  "properties": {
    "grantId": {
      "type": "string"
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scheme",
        "protocol"
      ],
      "properties": {
        "scheme": {
          "const": "protocolPath"
        },
        "protocol": {
          "type": "string"
        },
        "protocolPath": {
          "type": "string"
        }
      }
    },
    "derivationPath": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "string"
      }
    },
    "keyId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{43}$"
    },
    "publicKeyJwk": {
      "allOf": [
        {
          "$ref": "https://identity.foundation/dwn/json-schemas/public-jwk.json"
        }
      ],
      "type": "object",
      "required": [
        "kty",
        "crv",
        "x"
      ],
      "properties": {
        "kty": {
          "const": "OKP"
        },
        "crv": {
          "const": "X25519"
        },
        "x": {
          "$ref": "https://identity.foundation/dwn/json-schemas/defs.json#/$defs/base64url"
        }
      }
    },
    "privateKeyJwk": {
      "allOf": [
        {
          "$ref": "https://identity.foundation/dwn/json-schemas/general-jwk.json"
        }
      ],
      "type": "object",
      "required": [
        "kty",
        "crv",
        "x",
        "d"
      ],
      "properties": {
        "kty": {
          "const": "OKP"
        },
        "crv": {
          "const": "X25519"
        },
        "x": {
          "$ref": "https://identity.foundation/dwn/json-schemas/defs.json#/$defs/base64url"
        },
        "d": {
          "$ref": "https://identity.foundation/dwn/json-schemas/defs.json#/$defs/base64url"
        }
      }
    }
  }
}
