{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://identity.foundation/dwn/json-schemas/permissions/scopes.json",
  "type": "object",
  "$defs": {
    "messages-read-scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "interface",
        "method"
      ],
      "properties": {
        "interface": {
          "const": "Messages"
        },
        "method": {
          "const": "Read"
        },
        "module": {
          "type": "string"
        },
        "contextId": {
          "type": "string",
          "maxLength": 600
        },
        "modulePath": {
          "type": "string",
          "maxLength": 600
        }
      },
      "allOf": [
        {
          "not": {
            "required": [
              "contextId",
              "modulePath"
            ]
          }
        },
        {
          "if": {
            "anyOf": [
              {
                "required": [
                  "contextId"
                ]
              },
              {
                "required": [
                  "modulePath"
                ]
              }
            ]
          },
          "then": {
            "required": [
              "module"
            ]
          }
        }
      ]
    },
    "modules-configure-scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "interface",
        "method"
      ],
      "properties": {
        "interface": {
          "const": "Modules"
        },
        "method": {
          "const": "Configure"
        },
        "module": {
          "type": "string"
        }
      }
    },
    "modules-query-scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "interface",
        "method"
      ],
      "properties": {
        "interface": {
          "const": "Modules"
        },
        "method": {
          "const": "Query"
        },
        "module": {
          "type": "string"
        }
      }
    },
    "records-delete-scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "interface",
        "method",
        "module"
      ],
      "properties": {
        "interface": {
          "const": "Records"
        },
        "method": {
          "const": "Delete"
        },
        "module": {
          "type": "string"
        },
        "contextId": {
          "type": "string",
          "maxLength": 600
        },
        "modulePath": {
          "type": "string",
          "maxLength": 600
        }
      }
    },
    "records-read-scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "interface",
        "method",
        "module"
      ],
      "properties": {
        "interface": {
          "const": "Records"
        },
        "method": {
          "const": "Read"
        },
        "module": {
          "type": "string"
        },
        "contextId": {
          "type": "string",
          "maxLength": 600
        },
        "modulePath": {
          "type": "string",
          "maxLength": 600
        }
      }
    },
    "records-write-scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "interface",
        "method",
        "module"
      ],
      "properties": {
        "interface": {
          "const": "Records"
        },
        "method": {
          "const": "Write"
        },
        "module": {
          "type": "string"
        },
        "contextId": {
          "type": "string",
          "maxLength": 600
        },
        "modulePath": {
          "type": "string",
          "maxLength": 600
        }
      }
    }
  }
}
