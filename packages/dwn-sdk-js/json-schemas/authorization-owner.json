{
  "$id": "https://enbox.org/dwn/json-schemas/authorization-owner.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "signature": {
      "$ref": "https://enbox.org/dwn/json-schemas/general-jws.json"
    },
    "authorDelegatedGrant": {
      "$ref": "https://enbox.org/dwn/json-schemas/records-write-data-encoded.json"
    },
    "ownerSignature": {
      "$ref": "https://enbox.org/dwn/json-schemas/general-jws.json"
    },
    "ownerDelegatedGrant": {
      "$ref": "https://enbox.org/dwn/json-schemas/records-write-data-encoded.json"
    },
    "authorKeyDeliveryPublicKey": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rootKeyId", "publicKeyJwk"],
      "properties": {
        "rootKeyId": {
          "type": "string"
        },
        "publicKeyJwk": {
          "$ref": "https://enbox.org/dwn/json-schemas/public-jwk.json"
        }
      }
    }
  },
  "description": "`signature` can exist by itself. But if `ownerSignature` is present, then `signature` must also exist",
  "dependencies": {
    "ownerSignature": [
      "signature"
    ]
  }
}