{
  "name": "@enbox/agent",
  "version": "0.8.17",
  "type": "module",
  "main": "./dist/esm/index.js",
  "module": "./dist/esm/index.js",
  "browser": "./dist/browser.mjs",
  "sideEffects": false,
  "types": "./dist/types/index.d.ts",
  "scripts": {
    "clean": "rm -rf dist",
    "build:esm": "rm -rf dist/esm dist/types && bun tsc -p tsconfig.json",
    "build:browser": "rm -rf dist/browser.mjs && bun ../../build/browser-bundle.js --alias ./dwn-discovery-file-fs.js:./src/dwn-discovery-file-fs.browser.ts --external @enbox/common --external @enbox/crypto --external @enbox/dids --external @enbox/dwn-clients --external @enbox/dwn-sdk-js",
    "build": "bun run clean && bun run build:esm && bun run build:browser",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "test:node": "bun test --timeout 10000 $(find tests -name '*.spec.ts' -not -path 'tests/e2e/*')",
    "test:node:coverage": "bun test --timeout 10000 --coverage --coverage-reporter=text --coverage-reporter=lcov --coverage-dir=coverage $(find tests -name '*.spec.ts' -not -path 'tests/e2e/*')",
    "test:e2e": "bun test --timeout 120000 tests/e2e/*.e2e.spec.ts",
    "test:browser": "bunx --bun vitest --config vitest.browser.config.ts --run",
    "test:browser:coverage": "bunx --bun vitest --config vitest.browser.config.ts --run --coverage --coverage.provider=istanbul"
  },
  "homepage": "https://github.com/enboxorg/enbox/tree/main/packages/agent#readme",
  "bugs": "https://github.com/enboxorg/enbox/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/enboxorg/enbox.git",
    "directory": "packages/agent"
  },
  "license": "Apache-2.0",
  "contributors": [
    {
      "name": "Liran Cohen",
      "url": "https://github.com/LiranCohen"
    },
    {
      "name": "Daniel Buchner",
      "url": "https://github.com/csuwildcat"
    },
    {
      "name": "Frank Hinek",
      "url": "https://github.com/frankhinek"
    },
    {
      "name": "Moe Jangda",
      "url": "https://github.com/mistermoe"
    }
  ],
  "files": [
    "dist",
    "src"
  ],
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "browser": "./dist/browser.mjs",
      "import": "./dist/esm/index.js"
    },
    "./level": {
      "types": "./dist/types/level.d.ts",
      "import": "./dist/esm/level.js"
    },
    "./test": {
      "types": "./dist/types/test.d.ts",
      "import": "./dist/esm/test.js"
    }
  },
  "react-native": "./dist/esm/index.js",
  "keywords": [
    "decentralized",
    "decentralized-applications",
    "decentralized-identity",
    "decentralized-web",
    "vcs",
    "verifiable credentials",
    "web5"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "bun": ">=1.3.14"
  },
  "dependencies": {
    "@scure/bip39": "2.2.0",
    "@enbox/connect": "workspace:*",
    "@enbox/dwn-clients": "workspace:*",
    "@enbox/dwn-sdk-js": "workspace:*",
    "@enbox/common": "workspace:*",
    "@enbox/crypto": "workspace:*",
    "@enbox/dids": "workspace:*",
    "@noble/curves": "2.2.0",
    "@noble/hashes": "2.2.0",
    "abstract-level": "1.0.4",
    "interface-blockstore": "7.0.1",
    "interface-store": "8.0.0",
    "ipfs-unixfs-exporter": "16.0.2",
    "level": "8.0.1"
  },
  "devDependencies": {
    "@types/node": "22.19.15",
    "@types/sinon": "17.0.3",
    "@typescript-eslint/eslint-plugin": "8.32.1",
    "@typescript-eslint/parser": "8.32.1",
    "@vitest/browser-playwright": "4.0.18",
    "@vitest/coverage-istanbul": "4.0.18",
    "bun-types": "1.3.14",
    "eslint": "9.7.0",
    "sinon": "18.0.0",
    "typescript": "5.9.3",
    "vitest": "4.0.18"
  }
}
