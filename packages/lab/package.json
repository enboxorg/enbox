{
  "name": "@enbox/lab",
  "version": "0.0.0",
  "private": true,
  "description": "Local isolated Enbox environment controller and proof harnesses",
  "type": "module",
  "main": "./dist/esm/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/types/index.d.ts",
  "bin": {
    "enbox-lab": "./dist/esm/cli.js"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build:esm": "rm -rf dist/esm dist/types && bun tsc -p tsconfig.json",
    "build": "bun run clean && bun run build:esm",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "test:node": "bun test --max-concurrency=1 --timeout 30000 .spec.ts",
    "test:node:coverage": "bun test --max-concurrency=1 --timeout 30000 --coverage --coverage-reporter=text --coverage-reporter=lcov --coverage-dir=coverage .spec.ts"
  },
  "engines": {
    "bun": ">=1.3.14"
  },
  "dependencies": {
    "@enbox/agent": "workspace:*",
    "@enbox/browser": "workspace:*",
    "@enbox/connect": "workspace:*",
    "@enbox/crypto": "workspace:*",
    "@enbox/dids": "workspace:*"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "eslint": "9.7.0",
    "playwright": "1.55.1",
    "typescript": "5.9.3"
  }
}
