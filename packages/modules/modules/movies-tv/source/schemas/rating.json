{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://enbox.id/modules/movies-tv/v1/schemas/rating",
  "title": "RatingData",
  "description": "Movies and TV: rating record.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "rating": {
      "$ref": "#/definitions/ratingRating"
    },
    "review": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32768
    },
    "ratedAt": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "format": "date-time"
    },
    "notes": {
      "$ref": "https://enbox.id/schemas/common/note-text/v1"
    },
    "source": {
      "$ref": "#/definitions/ratingSource"
    },
    "labels": {
      "$ref": "https://enbox.id/schemas/common/labels/v1"
    }
  },
  "required": [
    "rating"
  ],
  "examples": [
    {
      "rating": {
        "value": 8,
        "scale": 10
      }
    }
  ],
  "definitions": {
    "ratingRating": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "value": {
          "type": "number",
          "minimum": 0,
          "maximum": 10
        },
        "scale": {
          "type": "integer",
          "enum": [
            5,
            10
          ]
        }
      },
      "required": [
        "value",
        "scale"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "scale": {
                "const": 5
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "maximum": 5,
                "type": "number"
              }
            }
          }
        }
      ]
    },
    "ratingRecordReference": {
      "$ref": "https://enbox.id/schemas/common/record-reference/v1"
    },
    "ratingSource": {
      "$ref": "https://enbox.id/schemas/common/provenance/v1"
    }
  }
}
