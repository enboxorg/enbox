{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://enbox.id/modules/movies-tv/v1/schemas/title",
  "title": "TitleData",
  "description": "Movies and TV: title record.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "kind": {
      "type": "string",
      "enum": [
        "film",
        "series"
      ]
    },
    "releaseYear": {
      "type": "integer",
      "minimum": 1880,
      "maximum": 2200
    },
    "externalIds": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "system": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "value": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          }
        },
        "required": [
          "system",
          "value"
        ]
      },
      "minItems": 0,
      "maxItems": 30
    },
    "state": {
      "type": "string",
      "enum": [
        "want-to-watch",
        "watching",
        "finished",
        "paused",
        "abandoned"
      ]
    },
    "genres": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 80
      },
      "uniqueItems": true,
      "maxItems": 64
    },
    "url": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8192,
      "format": "uri"
    },
    "notes": {
      "$ref": "https://enbox.id/schemas/common/note-text/v1"
    },
    "source": {
      "$ref": "#/definitions/titleSource"
    },
    "labels": {
      "$ref": "https://enbox.id/schemas/common/labels/v1"
    }
  },
  "required": [
    "name",
    "kind",
    "state"
  ],
  "examples": [
    {
      "name": "Example series",
      "kind": "series",
      "state": "watching"
    }
  ],
  "definitions": {
    "titleRecordReference": {
      "$ref": "https://enbox.id/schemas/common/record-reference/v1"
    },
    "titleSource": {
      "$ref": "https://enbox.id/schemas/common/provenance/v1"
    }
  }
}
