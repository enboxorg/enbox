{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://enbox.id/modules/movies-tv/v1/schemas/viewing",
  "title": "ViewingData",
  "description": "Movies and TV: viewing record.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "watchedAt": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "format": "date-time"
    },
    "season": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10000
    },
    "episode": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100000
    },
    "positionSeconds": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10000000
    },
    "completed": {
      "type": "boolean"
    },
    "withContacts": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/viewingRecordReference"
      },
      "minItems": 0,
      "maxItems": 50
    },
    "notes": {
      "$ref": "https://enbox.id/schemas/common/note-text/v1"
    },
    "source": {
      "$ref": "#/definitions/viewingSource"
    },
    "labels": {
      "$ref": "https://enbox.id/schemas/common/labels/v1"
    }
  },
  "required": [
    "watchedAt"
  ],
  "examples": [
    {
      "watchedAt": "2026-01-15T12:00:00Z",
      "season": 2,
      "episode": 5,
      "completed": true
    }
  ],
  "definitions": {
    "viewingRecordReference": {
      "$ref": "https://enbox.id/schemas/common/record-reference/v1"
    },
    "viewingSource": {
      "$ref": "https://enbox.id/schemas/common/provenance/v1"
    }
  }
}
