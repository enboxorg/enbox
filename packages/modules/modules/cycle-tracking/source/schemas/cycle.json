{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://enbox.id/modules/cycle-tracking/v1/schemas/cycle",
  "title": "CycleData",
  "description": "Cycle Tracking: cycle record.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "startedOn": {
      "type": "string",
      "minLength": 1,
      "maxLength": 10,
      "format": "date"
    },
    "endedOn": {
      "type": "string",
      "minLength": 1,
      "maxLength": 10,
      "format": "date"
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8192
    },
    "notes": {
      "$ref": "https://enbox.id/schemas/common/note-text/v1"
    },
    "source": {
      "$ref": "#/definitions/cycleSource"
    },
    "labels": {
      "$ref": "https://enbox.id/schemas/common/labels/v1"
    }
  },
  "required": [
    "startedOn"
  ],
  "examples": [
    {
      "startedOn": "2026-01-15"
    }
  ],
  "definitions": {
    "cycleRecordReference": {
      "$ref": "https://enbox.id/schemas/common/record-reference/v1"
    },
    "cycleSource": {
      "$ref": "https://enbox.id/schemas/common/provenance/v1"
    }
  }
}
