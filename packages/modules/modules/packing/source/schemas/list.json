{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://enbox.id/modules/packing/v1/schemas/list",
  "title": "ListData",
  "description": "Packing: list record.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "trip": {
      "$ref": "#/definitions/listRecordReference"
    },
    "traveller": {
      "$ref": "#/definitions/listRecordReference"
    },
    "state": {
      "type": "string",
      "enum": [
        "planning",
        "packing",
        "ready",
        "archived"
      ]
    },
    "notes": {
      "$ref": "https://enbox.id/schemas/common/note-text/v1"
    },
    "source": {
      "$ref": "#/definitions/listSource"
    },
    "labels": {
      "$ref": "https://enbox.id/schemas/common/labels/v1"
    }
  },
  "required": [
    "name"
  ],
  "examples": [
    {
      "name": "Weekend packing"
    }
  ],
  "definitions": {
    "listRecordReference": {
      "$ref": "https://enbox.id/schemas/common/record-reference/v1"
    },
    "listSource": {
      "$ref": "https://enbox.id/schemas/common/provenance/v1"
    }
  }
}
