{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://enbox.id/modules/packing/v1/schemas/item",
  "title": "ItemData",
  "description": "Packing: item record.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "quantity": {
      "$ref": "#/definitions/itemQuantity"
    },
    "belonging": {
      "$ref": "#/definitions/itemRecordReference"
    },
    "bag": {
      "$ref": "#/definitions/itemRecordReference"
    },
    "traveller": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "state": {
      "type": "string",
      "enum": [
        "needed",
        "packed",
        "unpacked",
        "not-taking"
      ]
    },
    "sortOrder": {
      "type": "number",
      "minimum": 0,
      "maximum": 1000000000
    },
    "notes": {
      "type": "string",
      "minLength": 0,
      "maxLength": 32768
    },
    "source": {
      "$ref": "#/definitions/itemSource"
    },
    "labels": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 80
      },
      "uniqueItems": true,
      "maxItems": 64
    }
  },
  "required": [
    "name",
    "state"
  ],
  "examples": [
    {
      "name": "Spare shirts",
      "quantity": {
        "value": "2",
        "unit": "piece"
      },
      "state": "needed"
    }
  ],
  "definitions": {
    "itemQuantity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "value": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$"
        },
        "unit": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      },
      "required": [
        "value",
        "unit"
      ],
      "description": "A supplied decimal quantity with an explicit unit."
    },
    "itemRecordReference": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "recordId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "tenantDid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^did:[a-z0-9]+:[^\\s]+$"
        },
        "moduleUri": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192,
          "format": "uri"
        },
        "modulePath": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "contextId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "messageCid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      },
      "required": [
        "recordId"
      ],
      "description": "A DWN record link. An omitted tenantDid means the DID owning the referring record. A link grants no access."
    },
    "itemSource": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "user-statement",
            "document-extraction",
            "import",
            "measurement",
            "derived"
          ]
        },
        "uri": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192,
          "format": "uri"
        },
        "record": {
          "$ref": "#/definitions/itemRecordReference"
        },
        "conversationId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "messageId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "observedAt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "format": "date-time"
        },
        "actorDid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^did:[a-z0-9]+:[^\\s]+$"
        },
        "extractor": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "extractorVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "reviewedAt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "format": "date-time"
        },
        "reviewerDid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^did:[a-z0-9]+:[^\\s]+$"
        }
      },
      "required": [
        "kind"
      ]
    }
  }
}
