{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://enbox.id/modules/vehicles/v1/schemas/registration",
  "title": "RegistrationData",
  "description": "One vehicle registration issued by a jurisdiction. Keep a new issuance or renewal as its own record.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "registrationNumber": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "description": "Identifier printed for the registration."
    },
    "plateNumber": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "description": "Displayed plate identifier, retaining punctuation, case and leading zeros."
    },
    "jurisdiction": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "country": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2,
          "pattern": "^[A-Z]{2}$",
          "description": "ISO 3166-1 alpha-2 country code."
        },
        "region": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "authority": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      },
      "required": [
        "country"
      ]
    },
    "registeredHolder": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "description": "Holder name as printed on the registration."
    },
    "issuedOn": {
      "type": "string",
      "format": "date"
    },
    "expiresOn": {
      "type": "string",
      "format": "date"
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": {
        "$ref": "#/definitions/registrationRecordReference"
      }
    }
  },
  "required": [
    "jurisdiction"
  ],
  "anyOf": [
    {
      "required": [
        "plateNumber"
      ]
    },
    {
      "required": [
        "registrationNumber"
      ]
    }
  ],
  "examples": [
    {
      "plateNumber": "00-DEMO",
      "jurisdiction": {
        "country": "CA",
        "region": "Ontario"
      },
      "issuedOn": "2026-02-01",
      "expiresOn": "2027-01-31"
    }
  ],
  "definitions": {
    "registrationRecordReference": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "recordId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "tenantDid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^did:[a-z0-9]+:[^\\s]+$"
        },
        "moduleUri": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192,
          "format": "uri"
        },
        "modulePath": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "contextId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "messageCid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      },
      "required": [
        "recordId"
      ],
      "description": "A DWN record link. An omitted tenantDid means the DID owning the referring record. A link grants no access."
    }
  }
}
