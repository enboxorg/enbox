{
  "module": "https://enbox.id/modules/vehicles/v1",
  "published": true,
  "uses": {
    "belongings": "https://enbox.id/modules/belongings/v1"
  },
  "types": {
    "vehicle": {
      "dataFormats": [
        "application/json"
      ],
      "encryptionRequired": true,
      "schema": "https://enbox.id/modules/vehicles/v1/schemas/vehicle"
    },
    "odometer": {
      "dataFormats": [
        "application/json"
      ],
      "encryptionRequired": true,
      "schema": "https://enbox.id/modules/vehicles/v1/schemas/odometer"
    },
    "energy": {
      "dataFormats": [
        "application/json"
      ],
      "encryptionRequired": true,
      "schema": "https://enbox.id/modules/vehicles/v1/schemas/energy"
    }
  },
  "structure": {
    "item": {
      "$ref": "belongings:item",
      "vehicle": {
        "$size": {
          "max": 1048576
        },
        "$actions": [
          {
            "role": "belongings:item/editor",
            "can": [
              "create",
              "read",
              "co-update",
              "co-delete",
              "co-prune"
            ]
          },
          {
            "role": "belongings:item/viewer",
            "can": [
              "read"
            ]
          }
        ],
        "odometer": {
          "$size": {
            "max": 1048576
          },
          "$immutable": true,
          "$actions": [
            {
              "role": "belongings:item/editor",
              "can": [
                "create",
                "read",
                "co-delete"
              ]
            },
            {
              "role": "belongings:item/viewer",
              "can": [
                "read"
              ]
            }
          ]
        },
        "energy": {
          "$size": {
            "max": 1048576
          },
          "$immutable": true,
          "$actions": [
            {
              "role": "belongings:item/editor",
              "can": [
                "create",
                "read",
                "co-delete"
              ]
            },
            {
              "role": "belongings:item/viewer",
              "can": [
                "read"
              ]
            }
          ]
        }
      }
    }
  }
}
