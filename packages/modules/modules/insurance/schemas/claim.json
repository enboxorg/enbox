{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://enbox.id/modules/insurance/v1/schemas/claim",
  "title": "ClaimData",
  "description": "Insurance: claim record.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "reference": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "incidentOn": {
      "type": "string",
      "minLength": 1,
      "maxLength": 10,
      "format": "date"
    },
    "reportedAt": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "format": "date-time"
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 16384
    },
    "state": {
      "type": "string",
      "enum": [
        "opened",
        "submitted",
        "reviewing",
        "accepted",
        "rejected",
        "paid",
        "closed"
      ]
    },
    "claimedAmount": {
      "$ref": "#/definitions/claimMoney"
    },
    "settledAmount": {
      "$ref": "#/definitions/claimMoney"
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/claimRecordReference"
      },
      "minItems": 0,
      "maxItems": 100
    },
    "notes": {
      "$ref": "#/definitions/claimNoteText"
    },
    "source": {
      "$ref": "#/definitions/claimSource"
    },
    "labels": {
      "$ref": "#/definitions/claimLabels"
    }
  },
  "required": [
    "description",
    "state"
  ],
  "examples": [
    {
      "description": "Water damage report",
      "state": "opened"
    }
  ],
  "definitions": {
    "claimMoney": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "amount": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$"
        },
        "currency": {
          "type": "string",
          "minLength": 1,
          "maxLength": 3,
          "pattern": "^[A-Z]{3}$"
        }
      },
      "required": [
        "amount",
        "currency"
      ],
      "description": "Non-negative decimal amount in an explicitly named currency; no floating-point currency conversion."
    },
    "claimRecordReference": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "recordId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "tenantDid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^did:[a-z0-9]+:[^\\s]+$"
        },
        "moduleUri": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192,
          "format": "uri"
        },
        "modulePath": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "contextId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "messageCid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      },
      "required": [
        "recordId"
      ],
      "description": "A DWN record link. An omitted tenantDid means the DID owning the referring record. A link grants no access."
    },
    "claimSource": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "user-statement",
            "document-extraction",
            "import",
            "measurement",
            "derived"
          ]
        },
        "uri": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192,
          "format": "uri"
        },
        "record": {
          "$ref": "#/definitions/claimRecordReference"
        },
        "conversationId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "messageId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "observedAt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "format": "date-time"
        },
        "actorDid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^did:[a-z0-9]+:[^\\s]+$"
        },
        "extractor": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "extractorVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "reviewedAt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "format": "date-time"
        },
        "reviewerDid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^did:[a-z0-9]+:[^\\s]+$"
        }
      },
      "required": [
        "kind"
      ]
    },
    "claimNoteText": {
      "type": "string",
      "minLength": 0,
      "maxLength": 32768
    },
    "claimLabels": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 80
      },
      "uniqueItems": true,
      "maxItems": 64
    }
  }
}
