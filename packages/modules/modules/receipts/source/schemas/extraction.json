{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://enbox.id/modules/receipts/v1/schemas/extraction",
  "title": "ExtractionData",
  "description": "Receipts: extraction record.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "sourceFile": {
      "$ref": "#/definitions/extractionRecordReference"
    },
    "extractedAt": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "format": "date-time"
    },
    "extractor": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "text": {
      "type": "string",
      "minLength": 0,
      "maxLength": 1000000
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "notes": {
      "$ref": "https://enbox.id/schemas/common/note-text/v1"
    },
    "source": {
      "$ref": "#/definitions/extractionSource"
    },
    "labels": {
      "$ref": "https://enbox.id/schemas/common/labels/v1"
    }
  },
  "required": [
    "sourceFile",
    "extractedAt",
    "extractor"
  ],
  "examples": [
    {
      "sourceFile": {
        "recordId": "example-record"
      },
      "extractedAt": "2026-01-15T12:00:00Z",
      "extractor": "manual-import"
    }
  ],
  "definitions": {
    "extractionRecordReference": {
      "$ref": "https://enbox.id/schemas/common/record-reference/v1"
    },
    "extractionSource": {
      "$ref": "https://enbox.id/schemas/common/provenance/v1"
    }
  }
}
