      "singleton": false
    },
    {
      "path": "receipt/item",
      "type": "item",
      "dataFormats": [
        "application/json"
      ],
      "encryptionRequired": true,
      "schema": "https://enbox.id/modules/receipts/v1/schemas/item",
      "schemaFile": "schemas/item.json",
      "role": false,
      "immutable": false,
      "singleton": false
    },
    {
      "path": "receipt/extraction",
      "type": "extraction",
      "dataFormats": [
        "application/json"
      ],
      "encryptionRequired": true,
      "schema": "https://enbox.id/modules/receipts/v1/schemas/extraction",
      "schemaFile": "schemas/extraction.json",
      "role": false,
      "immutable": true,
      "singleton": false
    }
  ]
}
