{
  "id": "receipts",
  "name": "Receipts",
  "category": "Money and investing",
  "description": "Structured purchase evidence: merchant, date, line items, totals, and source-file references.",
  "moduleUri": "https://enbox.id/modules/receipts/v1",
  "exportName": "ReceiptsModule",
  "status": "experimental",
  "definitionFile": "definition.json",
