{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://enbox.id/modules/medications/v1/schemas/medication",
  "title": "MedicationData",
  "description": "Medications: medication record.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "brand": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "form": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "strength": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "state": {
      "type": "string",
      "enum": [
        "current",
        "paused",
        "stopped",
        "historical"
      ]
    },
    "prescriber": {
      "$ref": "#/definitions/medicationRecordReference"
    },
    "prescription": {
      "$ref": "#/definitions/medicationRecordReference"
    },
    "instructions": {
      "type": "string",
      "minLength": 1,
      "maxLength": 16384
    },
    "notes": {
      "$ref": "https://enbox.id/schemas/common/note-text/v1"
    },
    "source": {
      "$ref": "#/definitions/medicationSource"
    },
    "labels": {
      "$ref": "https://enbox.id/schemas/common/labels/v1"
    }
  },
  "required": [
    "name",
    "state"
  ],
  "examples": [
    {
      "name": "Example prescribed medicine",
      "state": "current"
    }
  ],
  "definitions": {
    "medicationRecordReference": {
      "$ref": "https://enbox.id/schemas/common/record-reference/v1"
    },
    "medicationSource": {
      "$ref": "https://enbox.id/schemas/common/provenance/v1"
    }
  }
}
