{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://enbox.id/modules/routes/v1/schemas/track",
  "title": "TrackData",
  "description": "Routes: track record.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "startedAt": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "format": "date-time"
    },
    "endedAt": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "format": "date-time"
    },
    "distance": {
      "$ref": "#/definitions/trackQuantity"
    },
    "geometryFile": {
      "$ref": "#/definitions/trackRecordReference"
    },
    "workout": {
      "$ref": "#/definitions/trackRecordReference"
    },
    "points": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "at": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "format": "date-time"
          },
          "coordinates": {
            "$ref": "#/definitions/trackCoordinates"
          }
        },
        "required": [
          "at",
          "coordinates"
        ]
      },
      "minItems": 0,
      "maxItems": 10000
    },
    "notes": {
      "$ref": "https://enbox.id/schemas/common/note-text/v1"
    },
    "source": {
      "$ref": "#/definitions/trackSource"
    },
    "labels": {
      "$ref": "https://enbox.id/schemas/common/labels/v1"
    }
  },
  "required": [
    "startedAt"
  ],
  "examples": [
    {
      "startedAt": "2026-01-15T12:00:00Z",
      "points": [
        {
          "at": "2026-01-15T12:00:00Z",
          "coordinates": {
            "latitude": 38.7223,
            "longitude": -9.1393
          }
        }
      ]
    }
  ],
  "anyOf": [
    {
      "required": [
        "geometryFile"
      ]
    },
    {
      "required": [
        "points"
      ],
      "properties": {
        "points": {
          "type": "array",
          "minItems": 1
        }
      }
    }
  ],
  "definitions": {
    "trackCoordinates": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "latitude": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "longitude": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        "altitudeMeters": {
          "type": "number",
          "minimum": -12000,
          "maximum": 100000
        }
      },
      "required": [
        "latitude",
        "longitude"
      ]
    },
    "trackQuantity": {
      "$ref": "https://enbox.id/schemas/common/quantity/v1"
    },
    "trackRecordReference": {
      "$ref": "https://enbox.id/schemas/common/record-reference/v1"
    },
    "trackSource": {
      "$ref": "https://enbox.id/schemas/common/provenance/v1"
    }
  }
}
