{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://enbox.id/modules/routes/v1/schemas/waypoint",
  "title": "WaypointData",
  "description": "Routes: waypoint record.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "coordinates": {
      "$ref": "#/definitions/waypointCoordinates"
    },
    "place": {
      "$ref": "#/definitions/waypointRecordReference"
    },
    "order": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000000
    },
    "notes": {
      "$ref": "https://enbox.id/schemas/common/note-text/v1"
    },
    "source": {
      "$ref": "#/definitions/waypointSource"
    },
    "labels": {
      "$ref": "https://enbox.id/schemas/common/labels/v1"
    }
  },
  "required": [
    "name",
    "order"
  ],
  "examples": [
    {
      "name": "Station",
      "order": 0,
      "coordinates": {
        "latitude": 38.7223,
        "longitude": -9.1393
      }
    }
  ],
  "anyOf": [
    {
      "required": [
        "coordinates"
      ]
    },
    {
      "required": [
        "place"
      ]
    }
  ],
  "definitions": {
    "waypointCoordinates": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "latitude": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "longitude": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        "altitudeMeters": {
          "type": "number",
          "minimum": -12000,
          "maximum": 100000
        }
      },
      "required": [
        "latitude",
        "longitude"
      ]
    },
    "waypointRecordReference": {
      "$ref": "https://enbox.id/schemas/common/record-reference/v1"
    },
    "waypointSource": {
      "$ref": "https://enbox.id/schemas/common/provenance/v1"
    }
  }
}
