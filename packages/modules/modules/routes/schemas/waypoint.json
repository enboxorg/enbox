{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://enbox.id/modules/routes/v1/schemas/waypoint",
  "title": "WaypointData",
  "description": "Routes: waypoint record.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "coordinates": {
      "$ref": "#/definitions/waypointCoordinates"
    },
    "place": {
      "$ref": "#/definitions/waypointRecordReference"
    },
    "order": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000000
    },
    "notes": {
      "$ref": "#/definitions/waypointNoteText"
    },
    "source": {
      "$ref": "#/definitions/waypointSource"
    },
    "labels": {
      "$ref": "#/definitions/waypointLabels"
    }
  },
  "required": [
    "name",
    "order"
  ],
  "examples": [
    {
      "name": "Station",
      "order": 0,
      "coordinates": {
        "latitude": 38.7223,
        "longitude": -9.1393
      }
    }
  ],
  "anyOf": [
    {
      "required": [
        "coordinates"
      ]
    },
    {
      "required": [
        "place"
      ]
    }
  ],
  "definitions": {
    "waypointCoordinates": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "latitude": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "longitude": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        "altitudeMeters": {
          "type": "number",
          "minimum": -12000,
          "maximum": 100000
        }
      },
      "required": [
        "latitude",
        "longitude"
      ]
    },
    "waypointRecordReference": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "recordId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "tenantDid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^did:[a-z0-9]+:[^\\s]+$"
        },
        "moduleUri": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192,
          "format": "uri"
        },
        "modulePath": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "contextId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "messageCid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      },
      "required": [
        "recordId"
      ],
      "description": "A DWN record link. An omitted tenantDid means the DID owning the referring record. A link grants no access."
    },
    "waypointSource": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "user-statement",
            "document-extraction",
            "import",
            "measurement",
            "derived"
          ]
        },
        "uri": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192,
          "format": "uri"
        },
        "record": {
          "$ref": "#/definitions/waypointRecordReference"
        },
        "conversationId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "messageId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "observedAt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "format": "date-time"
        },
        "actorDid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^did:[a-z0-9]+:[^\\s]+$"
        },
        "extractor": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "extractorVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "reviewedAt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "format": "date-time"
        },
        "reviewerDid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^did:[a-z0-9]+:[^\\s]+$"
        }
      },
      "required": [
        "kind"
      ]
    },
    "waypointNoteText": {
      "type": "string",
      "minLength": 0,
      "maxLength": 32768
    },
    "waypointLabels": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 80
      },
      "uniqueItems": true,
      "maxItems": 64
    }
  }
}
