{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://enbox.id/modules/routes/v1/schemas/track",
  "title": "TrackData",
  "description": "Routes: track record.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "startedAt": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "format": "date-time"
    },
    "endedAt": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "format": "date-time"
    },
    "distance": {
      "$ref": "#/definitions/trackQuantity"
    },
    "geometryFile": {
      "$ref": "#/definitions/trackRecordReference"
    },
    "workout": {
      "$ref": "#/definitions/trackRecordReference"
    },
    "points": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "at": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "format": "date-time"
          },
          "coordinates": {
            "$ref": "#/definitions/trackCoordinates"
          }
        },
        "required": [
          "at",
          "coordinates"
        ]
      },
      "minItems": 0,
      "maxItems": 10000
    },
    "notes": {
      "$ref": "#/definitions/trackNoteText"
    },
    "source": {
      "$ref": "#/definitions/trackSource"
    },
    "labels": {
      "$ref": "#/definitions/trackLabels"
    }
  },
  "required": [
    "startedAt"
  ],
  "examples": [
    {
      "startedAt": "2026-01-15T12:00:00Z",
      "points": [
        {
          "at": "2026-01-15T12:00:00Z",
          "coordinates": {
            "latitude": 38.7223,
            "longitude": -9.1393
          }
        }
      ]
    }
  ],
  "anyOf": [
    {
      "required": [
        "geometryFile"
      ]
    },
    {
      "required": [
        "points"
      ],
      "properties": {
        "points": {
          "type": "array",
          "minItems": 1
        }
      }
    }
  ],
  "definitions": {
    "trackCoordinates": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "latitude": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "longitude": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        "altitudeMeters": {
          "type": "number",
          "minimum": -12000,
          "maximum": 100000
        }
      },
      "required": [
        "latitude",
        "longitude"
      ]
    },
    "trackQuantity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "value": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$"
        },
        "unit": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      },
      "required": [
        "value",
        "unit"
      ],
      "description": "A supplied decimal quantity with an explicit unit."
    },
    "trackRecordReference": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "recordId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "tenantDid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^did:[a-z0-9]+:[^\\s]+$"
        },
        "moduleUri": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192,
          "format": "uri"
        },
        "modulePath": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "contextId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "messageCid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      },
      "required": [
        "recordId"
      ],
      "description": "A DWN record link. An omitted tenantDid means the DID owning the referring record. A link grants no access."
    },
    "trackSource": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "user-statement",
            "document-extraction",
            "import",
            "measurement",
            "derived"
          ]
        },
        "uri": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192,
          "format": "uri"
        },
        "record": {
          "$ref": "#/definitions/trackRecordReference"
        },
        "conversationId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "messageId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "observedAt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "format": "date-time"
        },
        "actorDid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^did:[a-z0-9]+:[^\\s]+$"
        },
        "extractor": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "extractorVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "reviewedAt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "format": "date-time"
        },
        "reviewerDid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^did:[a-z0-9]+:[^\\s]+$"
        }
      },
      "required": [
        "kind"
      ]
    },
    "trackNoteText": {
      "type": "string",
      "minLength": 0,
      "maxLength": 32768
    },
    "trackLabels": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 80
      },
      "uniqueItems": true,
      "maxItems": 64
    }
  }
}
