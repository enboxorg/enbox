{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://enbox.id/modules/contacts/v1/schemas/interaction",
  "title": "InteractionData",
  "description": "Contacts: interaction record.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "occurredAt": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "format": "date-time"
    },
    "kind": {
      "type": "string",
      "enum": [
        "meeting",
        "call",
        "message",
        "other"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8192
    },
    "conversation": {
      "$ref": "#/definitions/interactionRecordReference"
    },
    "event": {
      "$ref": "#/definitions/interactionRecordReference"
    },
    "note": {
      "$ref": "#/definitions/interactionRecordReference"
    },
    "notes": {
      "$ref": "https://enbox.id/schemas/common/note-text/v1"
    },
    "source": {
      "$ref": "#/definitions/interactionSource"
    },
    "labels": {
      "$ref": "https://enbox.id/schemas/common/labels/v1"
    }
  },
  "required": [
    "occurredAt",
    "kind"
  ],
  "examples": [
    {
      "occurredAt": "2026-01-15T12:00:00Z",
      "kind": "call",
      "summary": "Discussed the weekend plan."
    }
  ],
  "definitions": {
    "interactionRecordReference": {
      "$ref": "https://enbox.id/schemas/common/record-reference/v1"
    },
    "interactionSource": {
      "$ref": "https://enbox.id/schemas/common/provenance/v1"
    }
  }
}
