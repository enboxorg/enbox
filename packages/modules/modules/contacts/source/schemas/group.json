{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://enbox.id/modules/contacts/v1/schemas/group",
  "title": "GroupData",
  "description": "Contacts: group record.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "notes": {
      "$ref": "https://enbox.id/schemas/common/note-text/v1"
    },
    "source": {
      "$ref": "#/definitions/groupSource"
    },
    "labels": {
      "$ref": "https://enbox.id/schemas/common/labels/v1"
    }
  },
  "required": [
    "name"
  ],
  "examples": [
    {
      "name": "Family"
    }
  ],
  "definitions": {
    "groupRecordReference": {
      "$ref": "https://enbox.id/schemas/common/record-reference/v1"
    },
    "groupSource": {
      "$ref": "https://enbox.id/schemas/common/provenance/v1"
    }
  }
