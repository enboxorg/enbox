{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://enbox.id/modules/contacts/v1/schemas/contact",
  "title": "ContactData",
  "description": "Contacts: contact record.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "displayName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "givenNames": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      },
      "minItems": 0,
      "maxItems": 20
    },
    "familyName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "organization": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "did": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^did:[a-z0-9]+:[^\\s]+$"
    },
    "birthday": {
      "type": "string",
      "minLength": 1,
      "maxLength": 10,
      "format": "date"
    },
    "profile": {
      "$ref": "#/definitions/contactRecordReference"
    },
    "photo": {
      "$ref": "#/definitions/contactRecordReference"
    },
    "addresses": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/contactAddress"
      },
      "minItems": 0,
      "maxItems": 20
    },
    "pronouns": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "notes": {
      "$ref": "#/definitions/contactNoteText"
    },
    "source": {
      "$ref": "#/definitions/contactSource"
    },
    "labels": {
      "$ref": "#/definitions/contactLabels"
    }
  },
  "required": [
    "displayName"
  ],
  "examples": [
    {
      "displayName": "Alex Example"
    }
  ],
  "definitions": {
    "contactAddress": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "formatted": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "street": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "locality": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "region": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "postalCode": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "countryCode": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2,
          "pattern": "^[A-Z]{2}$"
        }
      },
      "required": [],
      "minProperties": 1
    },
    "contactRecordReference": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "recordId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "tenantDid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^did:[a-z0-9]+:[^\\s]+$"
        },
        "moduleUri": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192,
          "format": "uri"
        },
        "modulePath": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "contextId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "messageCid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      },
      "required": [
        "recordId"
      ],
      "description": "A DWN record link. An omitted tenantDid means the DID owning the referring record. A link grants no access."
    },
    "contactSource": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "user-statement",
            "document-extraction",
            "import",
            "measurement",
            "derived"
          ]
        },
        "uri": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192,
          "format": "uri"
        },
        "record": {
          "$ref": "#/definitions/contactRecordReference"
        },
        "conversationId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "messageId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "observedAt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "format": "date-time"
        },
        "actorDid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^did:[a-z0-9]+:[^\\s]+$"
        },
        "extractor": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "extractorVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "reviewedAt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "format": "date-time"
        },
        "reviewerDid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^did:[a-z0-9]+:[^\\s]+$"
        }
      },
      "required": [
        "kind"
      ]
    },
    "contactNoteText": {
      "type": "string",
      "minLength": 0,
      "maxLength": 32768
    },
    "contactLabels": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 80
      },
      "uniqueItems": true,
      "maxItems": 64
    }
  }
}
