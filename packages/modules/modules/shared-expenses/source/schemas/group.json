{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://enbox.id/modules/shared-expenses/v1/schemas/group",
  "title": "GroupData",
  "description": "Shared Expenses: group record.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "currency": {
      "type": "string",
      "minLength": 1,
      "maxLength": 3,
      "pattern": "^[A-Z]{3}$"
    },
    "participants": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "did": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096,
            "pattern": "^did:[a-z0-9]+:[^\\s]+$"
          },
          "contact": {
            "$ref": "#/definitions/groupRecordReference"
          }
        },
        "required": [
          "id",
          "name"
        ]
      },
      "minItems": 1,
      "maxItems": 100
    },
    "notes": {
      "$ref": "https://enbox.id/schemas/common/note-text/v1"
    },
    "source": {
      "$ref": "#/definitions/groupSource"
    },
    "labels": {
      "$ref": "https://enbox.id/schemas/common/labels/v1"
    }
  },
  "required": [
    "name",
    "participants"
  ],
  "examples": [
    {
      "name": "Weekend trip",
      "participants": [
        {
          "id": "alex",
          "name": "Alex"
        },
        {
          "id": "sam",
          "name": "Sam"
        }
      ]
    }
  ],
  "definitions": {
    "groupRecordReference": {
      "$ref": "https://enbox.id/schemas/common/record-reference/v1"
    },
    "groupSource": {
      "$ref": "https://enbox.id/schemas/common/provenance/v1"
    }
  }
}
