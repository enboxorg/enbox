{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://enbox.id/modules/events/v1/schemas/state",
  "title": "StateData",
  "description": "Events: state record.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "event": {
      "$ref": "#/definitions/stateRecordReference"
    },
    "alerts": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/stateAlert"
      },
      "minItems": 0,
      "maxItems": 20
    },
    "color": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "hidden": {
      "type": "boolean"
    },
    "notes": {
      "type": "string",
      "minLength": 0,
      "maxLength": 32768
    },
    "source": {
      "$ref": "#/definitions/stateSource"
    },
    "labels": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 80
      },
      "uniqueItems": true,
      "maxItems": 64
    }
  },
  "required": [
    "event"
  ],
  "examples": [
    {
      "event": {
        "recordId": "example-record"
      },
      "alerts": [
        {
          "id": "before",
          "offsetSeconds": -1800,
          "anchor": "start"
        }
      ]
    }
  ],
  "definitions": {
    "stateAlert": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "at": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "format": "date-time"
        },
        "offsetSeconds": {
          "type": "integer",
          "minimum": -315360000,
          "maximum": 315360000
        },
        "anchor": {
          "type": "string",
          "enum": [
            "start",
            "end",
            "due"
          ]
        },
        "channel": {
          "type": "string",
          "enum": [
            "app",
            "push",
            "email"
          ]
        },
        "enabled": {
          "type": "boolean"
        },
        "snoozedUntil": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "format": "date-time"
        },
        "dismissedAt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "format": "date-time"
        }
      },
      "required": [
        "id"
      ],
      "oneOf": [
        {
          "required": [
            "at"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "offsetSeconds"
                ]
              },
              {
                "required": [
                  "anchor"
                ]
              }
            ]
          }
        },
        {
          "required": [
            "offsetSeconds",
            "anchor"
          ],
          "not": {
            "required": [
              "at"
            ]
          }
        }
      ]
    },
    "stateRecordReference": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "recordId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "tenantDid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^did:[a-z0-9]+:[^\\s]+$"
        },
        "moduleUri": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192,
          "format": "uri"
        },
        "modulePath": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "contextId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "messageCid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      },
      "required": [
        "recordId"
      ],
      "description": "A DWN record link. An omitted tenantDid means the DID owning the referring record. A link grants no access."
    },
    "stateSource": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "user-statement",
            "document-extraction",
            "import",
            "measurement",
            "derived"
          ]
        },
        "uri": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192,
          "format": "uri"
        },
        "record": {
          "$ref": "#/definitions/stateRecordReference"
        },
        "conversationId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "messageId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "observedAt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "format": "date-time"
        },
        "actorDid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^did:[a-z0-9]+:[^\\s]+$"
        },
        "extractor": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "extractorVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "reviewedAt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "format": "date-time"
        },
        "reviewerDid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^did:[a-z0-9]+:[^\\s]+$"
        }
      },
      "required": [
        "kind"
      ]
    }
  }
}
