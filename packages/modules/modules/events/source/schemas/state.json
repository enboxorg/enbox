{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://enbox.id/modules/events/v1/schemas/state",
  "title": "StateData",
  "description": "Events: state record.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "event": {
      "$ref": "#/definitions/stateRecordReference"
    },
    "alerts": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/stateAlert"
      },
      "minItems": 0,
      "maxItems": 20
    },
    "color": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "hidden": {
      "type": "boolean"
    },
    "notes": {
      "$ref": "https://enbox.id/schemas/common/note-text/v1"
    },
    "source": {
      "$ref": "#/definitions/stateSource"
    },
    "labels": {
      "$ref": "https://enbox.id/schemas/common/labels/v1"
    }
  },
  "required": [
    "event"
  ],
  "examples": [
    {
      "event": {
        "recordId": "example-record"
      },
      "alerts": [
        {
          "id": "before",
          "offsetSeconds": -1800,
          "anchor": "start"
        }
      ]
    }
  ],
  "definitions": {
    "stateAlert": {
      "$ref": "https://enbox.id/schemas/common/alert/v1"
    },
    "stateRecordReference": {
      "$ref": "https://enbox.id/schemas/common/record-reference/v1"
    },
    "stateSource": {
      "$ref": "https://enbox.id/schemas/common/provenance/v1"
    }
  }
}
