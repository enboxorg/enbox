{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://enbox.id/modules/books/v1/schemas/reading",
  "title": "ReadingData",
  "description": "Books: reading record.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "recordedAt": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "format": "date-time"
    },
    "page": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100000
    },
    "percent": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "audioSeconds": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10000000
    },
    "durationSeconds": {
      "type": "integer",
      "minimum": 0,
      "maximum": 604800
    },
    "state": {
      "type": "string",
      "enum": [
        "reading",
        "finished",
        "paused",
        "abandoned"
      ]
    },
    "notes": {
      "$ref": "https://enbox.id/schemas/common/note-text/v1"
    },
    "source": {
      "$ref": "#/definitions/readingSource"
    },
    "labels": {
      "$ref": "https://enbox.id/schemas/common/labels/v1"
    }
  },
  "required": [
    "recordedAt"
  ],
  "examples": [
    {
      "recordedAt": "2026-01-15T12:00:00Z",
      "page": 42
    }
  ],
  "anyOf": [
    {
      "required": [
        "page"
      ]
    },
    {
      "required": [
        "percent"
      ]
    },
    {
      "required": [
        "audioSeconds"
      ]
    },
    {
      "required": [
        "durationSeconds"
      ]
    },
    {
      "required": [
        "state"
      ]
    }
  ],
  "definitions": {
    "readingRecordReference": {
      "$ref": "https://enbox.id/schemas/common/record-reference/v1"
    },
    "readingSource": {
      "$ref": "https://enbox.id/schemas/common/provenance/v1"
    }
  }
}
