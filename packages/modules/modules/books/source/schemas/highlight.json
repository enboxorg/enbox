{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://enbox.id/modules/books/v1/schemas/highlight",
  "title": "HighlightData",
  "description": "Books: highlight record.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32768
    },
    "location": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "page": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100000
    },
    "annotation": {
      "type": "string",
      "minLength": 1,
      "maxLength": 16384
    },
    "createdAt": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "format": "date-time"
    },
    "notes": {
      "$ref": "https://enbox.id/schemas/common/note-text/v1"
    },
    "source": {
      "$ref": "#/definitions/highlightSource"
    },
    "labels": {
      "$ref": "https://enbox.id/schemas/common/labels/v1"
    }
  },
  "required": [
    "text"
  ],
  "examples": [
    {
      "text": "A short personal excerpt.",
      "page": 42
    }
  ],
  "definitions": {
    "highlightRecordReference": {
      "$ref": "https://enbox.id/schemas/common/record-reference/v1"
    },
    "highlightSource": {
      "$ref": "https://enbox.id/schemas/common/provenance/v1"
    }
  }
}
