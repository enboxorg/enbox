{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://enbox.id/modules/books/v1/schemas/review",
  "title": "ReviewData",
  "description": "Books: review record.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "rating": {
      "$ref": "#/definitions/reviewRating"
    },
    "body": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32768
    },
    "reviewedAt": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "format": "date-time"
    },
    "notes": {
      "$ref": "https://enbox.id/schemas/common/note-text/v1"
    },
    "source": {
      "$ref": "#/definitions/reviewSource"
    },
    "labels": {
      "$ref": "https://enbox.id/schemas/common/labels/v1"
    }
  },
  "required": [
    "rating"
  ],
  "examples": [
    {
      "rating": {
        "value": 4,
        "scale": 5
      }
    }
  ],
  "definitions": {
    "reviewRating": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "value": {
          "type": "number",
          "minimum": 0,
          "maximum": 10
        },
        "scale": {
          "type": "integer",
          "enum": [
            5,
            10
          ]
        }
      },
      "required": [
        "value",
        "scale"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "scale": {
                "const": 5
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "maximum": 5,
                "type": "number"
              }
            }
          }
        }
      ]
    },
    "reviewRecordReference": {
      "$ref": "https://enbox.id/schemas/common/record-reference/v1"
    },
    "reviewSource": {
      "$ref": "https://enbox.id/schemas/common/provenance/v1"
    }
  }
}
