{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://enbox.id/modules/books/v1/schemas/book",
  "title": "BookData",
  "description": "Books: book record.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "authors": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      },
      "minItems": 0,
      "maxItems": 50
    },
    "isbn": {
      "type": "string",
      "minLength": 1,
      "maxLength": 17,
      "pattern": "^[0-9Xx-]{10,17}$"
    },
    "edition": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "publisher": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "publishedYear": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2200
    },
    "format": {
      "type": "string",
      "enum": [
        "paper",
        "ebook",
        "audio",
        "other"
      ]
    },
    "state": {
      "type": "string",
      "enum": [
        "want-to-read",
        "reading",
        "finished",
        "paused",
        "abandoned"
      ]
    },
    "pageCount": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100000
    },
    "file": {
      "$ref": "#/definitions/bookRecordReference"
    },
    "purchase": {
      "$ref": "#/definitions/bookRecordReference"
    },
    "loan": {
      "$ref": "#/definitions/bookRecordReference"
    },
    "notes": {
      "$ref": "#/definitions/bookNoteText"
    },
    "source": {
      "$ref": "#/definitions/bookSource"
    },
    "labels": {
      "$ref": "#/definitions/bookLabels"
    }
  },
  "required": [
    "title",
    "state"
  ],
  "examples": [
    {
      "title": "Dune",
      "authors": [
        "Frank Herbert"
      ],
      "state": "reading"
    }
  ],
  "definitions": {
    "bookRecordReference": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "recordId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "tenantDid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^did:[a-z0-9]+:[^\\s]+$"
        },
        "moduleUri": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192,
          "format": "uri"
        },
        "modulePath": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "contextId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "messageCid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      },
      "required": [
        "recordId"
      ],
      "description": "A DWN record link. An omitted tenantDid means the DID owning the referring record. A link grants no access."
    },
    "bookSource": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "user-statement",
            "document-extraction",
            "import",
            "measurement",
            "derived"
          ]
        },
        "uri": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192,
          "format": "uri"
        },
        "record": {
          "$ref": "#/definitions/bookRecordReference"
        },
        "conversationId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "messageId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "observedAt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "format": "date-time"
        },
        "actorDid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^did:[a-z0-9]+:[^\\s]+$"
        },
        "extractor": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "extractorVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "reviewedAt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "format": "date-time"
        },
        "reviewerDid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^did:[a-z0-9]+:[^\\s]+$"
        }
      },
      "required": [
        "kind"
      ]
    },
    "bookNoteText": {
      "type": "string",
      "minLength": 0,
      "maxLength": 32768
    },
    "bookLabels": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 80
      },
      "uniqueItems": true,
      "maxItems": 64
    }
  }
}
