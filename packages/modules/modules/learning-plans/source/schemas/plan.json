{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://enbox.id/modules/learning-plans/v1/schemas/plan",
  "title": "PlanData",
  "description": "Learning Plans: plan record.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "subject": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "level": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "resources": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/planRecordReference"
      },
      "minItems": 0,
      "maxItems": 100
    },
    "schedule": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8192
    },
    "state": {
      "type": "string",
      "enum": [
        "planned",
        "active",
        "paused",
        "completed",
        "abandoned"
      ]
    },
    "notes": {
      "$ref": "https://enbox.id/schemas/common/note-text/v1"
    },
    "source": {
      "$ref": "#/definitions/planSource"
    },
    "labels": {
      "$ref": "https://enbox.id/schemas/common/labels/v1"
    }
  },
  "required": [
    "name",
    "subject",
    "state"
  ],
  "examples": [
    {
      "name": "Conversational Spanish",
      "subject": "Spanish",
      "state": "planned"
    }
  ],
  "definitions": {
    "planRecordReference": {
      "$ref": "https://enbox.id/schemas/common/record-reference/v1"
    },
    "planSource": {
      "$ref": "https://enbox.id/schemas/common/provenance/v1"
    }
  }
}
