{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://enbox.id/modules/learning-plans/v1/schemas/progress",
  "title": "ProgressData",
  "description": "Learning Plans: progress record.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "recordedAt": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "format": "date-time"
    },
    "state": {
      "type": "string",
      "enum": [
        "in-progress",
        "completed",
        "skipped"
      ]
    },
    "durationSeconds": {
      "type": "integer",
      "minimum": 0,
      "maximum": 604800
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/progressRecordReference"
      },
      "minItems": 0,
      "maxItems": 50
    },
    "notes": {
      "$ref": "https://enbox.id/schemas/common/note-text/v1"
    },
    "source": {
      "$ref": "#/definitions/progressSource"
    },
    "labels": {
      "$ref": "https://enbox.id/schemas/common/labels/v1"
    }
  },
  "required": [
    "recordedAt",
    "state"
  ],
  "examples": [
    {
      "recordedAt": "2026-01-15T12:00:00Z",
      "state": "completed"
    }
  ],
  "definitions": {
    "progressRecordReference": {
      "$ref": "https://enbox.id/schemas/common/record-reference/v1"
    },
    "progressSource": {
      "$ref": "https://enbox.id/schemas/common/provenance/v1"
    }
  }
}
