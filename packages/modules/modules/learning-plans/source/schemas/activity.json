{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://enbox.id/modules/learning-plans/v1/schemas/activity",
  "title": "ActivityData",
  "description": "Learning Plans: activity record.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "kind": {
      "type": "string",
      "enum": [
        "lesson",
        "reading",
        "practice",
        "assessment",
        "other"
      ]
    },
    "resource": {
      "$ref": "#/definitions/activityRecordReference"
    },
    "plannedOn": {
      "type": "string",
      "minLength": 1,
      "maxLength": 10,
      "format": "date"
    },
    "state": {
      "type": "string",
      "enum": [
        "planned",
        "in-progress",
        "completed",
        "skipped"
      ]
    },
    "sortOrder": {
      "type": "number",
      "minimum": 0,
      "maximum": 1000000000
    },
    "notes": {
      "$ref": "https://enbox.id/schemas/common/note-text/v1"
    },
    "source": {
      "$ref": "#/definitions/activitySource"
    },
    "labels": {
      "$ref": "https://enbox.id/schemas/common/labels/v1"
    }
  },
  "required": [
    "name",
    "kind",
    "state"
  ],
  "examples": [
    {
      "name": "Basic greetings",
      "kind": "lesson",
      "state": "planned"
    }
  ],
  "definitions": {
    "activityRecordReference": {
      "$ref": "https://enbox.id/schemas/common/record-reference/v1"
    },
    "activitySource": {
      "$ref": "https://enbox.id/schemas/common/provenance/v1"
    }
  }
}
