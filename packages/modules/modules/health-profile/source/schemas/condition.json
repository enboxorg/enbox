{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://enbox.id/modules/health-profile/v1/schemas/condition",
  "title": "ConditionData",
  "description": "Health Profile: condition record.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "reportedOn": {
      "type": "string",
      "minLength": 1,
      "maxLength": 10,
      "format": "date"
    },
    "state": {
      "type": "string",
      "enum": [
        "active",
        "resolved",
        "historical",
        "unknown"
      ]
    },
    "assertion": {
      "type": "string",
      "enum": [
        "self-reported",
        "clinician-reported"
      ]
    },
    "clinician": {
      "$ref": "#/definitions/conditionRecordReference"
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/conditionRecordReference"
      },
      "minItems": 0,
      "maxItems": 50
    },
    "resolvedOn": {
      "type": "string",
      "minLength": 1,
      "maxLength": 10,
      "format": "date"
    },
    "notes": {
      "$ref": "https://enbox.id/schemas/common/note-text/v1"
    },
    "source": {
      "$ref": "#/definitions/conditionSource"
    },
    "labels": {
      "$ref": "https://enbox.id/schemas/common/labels/v1"
    }
  },
  "required": [
    "name",
    "assertion"
  ],
  "examples": [
    {
      "name": "Example condition",
      "assertion": "self-reported"
    }
  ],
  "definitions": {
    "conditionRecordReference": {
      "$ref": "https://enbox.id/schemas/common/record-reference/v1"
    },
    "conditionSource": {
      "$ref": "https://enbox.id/schemas/common/provenance/v1"
    }
  }
}
