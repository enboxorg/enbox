{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://enbox.id/modules/flashcards/v1/schemas/card-state",
  "title": "CardStateData",
  "description": "Flashcards: cardState record.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "card": {
      "$ref": "#/definitions/cardStateRecordReference"
    },
    "dueAt": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "format": "date-time"
    },
    "intervalDays": {
      "type": "number",
      "minimum": 0,
      "maximum": 100000
    },
    "ease": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "repetitions": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000000000
    },
    "lapses": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000000000
    },
    "suspended": {
      "type": "boolean"
    },
    "notes": {
      "$ref": "https://enbox.id/schemas/common/note-text/v1"
    },
    "source": {
      "$ref": "#/definitions/cardStateSource"
    },
    "labels": {
      "$ref": "https://enbox.id/schemas/common/labels/v1"
    }
  },
  "required": [
    "card"
  ],
  "examples": [
    {
      "card": {
        "recordId": "example-record"
      },
      "dueAt": "2026-01-15T12:00:00Z"
    }
  ],
  "definitions": {
    "cardStateRecordReference": {
      "$ref": "https://enbox.id/schemas/common/record-reference/v1"
    },
    "cardStateSource": {
      "$ref": "https://enbox.id/schemas/common/provenance/v1"
    }
  }
}
