{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://enbox.id/modules/flashcards/v1/schemas/study-set",
  "title": "StudySetData",
  "description": "Flashcards: studySet record.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "deck": {
      "$ref": "#/definitions/studySetRecordReference"
    },
    "algorithm": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "algorithmVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "notes": {
      "$ref": "https://enbox.id/schemas/common/note-text/v1"
    },
    "source": {
      "$ref": "#/definitions/studySetSource"
    },
    "labels": {
      "$ref": "https://enbox.id/schemas/common/labels/v1"
    }
  },
  "required": [
    "name",
    "deck"
  ],
  "examples": [
    {
      "name": "Daily vocabulary",
      "deck": {
        "recordId": "example-record"
      }
    }
  ],
  "definitions": {
    "studySetRecordReference": {
      "$ref": "https://enbox.id/schemas/common/record-reference/v1"
    },
    "studySetSource": {
      "$ref": "https://enbox.id/schemas/common/provenance/v1"
    }
  }
}
