    {
      "path": "account/position/lot",
      "type": "lot",
      "dataFormats": [
        "application/json"
      ],
      "encryptionRequired": true,
      "schema": "https://enbox.id/modules/investment-holdings/v1/schemas/lot",
      "schemaFile": "schemas/lot.json",
      "role": false,
      "immutable": true,
      "singleton": false
    },
    {
      "path": "account/position/trade",
      "type": "trade",
      "dataFormats": [
        "application/json"
      ],
      "encryptionRequired": true,
      "schema": "https://enbox.id/modules/investment-holdings/v1/schemas/trade",
      "schemaFile": "schemas/trade.json",
      "role": false,
      "immutable": true,
      "singleton": false
    }
  ]
