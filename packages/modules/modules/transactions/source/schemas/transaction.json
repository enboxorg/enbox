{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://enbox.id/modules/transactions/v1/schemas/transaction",
  "title": "TransactionData",
  "description": "Transactions: transaction record.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "kind": {
      "type": "string",
      "enum": [
        "expense",
        "income",
        "transfer-in",
        "transfer-out",
        "refund"
      ]
    },
    "amount": {
      "$ref": "#/definitions/transactionMoney"
    },
    "occurredAt": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "format": "date-time"
    },
    "counterparty": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "category": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "state": {
      "type": "string",
      "enum": [
        "pending",
        "posted",
        "reversed"
      ]
    },
    "externalId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "receipt": {
      "$ref": "#/definitions/transactionRecordReference"
    },
    "relatedTransaction": {
      "$ref": "#/definitions/transactionRecordReference"
    },
    "notes": {
      "$ref": "https://enbox.id/schemas/common/note-text/v1"
    },
    "source": {
      "$ref": "#/definitions/transactionSource"
    },
    "labels": {
      "$ref": "https://enbox.id/schemas/common/labels/v1"
    }
  },
  "required": [
    "kind",
    "amount",
    "occurredAt"
  ],
  "examples": [
    {
      "kind": "expense",
      "amount": {
        "amount": "42",
        "currency": "GBP"
      },
      "occurredAt": "2026-01-15T12:00:00Z",
      "category": "groceries"
    }
  ],
  "definitions": {
    "transactionMoney": {
      "$ref": "https://enbox.id/schemas/common/money/v1"
    },
    "transactionRecordReference": {
      "$ref": "https://enbox.id/schemas/common/record-reference/v1"
    },
    "transactionSource": {
      "$ref": "https://enbox.id/schemas/common/provenance/v1"
    }
  }
}
