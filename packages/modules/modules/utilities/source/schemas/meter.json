{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://enbox.id/modules/utilities/v1/schemas/meter",
  "title": "MeterData",
  "description": "Utilities: meter record.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "unit": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "location": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "kind": {
      "type": "string",
      "enum": [
        "cumulative",
        "interval"
      ]
    },
    "notes": {
      "$ref": "https://enbox.id/schemas/common/note-text/v1"
    },
    "source": {
      "$ref": "#/definitions/meterSource"
    },
    "labels": {
      "$ref": "https://enbox.id/schemas/common/labels/v1"
    }
  },
  "required": [
    "identifier",
    "unit"
  ],
  "examples": [
    {
      "identifier": "WATER-01",
      "unit": "m3",
      "kind": "cumulative"
    }
  ],
  "definitions": {
    "meterRecordReference": {
      "$ref": "https://enbox.id/schemas/common/record-reference/v1"
    },
    "meterSource": {
      "$ref": "https://enbox.id/schemas/common/provenance/v1"
    }
  }
}
