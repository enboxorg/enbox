{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://enbox.id/modules/utilities/v1/schemas/account",
  "title": "AccountData",
  "description": "Utilities: account record.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "provider": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "service": {
      "type": "string",
      "enum": [
        "electricity",
        "gas",
        "water",
        "internet",
        "telephone",
        "waste",
        "other"
      ]
    },
    "accountNumber": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "residence": {
      "$ref": "#/definitions/accountRecordReference"
    },
    "startsOn": {
      "type": "string",
      "minLength": 1,
      "maxLength": 10,
      "format": "date"
    },
    "endsOn": {
      "type": "string",
      "minLength": 1,
      "maxLength": 10,
      "format": "date"
    },
    "tariff": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "billingUrl": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8192,
      "format": "uri"
    },
    "contact": {
      "$ref": "#/definitions/accountRecordReference"
    },
    "notes": {
      "type": "string",
      "minLength": 0,
      "maxLength": 32768
    },
    "source": {
      "$ref": "#/definitions/accountSource"
    },
    "labels": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 80
      },
      "uniqueItems": true,
      "maxItems": 64
    }
  },
  "required": [
    "provider",
    "service"
  ],
  "examples": [
    {
      "provider": "Example Water",
      "service": "water"
    }
  ],
  "definitions": {
    "accountRecordReference": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "recordId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "tenantDid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^did:[a-z0-9]+:[^\\s]+$"
        },
        "moduleUri": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192,
          "format": "uri"
        },
        "modulePath": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "contextId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "messageCid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      },
      "required": [
        "recordId"
      ],
      "description": "A DWN record link. An omitted tenantDid means the DID owning the referring record. A link grants no access."
    },
    "accountSource": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "user-statement",
            "document-extraction",
            "import",
            "measurement",
            "derived"
          ]
        },
        "uri": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192,
          "format": "uri"
        },
        "record": {
          "$ref": "#/definitions/accountRecordReference"
        },
        "conversationId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "messageId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "observedAt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "format": "date-time"
        },
        "actorDid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^did:[a-z0-9]+:[^\\s]+$"
        },
        "extractor": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "extractorVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "reviewedAt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "format": "date-time"
        },
        "reviewerDid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^did:[a-z0-9]+:[^\\s]+$"
        }
      },
      "required": [
        "kind"
      ]
    }
  }
}
