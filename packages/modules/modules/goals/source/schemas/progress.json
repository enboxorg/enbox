{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://enbox.id/modules/goals/v1/schemas/progress",
  "title": "ProgressData",
  "description": "Goals: progress record.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "recordedAt": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "format": "date-time"
    },
    "value": {
      "$ref": "#/definitions/progressQuantity"
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8192
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/progressRecordReference"
      },
      "minItems": 0,
      "maxItems": 100
    },
    "notes": {
      "$ref": "https://enbox.id/schemas/common/note-text/v1"
    },
    "source": {
      "$ref": "#/definitions/progressSource"
    },
    "labels": {
      "$ref": "https://enbox.id/schemas/common/labels/v1"
    }
  },
  "required": [
    "recordedAt"
  ],
  "examples": [
    {
      "recordedAt": "2026-01-15T12:00:00Z",
      "value": {
        "value": "5",
        "unit": "km"
      }
    }
  ],
  "anyOf": [
    {
      "required": [
        "value"
      ]
    },
    {
      "required": [
        "description"
      ]
    },
    {
      "required": [
        "evidence"
      ],
      "properties": {
        "evidence": {
          "type": "array",
          "minItems": 1
        }
      }
    }
  ],
  "definitions": {
    "progressQuantity": {
      "$ref": "https://enbox.id/schemas/common/quantity/v1"
    },
    "progressRecordReference": {
      "$ref": "https://enbox.id/schemas/common/record-reference/v1"
    },
    "progressSource": {
      "$ref": "https://enbox.id/schemas/common/provenance/v1"
    }
  }
}
