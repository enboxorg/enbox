{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://enbox.id/modules/groceries/v1/schemas/list",
  "title": "ListData",
  "description": "Groceries: list record.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "store": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "completed",
        "archived"
      ]
    },
    "plannedFor": {
      "type": "string",
      "minLength": 1,
      "maxLength": 10,
      "format": "date"
    },
    "notes": {
      "$ref": "https://enbox.id/schemas/common/note-text/v1"
    },
    "source": {
      "$ref": "#/definitions/listSource"
    },
    "labels": {
      "$ref": "https://enbox.id/schemas/common/labels/v1"
    }
  },
  "required": [
    "name"
  ],
  "examples": [
    {
      "name": "Weekly groceries"
    }
  ],
  "definitions": {
    "listRecordReference": {
      "$ref": "https://enbox.id/schemas/common/record-reference/v1"
    },
    "listSource": {
      "$ref": "https://enbox.id/schemas/common/provenance/v1"
    }
  }
}
