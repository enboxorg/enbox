{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://enbox.id/modules/recipes/v1/schemas/variation",
  "title": "VariationData",
  "description": "Recipes: variation record.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "changes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2048
      },
      "minItems": 1,
      "maxItems": 100
    },
    "rating": {
      "$ref": "#/definitions/variationRating"
    },
    "triedAt": {
      "type": "string",
      "minLength": 1,
      "maxLength": 10,
      "format": "date"
    },
    "notes": {
      "$ref": "https://enbox.id/schemas/common/note-text/v1"
    },
    "source": {
      "$ref": "#/definitions/variationSource"
    },
    "labels": {
      "$ref": "https://enbox.id/schemas/common/labels/v1"
    }
  },
  "required": [
    "name",
    "changes"
  ],
  "examples": [
    {
      "name": "Smoky version",
      "changes": [
        "Add smoked paprika."
      ]
    }
  ],
  "definitions": {
    "variationRating": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "value": {
          "type": "number",
          "minimum": 0,
          "maximum": 10
        },
        "scale": {
          "type": "integer",
          "enum": [
            5,
            10
          ]
        }
      },
      "required": [
        "value",
        "scale"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "scale": {
                "const": 5
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "maximum": 5,
                "type": "number"
              }
            }
          }
        }
      ]
    },
    "variationRecordReference": {
      "$ref": "https://enbox.id/schemas/common/record-reference/v1"
    },
    "variationSource": {
      "$ref": "https://enbox.id/schemas/common/provenance/v1"
    }
  }
}
