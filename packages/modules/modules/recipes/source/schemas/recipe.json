{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://enbox.id/modules/recipes/v1/schemas/recipe",
  "title": "RecipeData",
  "description": "Recipes: recipe record.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "servings": {
      "type": "number",
      "minimum": 0.01,
      "maximum": 10000
    },
    "prepMinutes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100000
    },
    "cookMinutes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100000
    },
    "ingredients": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "quantity": {
            "$ref": "#/definitions/recipeQuantity"
          },
          "preparation": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "optional": {
            "type": "boolean"
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096,
            "description": "Ingredient line as published, including amounts and preparation instructions."
          }
        },
        "oneOf": [
          {
            "required": [
              "name"
            ],
            "not": {
              "required": [
                "text"
              ]
            }
          },
          {
            "required": [
              "text"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "name"
                  ]
                },
                {
                  "required": [
                    "quantity"
                  ]
                },
                {
                  "required": [
                    "preparation"
                  ]
                },
                {
                  "required": [
                    "optional"
                  ]
                }
              ]
            }
          }
        ]
      },
      "minItems": 1,
      "maxItems": 500
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "instruction": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8192
          },
          "minutes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100000
          }
        },
        "required": [
          "instruction"
        ]
      },
      "minItems": 1,
      "maxItems": 500
    },
    "cuisine": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "dietaryLabels": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 80
      },
      "uniqueItems": true,
      "maxItems": 64
    },
    "originalUrl": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8192,
      "format": "uri"
    },
    "images": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/recipeRecordReference"
      },
      "minItems": 0,
      "maxItems": 20
    },
    "notes": {
      "$ref": "https://enbox.id/schemas/common/note-text/v1"
    },
    "source": {
      "$ref": "#/definitions/recipeSource"
    },
    "labels": {
      "$ref": "https://enbox.id/schemas/common/labels/v1"
    },
    "yieldText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "description": "Published yield such as \u201c24 cookies\u201d, when a numeric serving count is unavailable."
    }
  },
  "required": [
    "name",
    "ingredients",
    "steps"
  ],
  "examples": [
    {
      "name": "Lentil soup",
      "servings": 4,
      "ingredients": [
        {
          "name": "Lentils",
          "quantity": {
            "value": "200",
            "unit": "g"
          }
        }
      ],
      "steps": [
        {
          "instruction": "Simmer the lentils in water until tender.",
          "minutes": 25
        }
      ]
    }
  ],
  "definitions": {
    "recipeQuantity": {
      "$ref": "https://enbox.id/schemas/common/quantity/v1"
    },
    "recipeRecordReference": {
      "$ref": "https://enbox.id/schemas/common/record-reference/v1"
    },
    "recipeSource": {
      "$ref": "https://enbox.id/schemas/common/provenance/v1"
    }
  },
  "not": {
    "required": [
      "servings",
      "yieldText"
    ]
  }
}
