{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://enbox.id/modules/media-library/v1/schemas/series",
  "title": "SeriesData",
  "description": "The stable show identity. A podcast feed URL belongs to this show.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "url": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8192,
      "format": "uri"
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 16384
    },
    "creator": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "url": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8192,
            "format": "uri"
          }
        },
        "required": [
          "name"
        ]
      },
      "minItems": 1,
      "maxItems": 100
    },
    "publisher": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "url": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192,
          "format": "uri"
        }
      },
      "required": [
        "name"
      ]
    },
    "genre": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 100
      },
      "minItems": 1,
      "maxItems": 100
    },
    "identifier": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "propertyID": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "value": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          }
        },
        "required": [
          "propertyID",
          "value"
        ]
      },
      "minItems": 1,
      "maxItems": 30
    },
    "datePublished": {
      "type": "string",
      "anyOf": [
        {
          "format": "date"
        },
        {
          "format": "date-time"
        },
        {
          "pattern": "^[0-9]{4}$"
        }
      ]
    },
    "intent": {
      "type": "string",
      "enum": [
        "saved",
        "queued",
        "archived"
      ]
    },
    "favorite": {
      "type": "boolean"
    },
    "file": {
      "$ref": "#/definitions/seriesRecordReference"
    },
    "purchase": {
      "$ref": "#/definitions/seriesRecordReference"
    },
    "source": {
      "$ref": "#/definitions/seriesProvenance"
    },
    "notes": {
      "$ref": "#/definitions/seriesNoteText"
    },
    "labels": {
      "$ref": "#/definitions/seriesLabels"
    },
    "@type": {
      "type": "string",
      "enum": [
        "TVSeries",
        "PodcastSeries"
      ]
    },
    "feedUrl": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8192,
      "format": "uri"
    },
    "following": {
      "type": "boolean"
    }
  },
  "required": [
    "@type",
    "name"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "@type": {
            "not": {
              "enum": [
                "PodcastSeries"
              ]
            }
          }
        }
      },
      "then": {
        "not": {
          "anyOf": [
            {
              "required": [
                "feedUrl"
              ]
            }
          ]
        }
      }
    }
  ],
  "definitions": {
    "seriesRecordReference": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "recordId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "tenantDid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^did:[a-z0-9]+:[^\\s]+$"
        },
        "moduleUri": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192,
          "format": "uri"
        },
        "modulePath": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "contextId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "messageCid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      },
      "required": [
        "recordId"
      ],
      "description": "A DWN record link. An omitted tenantDid means the DID owning the referring record. A link grants no access."
    },
    "seriesProvenance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "user-statement",
            "document-extraction",
            "import",
            "measurement",
            "derived"
          ]
        },
        "uri": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192,
          "format": "uri"
        },
        "record": {
          "$ref": "#/definitions/seriesRecordReference"
        },
        "conversationId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "messageId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "observedAt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "format": "date-time"
        },
        "actorDid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^did:[a-z0-9]+:[^\\s]+$"
        },
        "extractor": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "extractorVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "reviewedAt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "format": "date-time"
        },
        "reviewerDid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^did:[a-z0-9]+:[^\\s]+$"
        }
      },
      "required": [
        "kind"
      ]
    },
    "seriesNoteText": {
      "type": "string",
      "minLength": 0,
      "maxLength": 32768
    },
    "seriesLabels": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 80
      },
      "uniqueItems": true,
      "maxItems": 64
    }
  }
}
