{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://enbox.id/modules/media-library/v1/schemas/work",
  "title": "WorkData",
  "description": "One identifiable book edition, movie, album, recording or game release. The selected Schema.org type controls specialized metadata.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "url": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8192,
      "format": "uri"
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 16384
    },
    "creator": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "url": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8192,
            "format": "uri"
          }
        },
        "required": [
          "name"
        ]
      },
      "minItems": 1,
      "maxItems": 100
    },
    "publisher": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "url": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192,
          "format": "uri"
        }
      },
      "required": [
        "name"
      ]
    },
    "genre": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 100
      },
      "minItems": 1,
      "maxItems": 100
    },
    "identifier": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "propertyID": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "value": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          }
        },
        "required": [
          "propertyID",
          "value"
        ]
      },
      "minItems": 1,
      "maxItems": 30
    },
    "datePublished": {
      "type": "string",
      "anyOf": [
        {
          "format": "date"
        },
        {
          "format": "date-time"
        },
        {
          "pattern": "^[0-9]{4}$"
        }
      ]
    },
    "intent": {
      "type": "string",
      "enum": [
        "saved",
        "queued",
        "archived"
      ]
    },
    "favorite": {
      "type": "boolean"
    },
    "file": {
      "$ref": "#/definitions/workRecordReference"
    },
    "purchase": {
      "$ref": "#/definitions/workRecordReference"
    },
    "source": {
      "$ref": "#/definitions/workProvenance"
    },
    "notes": {
      "$ref": "#/definitions/workNoteText"
    },
    "labels": {
      "$ref": "#/definitions/workLabels"
    },
    "@type": {
      "type": "string",
      "enum": [
        "Book",
        "Movie",
        "MusicRecording",
        "MusicAlbum",
        "VideoGame"
      ]
    },
    "isbn": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32,
      "description": "Printed ISBN, including separators when supplied. A checksum-aware importer may normalize it for edition matching."
    },
    "bookEdition": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "numberOfPages": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100000
    },
    "bookFormat": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "gamePlatform": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      },
      "minItems": 1,
      "maxItems": 30
    },
    "album": {
      "$ref": "#/definitions/workRecordReference"
    },
    "durationSeconds": {
      "type": "number",
      "minimum": 0,
      "maximum": 315360000
    }
  },
  "required": [
    "@type",
    "name"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "@type": {
            "not": {
              "enum": [
                "Book"
              ]
            }
          }
        }
      },
      "then": {
        "not": {
          "anyOf": [
            {
              "required": [
                "isbn"
              ]
            },
            {
              "required": [
                "bookEdition"
              ]
            },
            {
              "required": [
                "numberOfPages"
              ]
            },
            {
              "required": [
                "bookFormat"
              ]
            }
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "@type": {
            "not": {
              "enum": [
                "MusicRecording"
              ]
            }
          }
        }
      },
      "then": {
        "not": {
          "anyOf": [
            {
              "required": [
                "album"
              ]
            }
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "@type": {
            "not": {
              "enum": [
                "VideoGame"
              ]
            }
          }
        }
      },
      "then": {
        "not": {
          "anyOf": [
            {
              "required": [
                "gamePlatform"
              ]
            }
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "@type": {
            "not": {
              "enum": [
                "Book",
                "Movie",
                "MusicRecording",
                "MusicAlbum"
              ]
            }
          }
        }
      },
      "then": {
        "not": {
          "anyOf": [
            {
              "required": [
                "durationSeconds"
              ]
            }
          ]
        }
      }
    }
  ],
  "definitions": {
    "workRecordReference": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "recordId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "tenantDid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^did:[a-z0-9]+:[^\\s]+$"
        },
        "moduleUri": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192,
          "format": "uri"
        },
        "modulePath": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "contextId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "messageCid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      },
      "required": [
        "recordId"
      ],
      "description": "A DWN record link. An omitted tenantDid means the DID owning the referring record. A link grants no access."
    },
    "workProvenance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "user-statement",
            "document-extraction",
            "import",
            "measurement",
            "derived"
          ]
        },
        "uri": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192,
          "format": "uri"
        },
        "record": {
          "$ref": "#/definitions/workRecordReference"
        },
        "conversationId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "messageId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "observedAt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "format": "date-time"
        },
        "actorDid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^did:[a-z0-9]+:[^\\s]+$"
        },
        "extractor": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "extractorVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "reviewedAt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "format": "date-time"
        },
        "reviewerDid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^did:[a-z0-9]+:[^\\s]+$"
        }
      },
      "required": [
        "kind"
      ]
    },
    "workNoteText": {
      "type": "string",
      "minLength": 0,
      "maxLength": 32768
    },
    "workLabels": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 80
      },
      "uniqueItems": true,
      "maxItems": 64
    }
  }
}
