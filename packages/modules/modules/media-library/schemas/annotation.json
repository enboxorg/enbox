{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://enbox.id/modules/media-library/v1/schemas/annotation",
  "title": "AnnotationData",
  "description": "A private note, quote or review attached to the selected edition, show, or episode.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "kind": {
      "type": "string",
      "enum": [
        "note",
        "highlight",
        "review"
      ]
    },
    "body": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32768
    },
    "quote": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32768
    },
    "position": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "unit": {
          "type": "string",
          "enum": [
            "page",
            "seconds",
            "percent",
            "chapter",
            "level"
          ]
        },
        "value": {
          "type": [
            "number",
            "string"
          ]
        }
      },
      "required": [
        "unit",
        "value"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "unit": {
                "enum": [
                  "page"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "type": "integer",
                "minimum": 1,
                "maximum": 100000
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "unit": {
                "enum": [
                  "seconds"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "type": "number",
                "minimum": 0,
                "maximum": 315360000
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "unit": {
                "enum": [
                  "percent"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "type": "number",
                "minimum": 0,
                "maximum": 100
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "unit": {
                "enum": [
                  "chapter",
                  "level"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              }
            }
          }
        }
      ]
    },
    "rating": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "value": {
          "type": "number",
          "minimum": 0,
          "maximum": 10
        },
        "scale": {
          "type": "integer",
          "enum": [
            5,
            10
          ]
        }
      },
      "required": [
        "value",
        "scale"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "scale": {
                "const": 5
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "type": "number",
                "maximum": 5
              }
            }
          }
        }
      ]
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "source": {
      "$ref": "#/definitions/annotationProvenance"
    }
  },
  "required": [
    "kind"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "note"
          }
        }
      },
      "then": {
        "required": [
          "body"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "highlight"
          }
        }
      },
      "then": {
        "required": [
          "quote"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "review"
          }
        }
      },
      "then": {
        "anyOf": [
          {
            "required": [
              "body"
            ]
          },
          {
            "required": [
              "rating"
            ]
          }
        ]
      },
      "else": {
        "not": {
          "required": [
            "rating"
          ]
        }
      }
    }
  ],
  "definitions": {
    "annotationProvenance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "user-statement",
            "document-extraction",
            "import",
            "measurement",
            "derived"
          ]
        },
        "uri": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192,
          "format": "uri"
        },
        "record": {
          "$ref": "#/definitions/annotationRecordReference"
        },
        "conversationId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "messageId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "observedAt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "format": "date-time"
        },
        "actorDid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^did:[a-z0-9]+:[^\\s]+$"
        },
        "extractor": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "extractorVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "reviewedAt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "format": "date-time"
        },
        "reviewerDid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^did:[a-z0-9]+:[^\\s]+$"
        }
      },
      "required": [
        "kind"
      ]
    },
    "annotationRecordReference": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "recordId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "tenantDid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^did:[a-z0-9]+:[^\\s]+$"
        },
        "moduleUri": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192,
          "format": "uri"
        },
        "modulePath": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "contextId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "messageCid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      },
      "required": [
        "recordId"
      ],
      "description": "A DWN record link. An omitted tenantDid means the DID owning the referring record. A link grants no access."
    }
  }
}
