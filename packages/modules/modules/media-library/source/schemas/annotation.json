{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://enbox.id/modules/media-library/v1/schemas/annotation",
  "title": "AnnotationData",
  "description": "A private note, quote or review attached to the selected edition, show, or episode.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "kind": {
      "type": "string",
      "enum": [
        "note",
        "highlight",
        "review"
      ]
    },
    "body": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32768
    },
    "quote": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32768
    },
    "position": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "unit": {
          "type": "string",
          "enum": [
            "page",
            "seconds",
            "percent",
            "chapter",
            "level"
          ]
        },
        "value": {
          "type": [
            "number",
            "string"
          ]
        }
      },
      "required": [
        "unit",
        "value"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "unit": {
                "enum": [
                  "page"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "type": "integer",
                "minimum": 1,
                "maximum": 100000
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "unit": {
                "enum": [
                  "seconds"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "type": "number",
                "minimum": 0,
                "maximum": 315360000
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "unit": {
                "enum": [
                  "percent"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "type": "number",
                "minimum": 0,
                "maximum": 100
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "unit": {
                "enum": [
                  "chapter",
                  "level"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              }
            }
          }
        }
      ]
    },
    "rating": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "value": {
          "type": "number",
          "minimum": 0,
          "maximum": 10
        },
        "scale": {
          "type": "integer",
          "enum": [
            5,
            10
          ]
        }
      },
      "required": [
        "value",
        "scale"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "scale": {
                "const": 5
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "type": "number",
                "maximum": 5
              }
            }
          }
        }
      ]
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "source": {
      "$ref": "https://enbox.id/schemas/common/provenance/v1"
    }
  },
  "required": [
    "kind"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "note"
          }
        }
      },
      "then": {
        "required": [
          "body"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "highlight"
          }
        }
      },
      "then": {
        "required": [
          "quote"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "review"
          }
        }
      },
      "then": {
        "anyOf": [
          {
            "required": [
              "body"
            ]
          },
          {
            "required": [
              "rating"
            ]
          }
        ]
      },
      "else": {
        "not": {
          "required": [
            "rating"
          ]
        }
      }
    }
  ]
}
