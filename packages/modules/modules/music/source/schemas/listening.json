{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://enbox.id/modules/music/v1/schemas/listening",
  "title": "ListeningData",
  "description": "Music: listening record.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "listenedAt": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "format": "date-time"
    },
    "durationSeconds": {
      "type": "number",
      "minimum": 0,
      "maximum": 604800
    },
    "positionSeconds": {
      "type": "number",
      "minimum": 0,
      "maximum": 10000000
    },
    "completed": {
      "type": "boolean"
    },
    "rating": {
      "$ref": "#/definitions/listeningRating"
    },
    "notes": {
      "$ref": "https://enbox.id/schemas/common/note-text/v1"
    },
    "source": {
      "$ref": "#/definitions/listeningSource"
    },
    "labels": {
      "$ref": "https://enbox.id/schemas/common/labels/v1"
    }
  },
  "required": [
    "listenedAt"
  ],
  "examples": [
    {
      "listenedAt": "2026-01-15T12:00:00Z",
      "completed": true
    }
  ],
  "definitions": {
    "listeningRating": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "value": {
          "type": "number",
          "minimum": 0,
          "maximum": 10
        },
        "scale": {
          "type": "integer",
          "enum": [
            5,
            10
          ]
        }
      },
      "required": [
        "value",
        "scale"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "scale": {
                "const": 5
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "maximum": 5,
                "type": "number"
              }
            }
          }
        }
      ]
    },
    "listeningRecordReference": {
      "$ref": "https://enbox.id/schemas/common/record-reference/v1"
    },
    "listeningSource": {
      "$ref": "https://enbox.id/schemas/common/provenance/v1"
    }
  }
}
