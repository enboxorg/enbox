{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://enbox.id/modules/music/v1/schemas/item",
  "title": "ItemData",
  "description": "Music: item record.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "kind": {
      "type": "string",
      "enum": [
        "track",
        "album",
        "artist",
        "playlist"
      ]
    },
    "artists": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      },
      "minItems": 0,
      "maxItems": 50
    },
    "album": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "releaseDate": {
      "type": "string",
      "minLength": 1,
      "maxLength": 10,
      "format": "date"
    },
    "durationSeconds": {
      "type": "number",
      "minimum": 0,
      "maximum": 10000000
    },
    "genres": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 80
      },
      "uniqueItems": true,
      "maxItems": 64
    },
    "url": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8192,
      "format": "uri"
    },
    "file": {
      "$ref": "#/definitions/itemRecordReference"
    },
    "favorite": {
      "type": "boolean"
    },
    "externalIds": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "system": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "value": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          }
        },
        "required": [
          "system",
          "value"
        ]
      },
      "minItems": 0,
      "maxItems": 30
    },
    "notes": {
      "$ref": "https://enbox.id/schemas/common/note-text/v1"
    },
    "source": {
      "$ref": "#/definitions/itemSource"
    },
    "labels": {
      "$ref": "https://enbox.id/schemas/common/labels/v1"
    }
  },
  "required": [
    "name",
    "kind"
  ],
  "examples": [
    {
      "name": "Example album",
      "kind": "album",
      "favorite": true
    }
  ],
  "definitions": {
    "itemRecordReference": {
      "$ref": "https://enbox.id/schemas/common/record-reference/v1"
    },
    "itemSource": {
      "$ref": "https://enbox.id/schemas/common/provenance/v1"
    }
  }
}
