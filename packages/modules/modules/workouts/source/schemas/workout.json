{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://enbox.id/modules/workouts/v1/schemas/workout",
  "title": "WorkoutData",
  "description": "Workouts: workout record.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "startedAt": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "format": "date-time"
    },
    "endedAt": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "format": "date-time"
    },
    "durationSeconds": {
      "type": "integer",
      "minimum": 0,
      "maximum": 604800
    },
    "distance": {
      "$ref": "#/definitions/workoutQuantity"
    },
    "routine": {
      "$ref": "#/definitions/workoutRecordReference"
    },
    "route": {
      "$ref": "#/definitions/workoutRecordReference"
    },
    "perceivedEffort": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10
    },
    "notes": {
      "$ref": "https://enbox.id/schemas/common/note-text/v1"
    },
    "source": {
      "$ref": "#/definitions/workoutSource"
    },
    "labels": {
      "$ref": "https://enbox.id/schemas/common/labels/v1"
    }
  },
  "required": [
    "name",
    "startedAt"
  ],
  "examples": [
    {
      "name": "Morning run",
      "startedAt": "2026-01-15T12:00:00Z",
      "distance": {
        "value": "5",
        "unit": "km"
      }
    }
  ],
  "definitions": {
    "workoutQuantity": {
      "$ref": "https://enbox.id/schemas/common/quantity/v1"
    },
    "workoutRecordReference": {
      "$ref": "https://enbox.id/schemas/common/record-reference/v1"
    },
    "workoutSource": {
      "$ref": "https://enbox.id/schemas/common/provenance/v1"
    }
  }
}
