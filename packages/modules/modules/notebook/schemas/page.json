{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://enbox.id/schemas/notebook/v1/page",
  "title": "PageData",
  "description": "Notebook: notebook/page; compatible with notesd notebook v1.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "title": {
      "type": "string"
    },
    "isTemplate": {
      "type": "boolean"
    },
    "pinned": {
      "type": "boolean"
    },
    "trashedAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "title"
  ]
}
