{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://enbox.id/modules/games/v1/schemas/game",
  "title": "GameData",
  "description": "Games: game record.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "platform": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "ownership": {
      "type": "string",
      "enum": [
        "owned",
        "borrowed",
        "subscription",
        "wanted",
        "other"
      ]
    },
    "state": {
      "type": "string",
      "enum": [
        "not-started",
        "playing",
        "paused",
        "completed",
        "abandoned"
      ]
    },
    "externalIds": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "system": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "value": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          }
        },
        "required": [
          "system",
          "value"
        ]
      },
      "minItems": 0,
      "maxItems": 30
    },
    "rating": {
      "$ref": "#/definitions/gameRating"
    },
    "purchase": {
      "$ref": "#/definitions/gameRecordReference"
    },
    "url": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8192,
      "format": "uri"
    },
    "notes": {
      "$ref": "https://enbox.id/schemas/common/note-text/v1"
    },
    "source": {
      "$ref": "#/definitions/gameSource"
    },
    "labels": {
      "$ref": "https://enbox.id/schemas/common/labels/v1"
    }
  },
  "required": [
    "title",
    "state"
  ],
  "examples": [
    {
      "title": "Example Game",
      "state": "playing",
      "platform": "PC"
    }
  ],
  "definitions": {
    "gameRating": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "value": {
          "type": "number",
          "minimum": 0,
          "maximum": 10
        },
        "scale": {
          "type": "integer",
          "enum": [
            5,
            10
          ]
        }
      },
      "required": [
        "value",
        "scale"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "scale": {
                "const": 5
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "maximum": 5,
                "type": "number"
              }
            }
          }
        }
      ]
    },
    "gameRecordReference": {
      "$ref": "https://enbox.id/schemas/common/record-reference/v1"
    },
    "gameSource": {
      "$ref": "https://enbox.id/schemas/common/provenance/v1"
    }
  }
}
