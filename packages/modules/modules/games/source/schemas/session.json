{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://enbox.id/modules/games/v1/schemas/session",
  "title": "SessionData",
  "description": "Games: session record.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "startedAt": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "format": "date-time"
    },
    "endedAt": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "format": "date-time"
    },
    "durationSeconds": {
      "type": "integer",
      "minimum": 0,
      "maximum": 604800
    },
    "withContacts": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/sessionRecordReference"
      },
      "minItems": 0,
      "maxItems": 100
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8192
    },
    "notes": {
      "$ref": "https://enbox.id/schemas/common/note-text/v1"
    },
    "source": {
      "$ref": "#/definitions/sessionSource"
    },
    "labels": {
      "$ref": "https://enbox.id/schemas/common/labels/v1"
    }
  },
  "required": [
    "startedAt"
  ],
  "examples": [
    {
      "startedAt": "2026-01-15T12:00:00Z",
      "durationSeconds": 3600
    }
  ],
  "definitions": {
    "sessionRecordReference": {
      "$ref": "https://enbox.id/schemas/common/record-reference/v1"
    },
    "sessionSource": {
      "$ref": "https://enbox.id/schemas/common/provenance/v1"
    }
  }
}
