{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://enbox.id/modules/games/v1/schemas/progress",
  "title": "ProgressData",
  "description": "Games: progress record.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "recordedAt": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "format": "date-time"
    },
    "chapter": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "level": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000000
    },
    "percent": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "achievement": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "state": {
      "type": "string",
      "enum": [
        "playing",
        "paused",
        "completed",
        "abandoned"
      ]
    },
    "notes": {
      "$ref": "https://enbox.id/schemas/common/note-text/v1"
    },
    "source": {
      "$ref": "#/definitions/progressSource"
    },
    "labels": {
      "$ref": "https://enbox.id/schemas/common/labels/v1"
    }
  },
  "required": [
    "recordedAt"
  ],
  "examples": [
    {
      "recordedAt": "2026-01-15T12:00:00Z",
      "state": "completed"
    }
  ],
  "anyOf": [
    {
      "required": [
        "chapter"
      ]
    },
    {
      "required": [
        "level"
      ]
    },
    {
      "required": [
        "percent"
      ]
    },
    {
      "required": [
        "achievement"
      ]
    },
    {
      "required": [
        "state"
      ]
    }
  ],
  "definitions": {
    "progressRecordReference": {
      "$ref": "https://enbox.id/schemas/common/record-reference/v1"
    },
    "progressSource": {
      "$ref": "https://enbox.id/schemas/common/provenance/v1"
    }
  }
}
