{
  "id": "games",
  "name": "Games",
  "category": "Media and learning",
  "description": "Owned/wanted games, platforms, play sessions, progress, and personal notes.",
  "moduleUri": "https://enbox.id/modules/games/v1",
  "exportName": "GamesModule",
  "status": "experimental",
  "definitionFile": "definition.json",
