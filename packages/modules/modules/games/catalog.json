      "type": "session",
      "dataFormats": [
        "application/json"
      ],
      "encryptionRequired": true,
      "schema": "https://enbox.id/modules/games/v1/schemas/session",
      "schemaFile": "schemas/session.json",
      "role": false,
      "immutable": false,
      "singleton": false
    },
    {
      "path": "game/progress",
      "type": "progress",
      "dataFormats": [
        "application/json"
      ],
      "encryptionRequired": true,
      "schema": "https://enbox.id/modules/games/v1/schemas/progress",
      "schemaFile": "schemas/progress.json",
      "role": false,
      "immutable": false,
      "singleton": false
    }
