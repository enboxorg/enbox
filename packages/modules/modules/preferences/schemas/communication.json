{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://enbox.id/modules/preferences/v1/schemas/communication",
  "title": "CommunicationData",
  "description": "Preferences: communication record.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "preferredChannels": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "app",
          "email",
          "phone",
          "sms",
          "video"
        ]
      },
      "minItems": 0,
      "maxItems": 5
    },
    "quietHoursStart": {
      "type": "string",
      "minLength": 1,
      "maxLength": 5,
      "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$"
    },
    "quietHoursEnd": {
      "type": "string",
      "minLength": 1,
      "maxLength": 5,
      "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$"
    },
    "timeZone": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "notes": {
      "$ref": "#/definitions/communicationNoteText"
    },
    "source": {
      "$ref": "#/definitions/communicationSource"
    },
    "labels": {
      "$ref": "#/definitions/communicationLabels"
    }
  },
  "required": [],
  "examples": [
    {
      "preferredChannels": [
        "app"
      ]
    }
  ],
  "minProperties": 1,
  "anyOf": [
    {
      "required": [
        "preferredChannels"
      ]
    },
    {
      "required": [
        "quietHoursStart"
      ]
    },
    {
      "required": [
        "quietHoursEnd"
      ]
    },
    {
      "required": [
        "timeZone"
      ]
    }
  ],
  "definitions": {
    "communicationRecordReference": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "recordId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "tenantDid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^did:[a-z0-9]+:[^\\s]+$"
        },
        "moduleUri": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192,
          "format": "uri"
        },
        "modulePath": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "contextId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "messageCid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      },
      "required": [
        "recordId"
      ],
      "description": "A DWN record link. An omitted tenantDid means the DID owning the referring record. A link grants no access."
    },
    "communicationSource": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "user-statement",
            "document-extraction",
            "import",
            "measurement",
            "derived"
          ]
        },
        "uri": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192,
          "format": "uri"
        },
        "record": {
          "$ref": "#/definitions/communicationRecordReference"
        },
        "conversationId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "messageId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "observedAt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "format": "date-time"
        },
        "actorDid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^did:[a-z0-9]+:[^\\s]+$"
        },
        "extractor": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "extractorVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "reviewedAt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "format": "date-time"
        },
        "reviewerDid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^did:[a-z0-9]+:[^\\s]+$"
        }
      },
      "required": [
        "kind"
      ]
    },
    "communicationNoteText": {
      "type": "string",
      "minLength": 0,
      "maxLength": 32768
    },
    "communicationLabels": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 80
      },
      "uniqueItems": true,
      "maxItems": 64
    }
  }
}
