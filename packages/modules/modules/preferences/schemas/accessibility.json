{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://enbox.id/modules/preferences/v1/schemas/accessibility",
  "title": "AccessibilityData",
  "description": "Preferences: accessibility record.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "reduceMotion": {
      "type": "boolean"
    },
    "highContrast": {
      "type": "boolean"
    },
    "textScale": {
      "type": "number",
      "minimum": 0.5,
      "maximum": 3
    },
    "captions": {
      "type": "boolean"
    },
    "screenReader": {
      "type": "boolean"
    },
    "notes": {
      "$ref": "#/definitions/accessibilityNoteText"
    },
    "source": {
      "$ref": "#/definitions/accessibilitySource"
    },
    "labels": {
      "$ref": "#/definitions/accessibilityLabels"
    }
  },
  "required": [],
  "examples": [
    {
      "reduceMotion": true
    }
  ],
  "minProperties": 1,
  "anyOf": [
    {
      "required": [
        "reduceMotion"
      ]
    },
    {
      "required": [
        "highContrast"
      ]
    },
    {
      "required": [
        "textScale"
      ]
    },
    {
      "required": [
        "captions"
      ]
    },
    {
      "required": [
        "screenReader"
      ]
    }
  ],
  "definitions": {
    "accessibilityRecordReference": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "recordId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "tenantDid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^did:[a-z0-9]+:[^\\s]+$"
        },
        "moduleUri": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192,
          "format": "uri"
        },
        "modulePath": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "contextId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "messageCid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      },
      "required": [
        "recordId"
      ],
      "description": "A DWN record link. An omitted tenantDid means the DID owning the referring record. A link grants no access."
    },
    "accessibilitySource": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "user-statement",
            "document-extraction",
            "import",
            "measurement",
            "derived"
          ]
        },
        "uri": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192,
          "format": "uri"
        },
        "record": {
          "$ref": "#/definitions/accessibilityRecordReference"
        },
        "conversationId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "messageId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "observedAt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "format": "date-time"
        },
        "actorDid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^did:[a-z0-9]+:[^\\s]+$"
        },
        "extractor": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "extractorVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "reviewedAt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "format": "date-time"
        },
        "reviewerDid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^did:[a-z0-9]+:[^\\s]+$"
        }
      },
      "required": [
        "kind"
      ]
    },
    "accessibilityNoteText": {
      "type": "string",
      "minLength": 0,
      "maxLength": 32768
    },
    "accessibilityLabels": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 80
      },
      "uniqueItems": true,
      "maxItems": 64
    }
  }
}
