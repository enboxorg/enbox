{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://enbox.id/modules/preferences/v1/schemas/accessibility",
  "title": "AccessibilityData",
  "description": "Preferences: accessibility record.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "reduceMotion": {
      "type": "boolean"
    },
    "highContrast": {
      "type": "boolean"
    },
    "textScale": {
      "type": "number",
      "minimum": 0.5,
      "maximum": 3
    },
    "captions": {
      "type": "boolean"
    },
    "screenReader": {
      "type": "boolean"
    },
    "notes": {
      "$ref": "https://enbox.id/schemas/common/note-text/v1"
    },
    "source": {
      "$ref": "#/definitions/accessibilitySource"
    },
    "labels": {
      "$ref": "https://enbox.id/schemas/common/labels/v1"
    }
  },
  "required": [],
  "examples": [
    {
      "reduceMotion": true
    }
  ],
  "minProperties": 1,
  "definitions": {
    "accessibilityRecordReference": {
      "$ref": "https://enbox.id/schemas/common/record-reference/v1"
    },
    "accessibilitySource": {
      "$ref": "https://enbox.id/schemas/common/provenance/v1"
    }
  },
  "anyOf": [
    {
      "required": [
        "reduceMotion"
      ]
    },
    {
      "required": [
        "highContrast"
      ]
    },
    {
      "required": [
        "textScale"
      ]
    },
    {
      "required": [
        "captions"
      ]
    },
    {
      "required": [
        "screenReader"
      ]
    }
  ]
}
