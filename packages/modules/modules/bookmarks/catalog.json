      "type": "folder",
      "dataFormats": [
        "application/json"
      ],
      "encryptionRequired": true,
      "schema": "https://enbox.id/modules/bookmarks/v1/schemas/folder",
      "schemaFile": "schemas/folder.json",
      "role": false,
      "immutable": false,
      "singleton": false
    },
    {
      "path": "folder/entry",
      "type": "entry",
      "dataFormats": [
        "application/json"
      ],
      "encryptionRequired": true,
      "schema": "https://enbox.id/modules/bookmarks/v1/schemas/entry",
      "schemaFile": "schemas/entry.json",
      "role": false,
      "immutable": false,
      "singleton": false
    },
    {
      "path": "bookmark/editor",
      "type": "editor",
      "dataFormats": [
        "application/json"
      ],
      "encryptionRequired": false,
