{
  "id": "bookmarks",
  "name": "Bookmarks",
  "category": "General personal records",
  "description": "Saved web/DID-relative references, annotations, folders, and ordered entries.",
  "moduleUri": "https://enbox.id/modules/bookmarks/v1",
  "exportName": "BookmarksModule",
  "status": "experimental",
  "definitionFile": "definition.json",
  "examplesFile": "examples.json",
  "captureExamples": [
    "Bookmark this DWN record for later."
  ],
  "dependencies": {},
  "records": [
