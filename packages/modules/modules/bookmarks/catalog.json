      "schemaFile": "schemas/viewer.json",
      "role": true,
      "immutable": true,
      "singleton": false
    },
    {
      "path": "folder/editor",
      "type": "editor",
      "dataFormats": [
        "application/json"
      ],
      "encryptionRequired": false,
