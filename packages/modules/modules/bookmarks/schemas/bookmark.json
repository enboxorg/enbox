{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://enbox.id/modules/bookmarks/v1/schemas/bookmark",
  "title": "BookmarkData",
  "description": "Bookmarks: bookmark record.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "url": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8192,
      "format": "uri"
    },
    "record": {
      "$ref": "#/definitions/bookmarkRecordReference"
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 16384
    },
    "savedAt": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "format": "date-time"
    },
    "state": {
      "type": "string",
      "enum": [
        "saved",
        "reading",
        "read",
        "archived"
      ]
    },
    "snapshot": {
      "$ref": "#/definitions/bookmarkRecordReference"
    },
    "notes": {
      "$ref": "#/definitions/bookmarkNoteText"
    },
    "source": {
      "$ref": "#/definitions/bookmarkSource"
    },
    "labels": {
      "$ref": "#/definitions/bookmarkLabels"
    }
  },
  "required": [
    "title"
  ],
  "examples": [
    {
      "title": "Example saved resource",
      "url": "https://example.com/article"
    }
  ],
  "oneOf": [
    {
      "required": [
        "url"
      ],
      "not": {
        "required": [
          "record"
        ]
      }
    },
    {
      "required": [
        "record"
      ],
      "not": {
        "required": [
          "url"
        ]
      }
    }
  ],
  "definitions": {
    "bookmarkRecordReference": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "recordId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "tenantDid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^did:[a-z0-9]+:[^\\s]+$"
        },
        "moduleUri": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192,
          "format": "uri"
        },
        "modulePath": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "contextId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "messageCid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      },
      "required": [
        "recordId"
      ],
      "description": "A DWN record link. An omitted tenantDid means the DID owning the referring record. A link grants no access."
    },
    "bookmarkSource": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "user-statement",
            "document-extraction",
            "import",
            "measurement",
            "derived"
          ]
        },
        "uri": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192,
          "format": "uri"
        },
        "record": {
          "$ref": "#/definitions/bookmarkRecordReference"
        },
        "conversationId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "messageId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "observedAt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "format": "date-time"
        },
        "actorDid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^did:[a-z0-9]+:[^\\s]+$"
        },
        "extractor": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "extractorVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "reviewedAt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "format": "date-time"
        },
        "reviewerDid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^did:[a-z0-9]+:[^\\s]+$"
        }
      },
      "required": [
        "kind"
      ]
    },
    "bookmarkNoteText": {
      "type": "string",
      "minLength": 0,
      "maxLength": 32768
    },
    "bookmarkLabels": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 80
      },
      "uniqueItems": true,
      "maxItems": 64
    }
  }
}
