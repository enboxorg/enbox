{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://enbox.id/modules/bookmarks/v1/schemas/folder",
  "title": "FolderData",
  "description": "Bookmarks: folder record.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8192
    },
    "notes": {
      "$ref": "https://enbox.id/schemas/common/note-text/v1"
    },
    "source": {
      "$ref": "#/definitions/folderSource"
    },
    "labels": {
      "$ref": "https://enbox.id/schemas/common/labels/v1"
    }
  },
  "required": [
    "name"
  ],
  "examples": [
    {
      "name": "Reading list"
    }
  ],
  "definitions": {
    "folderRecordReference": {
      "$ref": "https://enbox.id/schemas/common/record-reference/v1"
    },
    "folderSource": {
      "$ref": "https://enbox.id/schemas/common/provenance/v1"
    }
  }
}
