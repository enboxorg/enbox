{
  "id": "podcasts",
  "name": "Podcasts",
  "category": "Media and learning",
  "description": "Shows, followed feeds, episodes, queues, and playback progress.",
  "moduleUri": "https://enbox.id/modules/podcasts/v1",
  "exportName": "PodcastsModule",
  "status": "experimental",
  "definitionFile": "definition.json",
  "examplesFile": "examples.json",
  "captureExamples": [
    "I stopped this episode at 18 minutes."
  ],
  "dependencies": {},
  "records": [
    {
      "path": "show",
      "type": "show",
      "dataFormats": [
        "application/json"
      ],
      "encryptionRequired": true,
      "schema": "https://enbox.id/modules/podcasts/v1/schemas/show",
      "schemaFile": "schemas/show.json",
      "role": false,
      "immutable": false,
      "singleton": false
    },
    {
      "path": "show/episode",
      "type": "episode",
      "dataFormats": [
        "application/json"
      ],
      "encryptionRequired": true,
      "schema": "https://enbox.id/modules/podcasts/v1/schemas/episode",
      "schemaFile": "schemas/episode.json",
      "role": false,
      "immutable": false,
      "singleton": false
    },
    {
      "path": "show/episode/playback",
      "type": "playback",
      "dataFormats": [
        "application/json"
      ],
      "encryptionRequired": true,
      "schema": "https://enbox.id/modules/podcasts/v1/schemas/playback",
      "schemaFile": "schemas/playback.json",
      "role": false,
      "immutable": false,
      "singleton": true
    }
  ]
}
