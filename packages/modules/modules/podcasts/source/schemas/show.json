{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://enbox.id/modules/podcasts/v1/schemas/show",
  "title": "ShowData",
  "description": "Podcasts: show record.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "feedUrl": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8192,
      "format": "uri",
      "pattern": "^https?://"
    },
    "website": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8192,
      "format": "uri"
    },
    "publisher": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "followed": {
      "type": "boolean"
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8192
    },
    "notes": {
      "$ref": "https://enbox.id/schemas/common/note-text/v1"
    },
    "source": {
      "$ref": "#/definitions/showSource"
    },
    "labels": {
      "$ref": "https://enbox.id/schemas/common/labels/v1"
    }
  },
  "required": [
    "name",
    "feedUrl"
  ],
  "examples": [
    {
      "name": "Example Podcast",
      "feedUrl": "https://example.com/podcast.xml",
      "followed": true
    }
  ],
  "definitions": {
    "showRecordReference": {
      "$ref": "https://enbox.id/schemas/common/record-reference/v1"
    },
    "showSource": {
      "$ref": "https://enbox.id/schemas/common/provenance/v1"
    }
  }
}
