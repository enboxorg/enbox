{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://enbox.id/modules/mood/v1/schemas/check-in",
  "title": "CheckInData",
  "description": "Mood: checkIn record.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "recordedAt": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "format": "date-time"
    },
    "mood": {
      "type": "string",
      "enum": [
        "very-low",
        "low",
        "neutral",
        "good",
        "very-good",
        "mixed"
      ]
    },
    "feelings": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      },
      "minItems": 0,
      "maxItems": 30
    },
    "energy": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10
    },
    "stress": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10
    },
    "context": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8192
    },
    "journal": {
      "$ref": "#/definitions/checkInRecordReference"
    },
    "notes": {
      "$ref": "#/definitions/checkInNoteText"
    },
    "source": {
      "$ref": "#/definitions/checkInSource"
    },
    "labels": {
      "$ref": "#/definitions/checkInLabels"
    }
  },
  "required": [
    "recordedAt"
  ],
  "examples": [
    {
      "recordedAt": "2026-01-15T12:00:00Z",
      "feelings": [
        "calm"
      ],
      "energy": 3
    }
  ],
  "anyOf": [
    {
      "required": [
        "mood"
      ]
    },
    {
      "required": [
        "feelings"
      ],
      "properties": {
        "feelings": {
          "minItems": 1,
          "type": "array"
        }
      }
    },
    {
      "required": [
        "energy"
      ]
    },
    {
      "required": [
        "stress"
      ]
    }
  ],
  "definitions": {
    "checkInRecordReference": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "recordId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "tenantDid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^did:[a-z0-9]+:[^\\s]+$"
        },
        "moduleUri": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192,
          "format": "uri"
        },
        "modulePath": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "contextId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "messageCid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      },
      "required": [
        "recordId"
      ],
      "description": "A DWN record link. An omitted tenantDid means the DID owning the referring record. A link grants no access."
    },
    "checkInSource": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "user-statement",
            "document-extraction",
            "import",
            "measurement",
            "derived"
          ]
        },
        "uri": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192,
          "format": "uri"
        },
        "record": {
          "$ref": "#/definitions/checkInRecordReference"
        },
        "conversationId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "messageId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "observedAt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "format": "date-time"
        },
        "actorDid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^did:[a-z0-9]+:[^\\s]+$"
        },
        "extractor": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "extractorVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "reviewedAt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "format": "date-time"
        },
        "reviewerDid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^did:[a-z0-9]+:[^\\s]+$"
        }
      },
      "required": [
        "kind"
      ]
    },
    "checkInNoteText": {
      "type": "string",
      "minLength": 0,
      "maxLength": 32768
    },
    "checkInLabels": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 80
      },
      "uniqueItems": true,
      "maxItems": 64
    }
  }
}
