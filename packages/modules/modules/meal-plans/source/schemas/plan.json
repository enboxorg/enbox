{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://enbox.id/modules/meal-plans/v1/schemas/plan",
  "title": "PlanData",
  "description": "Meal Plans: plan record.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "startsOn": {
      "type": "string",
      "minLength": 1,
      "maxLength": 10,
      "format": "date"
    },
    "endsOn": {
      "type": "string",
      "minLength": 1,
      "maxLength": 10,
      "format": "date"
    },
    "people": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/planRecordReference"
      },
      "minItems": 0,
      "maxItems": 50
    },
    "notes": {
      "$ref": "https://enbox.id/schemas/common/note-text/v1"
    },
    "source": {
      "$ref": "#/definitions/planSource"
    },
    "labels": {
      "$ref": "https://enbox.id/schemas/common/labels/v1"
    }
  },
  "required": [
    "name"
  ],
  "examples": [
    {
      "name": "This week"
    }
  ],
  "definitions": {
    "planRecordReference": {
      "$ref": "https://enbox.id/schemas/common/record-reference/v1"
    },
    "planSource": {
      "$ref": "https://enbox.id/schemas/common/provenance/v1"
    }
  }
}
