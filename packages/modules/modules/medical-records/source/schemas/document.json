{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://enbox.id/modules/medical-records/v1/schemas/document",
  "title": "DocumentData",
  "description": "Medical Records: document record.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "kind": {
      "type": "string",
      "enum": [
        "lab-report",
        "imaging",
        "visit-summary",
        "prescription",
        "immunization",
        "other"
      ]
    },
    "issuedOn": {
      "type": "string",
      "minLength": 1,
      "maxLength": 10,
      "format": "date"
    },
    "provider": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "clinician": {
      "$ref": "#/definitions/documentRecordReference"
    },
    "files": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/documentRecordReference"
      },
      "minItems": 0,
      "maxItems": 50
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32768
    },
    "reviewState": {
      "type": "string",
      "enum": [
        "unreviewed",
        "reviewed",
        "corrected"
      ]
    },
    "notes": {
      "$ref": "https://enbox.id/schemas/common/note-text/v1"
    },
    "source": {
      "$ref": "#/definitions/documentSource"
    },
    "labels": {
      "$ref": "https://enbox.id/schemas/common/labels/v1"
    }
  },
  "required": [
    "title",
    "kind"
  ],
  "examples": [
    {
      "title": "Annual laboratory report",
      "kind": "lab-report"
    }
  ],
  "definitions": {
    "documentRecordReference": {
      "$ref": "https://enbox.id/schemas/common/record-reference/v1"
    },
    "documentSource": {
      "$ref": "https://enbox.id/schemas/common/provenance/v1"
    }
  }
}
