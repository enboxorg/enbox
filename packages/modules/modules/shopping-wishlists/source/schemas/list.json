{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://enbox.id/modules/shopping-wishlists/v1/schemas/list",
  "title": "ListData",
  "description": "Shopping Wishlists: list record.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "budget": {
      "$ref": "#/definitions/listMoney"
    },
    "occasion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "notes": {
      "$ref": "https://enbox.id/schemas/common/note-text/v1"
    },
    "source": {
      "$ref": "#/definitions/listSource"
    },
    "labels": {
      "$ref": "https://enbox.id/schemas/common/labels/v1"
    }
  },
  "required": [
    "name"
  ],
  "examples": [
    {
      "name": "Outdoor gear"
    }
  ],
  "definitions": {
    "listMoney": {
      "$ref": "https://enbox.id/schemas/common/money/v1"
    },
    "listRecordReference": {
      "$ref": "https://enbox.id/schemas/common/record-reference/v1"
    },
    "listSource": {
      "$ref": "https://enbox.id/schemas/common/provenance/v1"
    }
  }
}
