{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://enbox.id/modules/trips/v1/schemas/item",
  "title": "ItemData",
  "description": "Trips: item record.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "kind": {
      "type": "string",
      "enum": [
        "travel",
        "stay",
        "activity",
        "meal",
        "other"
      ]
    },
    "startsAt": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "format": "date-time"
    },
    "endsAt": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "format": "date-time"
    },
    "place": {
      "$ref": "#/definitions/itemRecordReference"
    },
    "reservation": {
      "$ref": "#/definitions/itemRecordReference"
    },
    "resource": {
      "$ref": "#/definitions/itemRecordReference"
    },
    "sortOrder": {
      "type": "number",
      "minimum": 0,
      "maximum": 1000000000
    },
    "notes": {
      "$ref": "https://enbox.id/schemas/common/note-text/v1"
    },
    "source": {
      "$ref": "#/definitions/itemSource"
    },
    "labels": {
      "$ref": "https://enbox.id/schemas/common/labels/v1"
    }
  },
  "required": [
    "name",
    "kind"
  ],
  "examples": [
    {
      "name": "Walk by the river",
      "kind": "activity",
      "sortOrder": 1
    }
  ],
  "definitions": {
    "itemRecordReference": {
      "$ref": "https://enbox.id/schemas/common/record-reference/v1"
    },
    "itemSource": {
      "$ref": "https://enbox.id/schemas/common/provenance/v1"
    }
  }
}
