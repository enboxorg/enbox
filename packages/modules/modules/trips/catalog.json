{
  "id": "trips",
  "name": "Trips",
  "category": "Travel and outdoors",
  "description": "Destinations, travellers, dates, itinerary items, and links to reservations and resources.",
  "moduleUri": "https://enbox.id/modules/trips/v1",
  "exportName": "TripsModule",
  "status": "experimental",
  "definitionFile": "definition.json",
  "examplesFile": "examples.json",
  "captureExamples": [
    "We're planning a week in Lisbon in June."
  ],
  "dependencies": {},
  "records": [
    {
      "path": "trip",
      "type": "trip",
      "dataFormats": [
        "application/json"
      ],
      "encryptionRequired": true,
      "schema": "https://enbox.id/modules/trips/v1/schemas/trip",
      "schemaFile": "schemas/trip.json",
      "role": false,
      "immutable": false,
      "singleton": false
    },
    {
      "path": "trip/item",
      "type": "item",
      "dataFormats": [
        "application/json"
      ],
      "encryptionRequired": true,
      "schema": "https://enbox.id/modules/trips/v1/schemas/item",
      "schemaFile": "schemas/item.json",
      "role": false,
      "immutable": false,
      "singleton": false
    },
    {
      "path": "trip/editor",
      "type": "editor",
      "dataFormats": [
        "application/json"
      ],
      "encryptionRequired": false,
      "schema": "https://enbox.id/modules/trips/v1/schemas/editor",
      "schemaFile": "schemas/editor.json",
      "role": true,
      "immutable": true,
      "singleton": false
    },
    {
      "path": "trip/viewer",
      "type": "viewer",
      "dataFormats": [
        "application/json"
      ],
      "encryptionRequired": false,
      "schema": "https://enbox.id/modules/trips/v1/schemas/viewer",
      "schemaFile": "schemas/viewer.json",
      "role": true,
      "immutable": true,
      "singleton": false
    }
  ],
  "capture": {
    "identity": "Match the selected trip and itinerary item purpose.",
    "exclude": [
      "Copying private reservations or identity documents into the trip audience automatically."
    ],
    "workflow": "Maintain travel intent and itinerary links; distinguish logistical plans from authoritative booking/event times."
  }
}
