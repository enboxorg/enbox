{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://enbox.id/modules/housing/v1/schemas/occupancy",
  "title": "OccupancyData",
  "description": "Housing: occupancy record.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "startsOn": {
      "type": "string",
      "minLength": 1,
      "maxLength": 10,
      "format": "date"
    },
    "endsOn": {
      "type": "string",
      "minLength": 1,
      "maxLength": 10,
      "format": "date"
    },
    "tenure": {
      "type": "string",
      "enum": [
        "owned",
        "rented",
        "guest",
        "other"
      ]
    },
    "people": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/occupancyRecordReference"
      },
      "minItems": 0,
      "maxItems": 50
    },
    "notes": {
      "$ref": "https://enbox.id/schemas/common/note-text/v1"
    },
    "source": {
      "$ref": "#/definitions/occupancySource"
    },
    "labels": {
      "$ref": "https://enbox.id/schemas/common/labels/v1"
    }
  },
  "required": [
    "startsOn",
    "tenure"
  ],
  "examples": [
    {
      "startsOn": "2026-01-15",
      "tenure": "rented"
    }
  ],
  "definitions": {
    "occupancyRecordReference": {
      "$ref": "https://enbox.id/schemas/common/record-reference/v1"
    },
    "occupancySource": {
      "$ref": "https://enbox.id/schemas/common/provenance/v1"
    }
  }
}
