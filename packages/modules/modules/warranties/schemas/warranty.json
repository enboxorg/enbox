{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://enbox.id/modules/warranties/v1/schemas/warranty",
  "title": "WarrantyData",
  "description": "Warranties: warranty record.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "provider": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "policyNumber": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "startsOn": {
      "type": "string",
      "minLength": 1,
      "maxLength": 10,
      "format": "date"
    },
    "expiresOn": {
      "type": "string",
      "minLength": 1,
      "maxLength": 10,
      "format": "date"
    },
    "coverage": {
      "type": "string",
      "minLength": 1,
      "maxLength": 16384
    },
    "exclusions": {
      "type": "string",
      "minLength": 1,
      "maxLength": 16384
    },
    "contact": {
      "$ref": "#/definitions/warrantyRecordReference"
    },
    "documents": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/warrantyRecordReference"
      },
      "minItems": 0,
      "maxItems": 20
    },
    "state": {
      "type": "string",
      "enum": [
        "active",
        "expired",
        "cancelled"
      ]
    },
    "notes": {
      "$ref": "#/definitions/warrantyNoteText"
    },
    "source": {
      "$ref": "#/definitions/warrantySource"
    },
    "labels": {
      "$ref": "#/definitions/warrantyLabels"
    }
  },
  "required": [
    "provider"
  ],
  "examples": [
    {
      "provider": "Example Appliances",
      "startsOn": "2026-01-15",
      "expiresOn": "2029-01-15"
    }
  ],
  "definitions": {
    "warrantyRecordReference": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "recordId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "tenantDid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^did:[a-z0-9]+:[^\\s]+$"
        },
        "moduleUri": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192,
          "format": "uri"
        },
        "modulePath": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "contextId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "messageCid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      },
      "required": [
        "recordId"
      ],
      "description": "A DWN record link. An omitted tenantDid means the DID owning the referring record. A link grants no access."
    },
    "warrantySource": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "user-statement",
            "document-extraction",
            "import",
            "measurement",
            "derived"
          ]
        },
        "uri": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192,
          "format": "uri"
        },
        "record": {
          "$ref": "#/definitions/warrantyRecordReference"
        },
        "conversationId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "messageId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "observedAt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "format": "date-time"
        },
        "actorDid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^did:[a-z0-9]+:[^\\s]+$"
        },
        "extractor": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "extractorVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "reviewedAt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "format": "date-time"
        },
        "reviewerDid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^did:[a-z0-9]+:[^\\s]+$"
        }
      },
      "required": [
        "kind"
      ]
    },
    "warrantyNoteText": {
      "type": "string",
      "minLength": 0,
      "maxLength": 32768
    },
    "warrantyLabels": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 80
      },
      "uniqueItems": true,
      "maxItems": 64
    }
  }
}
