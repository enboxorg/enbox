{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://enbox.id/modules/warranties/v1/schemas/claim",
  "title": "ClaimData",
  "description": "Warranties: claim record.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "reference": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "openedAt": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "format": "date-time"
    },
    "issue": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8192
    },
    "state": {
      "type": "string",
      "enum": [
        "opened",
        "submitted",
        "accepted",
        "rejected",
        "resolved",
        "cancelled"
      ]
    },
    "resolution": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8192
    },
    "resolvedAt": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "format": "date-time"
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/claimRecordReference"
      },
      "minItems": 0,
      "maxItems": 50
    },
    "notes": {
      "type": "string",
      "minLength": 0,
      "maxLength": 32768
    },
    "source": {
      "$ref": "#/definitions/claimSource"
    },
    "labels": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 80
      },
      "uniqueItems": true,
      "maxItems": 64
    }
  },
  "required": [
    "issue",
    "state"
  ],
  "examples": [
    {
      "issue": "Motor stopped working",
      "state": "opened"
    }
  ],
  "definitions": {
    "claimRecordReference": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "recordId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "tenantDid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^did:[a-z0-9]+:[^\\s]+$"
        },
        "moduleUri": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192,
          "format": "uri"
        },
        "modulePath": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "contextId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "messageCid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      },
      "required": [
        "recordId"
      ],
      "description": "A DWN record link. An omitted tenantDid means the DID owning the referring record. A link grants no access."
    },
    "claimSource": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "user-statement",
            "document-extraction",
            "import",
            "measurement",
            "derived"
          ]
        },
        "uri": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192,
          "format": "uri"
        },
        "record": {
          "$ref": "#/definitions/claimRecordReference"
        },
        "conversationId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "messageId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "observedAt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "format": "date-time"
        },
        "actorDid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^did:[a-z0-9]+:[^\\s]+$"
        },
        "extractor": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "extractorVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "reviewedAt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "format": "date-time"
        },
        "reviewerDid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^did:[a-z0-9]+:[^\\s]+$"
        }
      },
      "required": [
        "kind"
      ]
    }
  }
}
