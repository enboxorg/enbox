{
  "id": "credentials",
  "name": "Credentials",
  "category": "Identity and digital life",
  "description": "Issuer-secured credential artifacts, local verification observations, and approved presentation history.",
  "moduleUri": "https://enbox.id/modules/credentials/v1",
  "exportName": "CredentialsModule",
  "status": "experimental",
  "definitionFile": "definition.json",
  "examplesFile": "examples.json",
  "captureExamples": [
    "Store the credential issued to my DID."
  ],
  "dependencies": {},
  "records": [
    {
      "path": "credential",
      "type": "credential",
      "dataFormats": [
        "application/json"
      ],
      "encryptionRequired": true,
      "schema": "https://enbox.id/modules/credentials/v1/schemas/credential",
      "schemaFile": "schemas/credential.json",
      "role": false,
      "immutable": false,
      "singleton": false
    },
    {
      "path": "credential/artifact",
      "type": "artifact",
      "dataFormats": [
        "application/octet-stream"
      ],
      "encryptionRequired": true,
      "role": false,
      "immutable": true,
      "singleton": true
    },
    {
      "path": "credential/verification",
      "type": "verification",
      "dataFormats": [
        "application/json"
      ],
      "encryptionRequired": true,
      "schema": "https://enbox.id/modules/credentials/v1/schemas/verification",
      "schemaFile": "schemas/verification.json",
      "role": false,
      "immutable": true,
      "singleton": false
    },
    {
      "path": "presentation",
      "type": "presentation",
      "dataFormats": [
        "application/json"
      ],
      "encryptionRequired": true,
      "schema": "https://enbox.id/modules/credentials/v1/schemas/presentation",
      "schemaFile": "schemas/presentation.json",
      "role": false,
      "immutable": false,
      "singleton": false
    }
  ],
  "capture": {
    "identity": "Match native credential identifier, issuer, format and the selected immutable artifact.",
    "exclude": [
      "Creating a verifiable credential from OCR fields or a user assertion."
    ],
    "workflow": "Preserve issuer-secured bytes; record verification and disclosure decisions separately from editable metadata."
  }
}
