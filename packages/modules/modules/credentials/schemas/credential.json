{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://enbox.id/modules/credentials/v1/schemas/credential",
  "title": "CredentialData",
  "description": "Credentials: credential record.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "format": {
      "type": "string",
      "enum": [
        "vc-jwt",
        "vc-data-integrity",
        "sd-jwt-vc",
        "mdoc"
      ]
    },
    "formatVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "credentialId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8192,
      "format": "uri"
    },
    "issuer": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8192,
      "format": "uri"
    },
    "subjectIds": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 8192,
        "format": "uri"
      },
      "minItems": 0,
      "maxItems": 100
    },
    "credentialTypes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512
      },
      "minItems": 0,
      "maxItems": 100
    },
    "validFrom": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "format": "date-time"
    },
    "validUntil": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "format": "date-time"
    },
    "receivedAt": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "format": "date-time"
    },
    "identityDocument": {
      "$ref": "#/definitions/credentialRecordReference"
    },
    "holderKeyId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "statusReference": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "uri": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192,
          "format": "uri"
        },
        "type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "index": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      },
      "required": [
        "uri",
        "type"
      ]
    },
    "notes": {
      "type": "string",
      "minLength": 0,
      "maxLength": 32768
    },
    "source": {
      "$ref": "#/definitions/credentialSource"
    },
    "labels": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 80
      },
      "uniqueItems": true,
      "maxItems": 64
    }
  },
  "required": [
    "label",
    "format"
  ],
  "examples": [
    {
      "label": "Self-issued demonstration membership",
      "format": "vc-jwt",
      "formatVersion": "2.0",
      "issuer": "did:jwk:eyJjcnYiOiJFZDI1NTE5Iiwia3R5IjoiT0tQIiwieCI6InhhLW01RjU1MU93LVFHRV9keXlsRjVGdUpDQkc4Y1VveDJsemF6VGd3ME0iLCJraWQiOiJSZFFfUThhbW1xUWw2Y0NPTnpLd1o2ajVoUUZodlZZNG52ZVRsRGdoWnRzIiwiYWxnIjoiRWREU0EifQ",
      "subjectIds": [
        "did:jwk:eyJjcnYiOiJFZDI1NTE5Iiwia3R5IjoiT0tQIiwieCI6InJNcERlUEM1NTBQT1ZYT2QtamlsQzVGVWZoeUhTLWlld01HZ3Z6TnlwRkEiLCJraWQiOiJRb0swZWg2UFdfa2JUcUdsdmNCalZPZHMzWmdQalJaVDVSRUN2Mm83Wlg0IiwiYWxnIjoiRWREU0EifQ"
      ],
      "credentialTypes": [
        "VerifiableCredential"
      ],
      "validFrom": "2026-01-01T00:00:00Z"
    }
  ],
  "definitions": {
    "credentialRecordReference": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "recordId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "tenantDid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^did:[a-z0-9]+:[^\\s]+$"
        },
        "moduleUri": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192,
          "format": "uri"
        },
        "modulePath": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "contextId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "messageCid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      },
      "required": [
        "recordId"
      ],
      "description": "A DWN record link. An omitted tenantDid means the DID owning the referring record. A link grants no access."
    },
    "credentialSource": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "user-statement",
            "document-extraction",
            "import",
            "measurement",
            "derived"
          ]
        },
        "uri": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192,
          "format": "uri"
        },
        "record": {
          "$ref": "#/definitions/credentialRecordReference"
        },
        "conversationId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "messageId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "observedAt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "format": "date-time"
        },
        "actorDid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^did:[a-z0-9]+:[^\\s]+$"
        },
        "extractor": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "extractorVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "reviewedAt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "format": "date-time"
        },
        "reviewerDid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^did:[a-z0-9]+:[^\\s]+$"
        }
      },
      "required": [
        "kind"
      ]
    }
  }
}
