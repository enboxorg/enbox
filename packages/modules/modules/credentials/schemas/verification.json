{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://enbox.id/modules/credentials/v1/schemas/verification",
  "title": "VerificationData",
  "description": "Credentials: verification record.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "artifact": {
      "$ref": "#/definitions/verificationRecordReference"
    },
    "checkedAt": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "format": "date-time"
    },
    "verifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "verifierVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "policy": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "outcome": {
      "type": "string",
      "enum": [
        "valid",
        "invalid",
        "indeterminate"
      ]
    },
    "proof": {
      "type": "string",
      "enum": [
        "valid",
        "invalid",
        "unsupported",
        "not-checked"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "revoked",
        "suspended",
        "unknown",
        "not-provided"
      ]
    },
    "holderBinding": {
      "type": "string",
      "enum": [
        "valid",
        "invalid",
        "not-present",
        "not-checked"
      ]
    },
    "reasons": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2048
      },
      "minItems": 0,
      "maxItems": 100
    },
    "notes": {
      "$ref": "#/definitions/verificationNoteText"
    },
    "source": {
      "$ref": "#/definitions/verificationSource"
    },
    "labels": {
      "$ref": "#/definitions/verificationLabels"
    }
  },
  "required": [
    "artifact",
    "checkedAt",
    "verifier",
    "outcome",
    "proof",
    "status",
    "holderBinding"
  ],
  "examples": [
    {
      "artifact": {
        "recordId": "example-record"
      },
      "checkedAt": "2026-01-15T12:00:00Z",
      "verifier": "Example verifier",
      "outcome": "indeterminate",
      "proof": "not-checked",
      "status": "unknown",
      "holderBinding": "not-checked"
    }
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "valid"
          }
        }
      },
      "then": {
        "properties": {
          "proof": {
            "const": "valid"
          },
          "status": {
            "enum": [
              "active",
              "not-provided"
            ]
          },
          "holderBinding": {
            "enum": [
              "valid",
              "not-present"
            ]
          }
        }
      }
    }
  ],
  "definitions": {
    "verificationRecordReference": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "recordId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "tenantDid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^did:[a-z0-9]+:[^\\s]+$"
        },
        "moduleUri": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192,
          "format": "uri"
        },
        "modulePath": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "contextId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "messageCid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      },
      "required": [
        "recordId"
      ],
      "description": "A DWN record link. An omitted tenantDid means the DID owning the referring record. A link grants no access."
    },
    "verificationSource": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "user-statement",
            "document-extraction",
            "import",
            "measurement",
            "derived"
          ]
        },
        "uri": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192,
          "format": "uri"
        },
        "record": {
          "$ref": "#/definitions/verificationRecordReference"
        },
        "conversationId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "messageId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "observedAt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "format": "date-time"
        },
        "actorDid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^did:[a-z0-9]+:[^\\s]+$"
        },
        "extractor": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "extractorVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "reviewedAt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "format": "date-time"
        },
        "reviewerDid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^did:[a-z0-9]+:[^\\s]+$"
        }
      },
      "required": [
        "kind"
      ]
    },
    "verificationNoteText": {
      "type": "string",
      "minLength": 0,
      "maxLength": 32768
    },
    "verificationLabels": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 80
      },
      "uniqueItems": true,
      "maxItems": 64
    }
  }
}
