{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://enbox.id/modules/credentials/v1/schemas/verification",
  "title": "VerificationData",
  "description": "Credentials: verification record.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "artifact": {
      "$ref": "#/definitions/verificationRecordReference"
    },
    "checkedAt": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "format": "date-time"
    },
    "verifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "verifierVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "policy": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "outcome": {
      "type": "string",
      "enum": [
        "valid",
        "invalid",
        "indeterminate"
      ]
    },
    "proof": {
      "type": "string",
      "enum": [
        "valid",
        "invalid",
        "unsupported",
        "not-checked"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "revoked",
        "suspended",
        "unknown",
        "not-provided"
      ]
    },
    "holderBinding": {
      "type": "string",
      "enum": [
        "valid",
        "invalid",
        "not-present",
        "not-checked"
      ]
    },
    "reasons": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2048
      },
      "minItems": 0,
      "maxItems": 100
    },
    "notes": {
      "$ref": "https://enbox.id/schemas/common/note-text/v1"
    },
    "source": {
      "$ref": "#/definitions/verificationSource"
    },
    "labels": {
      "$ref": "https://enbox.id/schemas/common/labels/v1"
    }
  },
  "required": [
    "artifact",
    "checkedAt",
    "verifier",
    "outcome",
    "proof",
    "status",
    "holderBinding"
  ],
  "examples": [
    {
      "artifact": {
        "recordId": "example-record"
      },
      "checkedAt": "2026-01-15T12:00:00Z",
      "verifier": "Example verifier",
      "outcome": "indeterminate",
      "proof": "not-checked",
      "status": "unknown",
      "holderBinding": "not-checked"
    }
  ],
  "definitions": {
    "verificationRecordReference": {
      "$ref": "https://enbox.id/schemas/common/record-reference/v1"
    },
    "verificationSource": {
      "$ref": "https://enbox.id/schemas/common/provenance/v1"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "valid"
          }
        }
      },
      "then": {
        "properties": {
          "proof": {
            "const": "valid"
          },
          "status": {
            "enum": [
              "active",
              "not-provided"
            ]
          },
          "holderBinding": {
            "enum": [
              "valid",
              "not-present"
            ]
          }
        }
      }
    }
  ]
}
