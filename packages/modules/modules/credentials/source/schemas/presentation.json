{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://enbox.id/modules/credentials/v1/schemas/presentation",
  "title": "PresentationData",
  "description": "Credentials: presentation record.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "verifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8192,
      "format": "uri"
    },
    "requestedAt": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "format": "date-time"
    },
    "state": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "sent",
        "denied",
        "failed"
      ]
    },
    "request": {
      "$ref": "#/definitions/presentationRecordReference"
    },
    "credentials": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/presentationRecordReference"
      },
      "minItems": 0,
      "maxItems": 100
    },
    "disclosures": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "credential": {
            "$ref": "#/definitions/presentationRecordReference"
          },
          "paths": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            },
            "minItems": 0,
            "maxItems": 200
          }
        },
        "required": [
          "credential",
          "paths"
        ]
      },
      "minItems": 0,
      "maxItems": 100
    },
    "approvedAt": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "format": "date-time"
    },
    "sentAt": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "format": "date-time"
    },
    "expiresAt": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "format": "date-time"
    },
    "sessionId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "error": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8192
    },
    "notes": {
      "$ref": "https://enbox.id/schemas/common/note-text/v1"
    },
    "source": {
      "$ref": "#/definitions/presentationSource"
    },
    "labels": {
      "$ref": "https://enbox.id/schemas/common/labels/v1"
    }
  },
  "required": [
    "verifier",
    "requestedAt",
    "state"
  ],
  "examples": [
    {
      "verifier": "https://verifier.example",
      "requestedAt": "2026-01-15T12:00:00Z",
      "state": "pending"
    }
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "state": {
            "enum": [
              "approved",
              "sent"
            ]
          }
        }
      },
      "then": {
        "required": [
          "credentials",
          "approvedAt"
        ],
        "properties": {
          "credentials": {
            "type": "array",
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "const": "sent"
          }
        }
      },
      "then": {
        "required": [
          "sentAt"
        ]
      }
    }
  ],
  "definitions": {
    "presentationRecordReference": {
      "$ref": "https://enbox.id/schemas/common/record-reference/v1"
    },
    "presentationSource": {
      "$ref": "https://enbox.id/schemas/common/provenance/v1"
    }
  }
}
