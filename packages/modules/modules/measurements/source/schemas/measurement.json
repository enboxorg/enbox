{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://enbox.id/modules/measurements/v1/schemas/measurement",
  "title": "MeasurementData",
  "description": "Measurements: measurement record.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "kind": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "value": {
      "type": "string",
      "minLength": 1,
      "maxLength": 81,
      "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$"
    },
    "unit": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "measuredAt": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "format": "date-time"
    },
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "value": {
            "type": "string",
            "minLength": 1,
            "maxLength": 81,
            "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$"
          },
          "unit": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          }
        },
        "required": [
          "name",
          "value",
          "unit"
        ]
      },
      "minItems": 0,
      "maxItems": 20
    },
    "method": {
      "type": "string",
      "enum": [
        "manual",
        "device",
        "laboratory",
        "other"
      ]
    },
    "device": {
      "$ref": "#/definitions/measurementRecordReference"
    },
    "document": {
      "$ref": "#/definitions/measurementRecordReference"
    },
    "notes": {
      "$ref": "https://enbox.id/schemas/common/note-text/v1"
    },
    "source": {
      "$ref": "#/definitions/measurementSource"
    },
    "labels": {
      "$ref": "https://enbox.id/schemas/common/labels/v1"
    }
  },
  "required": [
    "kind",
    "measuredAt"
  ],
  "examples": [
    {
      "kind": "body-weight",
      "value": "70.5",
      "unit": "kg",
      "measuredAt": "2026-01-15T12:00:00Z",
      "method": "manual"
    }
  ],
  "oneOf": [
    {
      "required": [
        "value",
        "unit"
      ],
      "not": {
        "required": [
          "components"
        ]
      }
    },
    {
      "required": [
        "components"
      ],
      "properties": {
        "components": {
          "minItems": 1,
          "type": "array"
        }
      },
      "not": {
        "anyOf": [
          {
            "required": [
              "value"
            ]
          },
          {
            "required": [
              "unit"
            ]
          }
        ]
      }
    }
  ],
  "definitions": {
    "measurementRecordReference": {
      "$ref": "https://enbox.id/schemas/common/record-reference/v1"
    },
    "measurementSource": {
      "$ref": "https://enbox.id/schemas/common/provenance/v1"
    }
  }
}
