{
  "id": "notes",
  "name": "Notes",
  "category": "General personal records",
  "description": "Personal writing, drafts, journal entries, and research notes.",
  "moduleUri": "https://enbox.id/modules/notes/v1",
  "exportName": "NotesModule",
  "status": "experimental",
  "definitionFile": "definition.json",
  "examplesFile": "examples.json",
  "captureExamples": [
    "Save this thought for later."
  ],
  "dependencies": {},
  "records": [
    {
      "path": "note",
      "type": "note",
      "dataFormats": [
        "application/json"
      ],
      "encryptionRequired": true,
      "schema": "https://enbox.id/modules/notes/v1/schemas/note",
      "schemaFile": "schemas/note.json",
      "role": false,
      "immutable": false,
      "singleton": false
    },
    {
      "path": "note/editor",
      "type": "editor",
      "dataFormats": [
        "application/json"
      ],
      "encryptionRequired": false,
      "schema": "https://enbox.id/modules/notes/v1/schemas/editor",
      "schemaFile": "schemas/editor.json",
      "role": true,
      "immutable": true,
      "singleton": false
    },
    {
      "path": "note/viewer",
      "type": "viewer",
      "dataFormats": [
        "application/json"
      ],
      "encryptionRequired": false,
      "schema": "https://enbox.id/modules/notes/v1/schemas/viewer",
      "schemaFile": "schemas/viewer.json",
      "role": true,
      "immutable": true,
      "singleton": false
    }
  ]
}
