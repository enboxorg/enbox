{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://enbox.id/modules/sleep/v1/schemas/session",
  "title": "SessionData",
  "description": "Sleep: session record.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "startedAt": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "format": "date-time"
    },
    "endedAt": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "format": "date-time"
    },
    "kind": {
      "type": "string",
      "enum": [
        "night",
        "nap",
        "other"
      ]
    },
    "quality": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    },
    "interruptions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "startedAt": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "format": "date-time"
          },
          "durationMinutes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1440
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          }
        },
        "required": [
          "startedAt"
        ]
      },
      "minItems": 0,
      "maxItems": 100
    },
    "method": {
      "type": "string",
      "enum": [
        "self-report",
        "device"
      ]
    },
    "device": {
      "$ref": "#/definitions/sessionRecordReference"
    },
    "notes": {
      "$ref": "#/definitions/sessionNoteText"
    },
    "source": {
      "$ref": "#/definitions/sessionSource"
    },
    "labels": {
      "$ref": "#/definitions/sessionLabels"
    }
  },
  "required": [
    "startedAt",
    "endedAt"
  ],
  "examples": [
    {
      "startedAt": "2026-01-14T23:00:00Z",
      "endedAt": "2026-01-15T07:00:00Z",
      "kind": "night"
    }
  ],
  "definitions": {
    "sessionRecordReference": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "recordId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "tenantDid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^did:[a-z0-9]+:[^\\s]+$"
        },
        "moduleUri": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192,
          "format": "uri"
        },
        "modulePath": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "contextId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "messageCid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      },
      "required": [
        "recordId"
      ],
      "description": "A DWN record link. An omitted tenantDid means the DID owning the referring record. A link grants no access."
    },
    "sessionSource": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "user-statement",
            "document-extraction",
            "import",
            "measurement",
            "derived"
          ]
        },
        "uri": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192,
          "format": "uri"
        },
        "record": {
          "$ref": "#/definitions/sessionRecordReference"
        },
        "conversationId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "messageId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "observedAt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "format": "date-time"
        },
        "actorDid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^did:[a-z0-9]+:[^\\s]+$"
        },
        "extractor": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "extractorVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "reviewedAt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "format": "date-time"
        },
        "reviewerDid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^did:[a-z0-9]+:[^\\s]+$"
        }
      },
      "required": [
        "kind"
      ]
    },
    "sessionNoteText": {
      "type": "string",
      "minLength": 0,
      "maxLength": 32768
    },
    "sessionLabels": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 80
      },
      "uniqueItems": true,
      "maxItems": 64
    }
  }
}
