{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://enbox.id/modules/time-entries/v1/schemas/entry",
  "title": "EntryData",
  "description": "Time Entries: entry record.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "activity": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "startedAt": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "format": "date-time"
    },
    "endedAt": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "format": "date-time"
    },
    "durationSeconds": {
      "type": "integer",
      "minimum": 0,
      "maximum": 31536000
    },
    "project": {
      "$ref": "#/definitions/entryRecordReference"
    },
    "task": {
      "$ref": "#/definitions/entryRecordReference"
    },
    "kind": {
      "type": "string",
      "enum": [
        "work",
        "study",
        "exercise",
        "leisure",
        "other"
      ]
    },
    "notes": {
      "$ref": "https://enbox.id/schemas/common/note-text/v1"
    },
    "source": {
      "$ref": "#/definitions/entrySource"
    },
    "labels": {
      "$ref": "https://enbox.id/schemas/common/labels/v1"
    }
  },
  "required": [
    "activity"
  ],
  "examples": [
    {
      "activity": "Bicycle restoration",
      "durationSeconds": 7200,
      "kind": "leisure"
    }
  ],
  "anyOf": [
    {
      "required": [
        "startedAt"
      ]
    },
    {
      "required": [
        "durationSeconds"
      ]
    }
  ],
  "definitions": {
    "entryRecordReference": {
      "$ref": "https://enbox.id/schemas/common/record-reference/v1"
    },
    "entrySource": {
      "$ref": "https://enbox.id/schemas/common/provenance/v1"
    }
  }
}
