{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://enbox.id/modules/reservations/v1/schemas/reservation",
  "title": "ReservationData",
  "description": "Reservations: reservation record.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "kind": {
      "type": "string",
      "enum": [
        "flight",
        "rail",
        "lodging",
        "rental",
        "restaurant",
        "activity",
        "other"
      ]
    },
    "provider": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "confirmationCode": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "state": {
      "type": "string",
      "enum": [
        "requested",
        "confirmed",
        "changed",
        "completed",
        "cancelled"
      ]
    },
    "startsAt": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "format": "date-time"
    },
    "endsAt": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "format": "date-time"
    },
    "trip": {
      "$ref": "#/definitions/reservationRecordReference"
    },
    "travellers": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      },
      "minItems": 0,
      "maxItems": 100
    },
    "origin": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "destination": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "serviceNumber": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "seatOrRoom": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "address": {
      "$ref": "#/definitions/reservationAddress"
    },
    "price": {
      "$ref": "#/definitions/reservationMoney"
    },
    "cancelBy": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "format": "date-time"
    },
    "documents": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/reservationRecordReference"
      },
      "minItems": 0,
      "maxItems": 30
    },
    "alerts": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/reservationAlert"
      },
      "minItems": 0,
      "maxItems": 20
    },
    "notes": {
      "type": "string",
      "minLength": 0,
      "maxLength": 32768
    },
    "source": {
      "$ref": "#/definitions/reservationSource"
    },
    "labels": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 80
      },
      "uniqueItems": true,
      "maxItems": 64
    }
  },
  "required": [
    "kind",
    "provider",
    "state"
  ],
  "examples": [
    {
      "kind": "lodging",
      "provider": "Example Hotel",
      "state": "confirmed",
      "confirmationCode": "ABC-123"
    }
  ],
  "definitions": {
    "reservationAddress": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "formatted": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "street": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "locality": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "region": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "postalCode": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "countryCode": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2,
          "pattern": "^[A-Z]{2}$"
        }
      },
      "required": [],
      "minProperties": 1
    },
    "reservationAlert": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "at": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "format": "date-time"
        },
        "offsetSeconds": {
          "type": "integer",
          "minimum": -315360000,
          "maximum": 315360000
        },
        "anchor": {
          "type": "string",
          "enum": [
            "start",
            "end",
            "due"
          ]
        },
        "channel": {
          "type": "string",
          "enum": [
            "app",
            "push",
            "email"
          ]
        },
        "enabled": {
          "type": "boolean"
        },
        "snoozedUntil": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "format": "date-time"
        },
        "dismissedAt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "format": "date-time"
        }
      },
      "required": [
        "id"
      ],
      "oneOf": [
        {
          "required": [
            "at"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "offsetSeconds"
                ]
              },
              {
                "required": [
                  "anchor"
                ]
              }
            ]
          }
        },
        {
          "required": [
            "offsetSeconds",
            "anchor"
          ],
          "not": {
            "required": [
              "at"
            ]
          }
        }
      ]
    },
    "reservationMoney": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "amount": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$"
        },
        "currency": {
          "type": "string",
          "minLength": 1,
          "maxLength": 3,
          "pattern": "^[A-Z]{3}$"
        }
      },
      "required": [
        "amount",
        "currency"
      ],
      "description": "Non-negative decimal amount in an explicitly named currency; no floating-point currency conversion."
    },
    "reservationRecordReference": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "recordId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "tenantDid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^did:[a-z0-9]+:[^\\s]+$"
        },
        "moduleUri": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192,
          "format": "uri"
        },
        "modulePath": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "contextId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "messageCid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      },
      "required": [
        "recordId"
      ],
      "description": "A DWN record link. An omitted tenantDid means the DID owning the referring record. A link grants no access."
    },
    "reservationSource": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "user-statement",
            "document-extraction",
            "import",
            "measurement",
            "derived"
          ]
        },
        "uri": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192,
          "format": "uri"
        },
        "record": {
          "$ref": "#/definitions/reservationRecordReference"
        },
        "conversationId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "messageId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "observedAt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "format": "date-time"
        },
        "actorDid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^did:[a-z0-9]+:[^\\s]+$"
        },
        "extractor": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "extractorVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "reviewedAt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "format": "date-time"
        },
        "reviewerDid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^did:[a-z0-9]+:[^\\s]+$"
        }
      },
      "required": [
        "kind"
      ]
    }
  }
}
