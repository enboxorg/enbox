{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://enbox.id/modules/reservations/v1/schemas/change",
  "title": "ChangeData",
  "description": "Reservations: change record.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "changedAt": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "format": "date-time"
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8192
    },
    "newStartsAt": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "format": "date-time"
    },
    "newEndsAt": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "format": "date-time"
    },
    "state": {
      "type": "string",
      "enum": [
        "requested",
        "confirmed",
        "rejected"
      ]
    },
    "document": {
      "$ref": "#/definitions/changeRecordReference"
    },
    "notes": {
      "$ref": "https://enbox.id/schemas/common/note-text/v1"
    },
    "source": {
      "$ref": "#/definitions/changeSource"
    },
    "labels": {
      "$ref": "https://enbox.id/schemas/common/labels/v1"
    }
  },
  "required": [
    "changedAt",
    "description",
    "state"
  ],
  "examples": [
    {
      "changedAt": "2026-01-15T12:00:00Z",
      "description": "Check-in moved one day later",
      "state": "confirmed"
    }
  ],
  "definitions": {
    "changeRecordReference": {
      "$ref": "https://enbox.id/schemas/common/record-reference/v1"
    },
    "changeSource": {
      "$ref": "https://enbox.id/schemas/common/provenance/v1"
    }
  }
}
