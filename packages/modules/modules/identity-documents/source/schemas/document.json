{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://enbox.id/modules/identity-documents/v1/schemas/document",
  "title": "DocumentData",
  "description": "Identity Documents: document record.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "documentType": {
      "type": "string",
      "enum": [
        "passport",
        "national-id",
        "state-id",
        "drivers-licence",
        "other",
        "unknown"
      ]
    },
    "fields": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "fullName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "givenNames": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "minItems": 0,
          "maxItems": 20
        },
        "familyName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "documentNumber": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "personalNumber": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "issuingCountry": {
          "type": "string",
          "minLength": 1,
          "maxLength": 3,
          "pattern": "^[A-Z]{2,3}$"
        },
        "issuingRegion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "issuingAuthority": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "nationalities": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 3,
            "pattern": "^[A-Z]{2,3}$"
          },
          "minItems": 0,
          "maxItems": 10
        },
        "dateOfBirth": {
          "type": "string",
          "minLength": 1,
          "maxLength": 10,
          "format": "date"
        },
        "issueDate": {
          "type": "string",
          "minLength": 1,
          "maxLength": 10,
          "format": "date"
        },
        "expiryDate": {
          "type": "string",
          "minLength": 1,
          "maxLength": 10,
          "format": "date"
        },
        "address": {
          "$ref": "#/definitions/documentAddress"
        },
        "licenceCategories": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "category": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              "validFrom": {
                "type": "string",
                "minLength": 1,
                "maxLength": 10,
                "format": "date"
              },
              "validUntil": {
                "type": "string",
                "minLength": 1,
                "maxLength": 10,
                "format": "date"
              },
              "restrictions": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512
                },
                "minItems": 0,
                "maxItems": 100
              }
            },
            "required": [
              "category"
            ]
          },
          "minItems": 0,
          "maxItems": 100
        }
      },
      "required": [],
      "minProperties": 1
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/documentRecordReference"
      },
      "minItems": 0,
      "maxItems": 50
    },
    "reviewState": {
      "type": "string",
      "enum": [
        "unreviewed",
        "reviewed",
        "corrected",
        "rejected"
      ]
    },
    "alerts": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/documentAlert"
      },
      "minItems": 0,
      "maxItems": 20
    },
    "notes": {
      "$ref": "https://enbox.id/schemas/common/note-text/v1"
    },
    "source": {
      "$ref": "#/definitions/documentSource"
    },
    "labels": {
      "$ref": "https://enbox.id/schemas/common/labels/v1"
    }
  },
  "required": [
    "label",
    "documentType",
    "reviewState"
  ],
  "examples": [
    {
      "label": "Personal passport",
      "documentType": "passport",
      "reviewState": "unreviewed",
      "fields": {
        "fullName": "Alex Example",
        "documentNumber": "EXAMPLE123",
        "issuingCountry": "GBR"
      }
    }
  ],
  "definitions": {
    "documentAddress": {
      "$ref": "https://enbox.id/schemas/common/address/v1"
    },
    "documentAlert": {
      "$ref": "https://enbox.id/schemas/common/alert/v1"
    },
    "documentRecordReference": {
      "$ref": "https://enbox.id/schemas/common/record-reference/v1"
    },
    "documentSource": {
      "$ref": "https://enbox.id/schemas/common/provenance/v1"
    }
  }
}
