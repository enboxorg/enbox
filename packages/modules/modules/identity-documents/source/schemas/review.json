{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://enbox.id/modules/identity-documents/v1/schemas/review",
  "title": "ReviewData",
  "description": "Identity Documents: review record.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "reviewedAt": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "format": "date-time"
    },
    "decision": {
      "type": "string",
      "enum": [
        "accepted",
        "corrected",
        "rejected"
      ]
    },
    "extraction": {
      "$ref": "#/definitions/reviewRecordReference"
    },
    "corrections": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "fullName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "givenNames": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "minItems": 0,
          "maxItems": 20
        },
        "familyName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "documentNumber": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "personalNumber": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "issuingCountry": {
          "type": "string",
          "minLength": 1,
          "maxLength": 3,
          "pattern": "^[A-Z]{2,3}$"
        },
        "issuingRegion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "issuingAuthority": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "nationalities": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 3,
            "pattern": "^[A-Z]{2,3}$"
          },
          "minItems": 0,
          "maxItems": 10
        },
        "dateOfBirth": {
          "type": "string",
          "minLength": 1,
          "maxLength": 10,
          "format": "date"
        },
        "issueDate": {
          "type": "string",
          "minLength": 1,
          "maxLength": 10,
          "format": "date"
        },
        "expiryDate": {
          "type": "string",
          "minLength": 1,
          "maxLength": 10,
          "format": "date"
        },
        "address": {
          "$ref": "#/definitions/reviewAddress"
        },
        "licenceCategories": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "category": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              "validFrom": {
                "type": "string",
                "minLength": 1,
                "maxLength": 10,
                "format": "date"
              },
              "validUntil": {
                "type": "string",
                "minLength": 1,
                "maxLength": 10,
                "format": "date"
              },
              "restrictions": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512
                },
                "minItems": 0,
                "maxItems": 100
              }
            },
            "required": [
              "category"
            ]
          },
          "minItems": 0,
          "maxItems": 100
        }
      },
      "required": [],
      "minProperties": 1
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8192
    },
    "notes": {
      "$ref": "https://enbox.id/schemas/common/note-text/v1"
    },
    "source": {
      "$ref": "#/definitions/reviewSource"
    },
    "labels": {
      "$ref": "https://enbox.id/schemas/common/labels/v1"
    }
  },
  "required": [
    "reviewedAt",
    "decision"
  ],
  "examples": [
    {
      "reviewedAt": "2026-01-15T12:00:00Z",
      "decision": "accepted"
    }
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "decision": {
            "const": "corrected"
          }
        }
      },
      "then": {
        "required": [
          "corrections"
        ]
      }
    }
  ],
  "definitions": {
    "reviewAddress": {
      "$ref": "https://enbox.id/schemas/common/address/v1"
    },
    "reviewRecordReference": {
      "$ref": "https://enbox.id/schemas/common/record-reference/v1"
    },
    "reviewSource": {
      "$ref": "https://enbox.id/schemas/common/provenance/v1"
    }
  }
}
