{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://enbox.id/modules/identity-documents/v1/schemas/document",
  "title": "DocumentData",
  "description": "One identity document issuance. Keep common holder and issuer details with the document number and validity period.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/documentRecordReference"
      },
      "minItems": 0,
      "maxItems": 50
    },
    "reviewState": {
      "type": "string",
      "enum": [
        "unreviewed",
        "reviewed",
        "corrected",
        "rejected"
      ]
    },
    "alerts": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/documentAlert"
      },
      "minItems": 0,
      "maxItems": 20
    },
    "notes": {
      "$ref": "#/definitions/documentNoteText"
    },
    "source": {
      "$ref": "#/definitions/documentSource"
    },
    "labels": {
      "$ref": "#/definitions/documentLabels"
    },
    "documentType": {
      "type": "string",
      "enum": [
        "passport",
        "national-id",
        "state-id",
        "drivers-licence",
        "other",
        "unknown"
      ],
      "description": "Kind of the physical or digital identity document. Use unknown until the evidence identifies a kind."
    },
    "fields": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "holder": {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "fullName": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            "givenNames": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "minItems": 1,
              "maxItems": 20
            },
            "familyName": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "personalNumber": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "description": "Identifier of the holder as printed. Preserve leading zeros."
            },
            "dateOfBirth": {
              "type": "string",
              "minLength": 1,
              "maxLength": 10,
              "format": "date"
            },
            "nationalities": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 3,
                "pattern": "^[A-Z]{2,3}$"
              },
              "minItems": 1,
              "maxItems": 10
            },
            "address": {
              "$ref": "#/definitions/documentAddress"
            }
          }
        },
        "issuer": {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            "country": {
              "type": "string",
              "pattern": "^[A-Z]{2,3}$",
              "description": "Use the supplied two- or three-letter country code. Preserve the source evidence for other representations."
            },
            "region": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            }
          }
        },
        "documentNumber": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "description": "Identifier of this document issuance. Store passport, ID card and licence numbers here as strings."
        },
        "issueDate": {
          "type": "string",
          "minLength": 1,
          "maxLength": 10,
          "format": "date"
        },
        "expiryDate": {
          "type": "string",
          "minLength": 1,
          "maxLength": 10,
          "format": "date"
        },
        "drivingPrivileges": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "category": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              "validFrom": {
                "type": "string",
                "minLength": 1,
                "maxLength": 10,
                "format": "date"
              },
              "validUntil": {
                "type": "string",
                "minLength": 1,
                "maxLength": 10,
                "format": "date"
              },
              "restrictions": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512
                },
                "minItems": 0,
                "maxItems": 100
              }
            },
            "required": [
              "category"
            ]
          },
          "minItems": 1,
          "maxItems": 100,
          "description": "One item per printed licence class. Preserve jurisdiction-specific designations and restrictions."
        },
        "passportTypeCode": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16,
          "description": "Document type code as printed on the passport. Omit when absent."
        }
      }
    }
  },
  "required": [
    "label",
    "documentType",
    "reviewState"
  ],
  "examples": [
    {
      "label": "Driving licence",
      "documentType": "drivers-licence",
      "reviewState": "reviewed",
      "fields": {
        "holder": {
          "fullName": "Alex Example"
        },
        "issuer": {
          "name": "Example licensing authority",
          "region": "Example region"
        },
        "documentNumber": "000DEMO123",
        "expiryDate": "2031-04-15",
        "drivingPrivileges": [
          {
            "category": "B",
            "restrictions": [
              "Corrective lenses"
            ]
          }
        ]
      },
      "sources": [
        {
          "recordId": "example-scan"
        }
      ]
    }
  ],
  "allOf": [
    {
      "if": {
        "required": [
          "fields"
        ],
        "properties": {
          "fields": {
            "type": "object",
            "required": [
              "drivingPrivileges"
            ]
          }
        }
      },
      "then": {
        "required": [
          "documentType"
        ],
        "properties": {
          "documentType": {
            "const": "drivers-licence"
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "fields"
        ],
        "properties": {
          "fields": {
            "type": "object",
            "required": [
              "passportTypeCode"
            ]
          }
        }
      },
      "then": {
        "required": [
          "documentType"
        ],
        "properties": {
          "documentType": {
            "const": "passport"
          }
        }
      }
    }
  ],
  "definitions": {
    "documentAlert": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "at": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "format": "date-time"
        },
        "offsetSeconds": {
          "type": "integer",
          "minimum": -315360000,
          "maximum": 315360000
        },
        "anchor": {
          "type": "string",
          "enum": [
            "start",
            "end",
            "due"
          ]
        },
        "channel": {
          "type": "string",
          "enum": [
            "app",
            "push",
            "email"
          ]
        },
        "enabled": {
          "type": "boolean"
        },
        "snoozedUntil": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "format": "date-time"
        },
        "dismissedAt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "format": "date-time"
        }
      },
      "required": [
        "id"
      ],
      "oneOf": [
        {
          "required": [
            "at"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "offsetSeconds"
                ]
              },
              {
                "required": [
                  "anchor"
                ]
              }
            ]
          }
        },
        {
          "required": [
            "offsetSeconds",
            "anchor"
          ],
          "not": {
            "required": [
              "at"
            ]
          }
        }
      ]
    },
    "documentRecordReference": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "recordId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "tenantDid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^did:[a-z0-9]+:[^\\s]+$"
        },
        "moduleUri": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192,
          "format": "uri"
        },
        "modulePath": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "contextId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "messageCid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      },
      "required": [
        "recordId"
      ],
      "description": "A DWN record link. An omitted tenantDid means the DID owning the referring record. A link grants no access."
    },
    "documentSource": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "user-statement",
            "document-extraction",
            "import",
            "measurement",
            "derived"
          ]
        },
        "uri": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192,
          "format": "uri"
        },
        "record": {
          "$ref": "#/definitions/documentRecordReference"
        },
        "conversationId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "messageId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "observedAt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "format": "date-time"
        },
        "actorDid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^did:[a-z0-9]+:[^\\s]+$"
        },
        "extractor": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "extractorVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "reviewedAt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "format": "date-time"
        },
        "reviewerDid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^did:[a-z0-9]+:[^\\s]+$"
        }
      },
      "required": [
        "kind"
      ]
    },
    "documentNoteText": {
      "type": "string",
      "minLength": 0,
      "maxLength": 32768
    },
    "documentLabels": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 80
      },
      "uniqueItems": true,
      "maxItems": 64
    },
    "documentAddress": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "formatted": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "street": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "locality": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "region": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "postalCode": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "countryCode": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2,
          "pattern": "^[A-Z]{2}$"
        }
      },
      "required": [],
      "minProperties": 1
    }
  }
}
