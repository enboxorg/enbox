{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://enbox.id/modules/debts-loans/v1/schemas/loan",
  "title": "LoanData",
  "description": "Debts and Loans: loan record.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "direction": {
      "type": "string",
      "enum": [
        "borrowed",
        "lent"
      ]
    },
    "counterparty": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "contact": {
      "$ref": "#/definitions/loanRecordReference"
    },
    "principal": {
      "$ref": "#/definitions/loanMoney"
    },
    "startedOn": {
      "type": "string",
      "minLength": 1,
      "maxLength": 10,
      "format": "date"
    },
    "dueOn": {
      "type": "string",
      "minLength": 1,
      "maxLength": 10,
      "format": "date"
    },
    "state": {
      "type": "string",
      "enum": [
        "active",
        "settled",
        "forgiven",
        "disputed"
      ]
    },
    "annualRatePercent": {
      "type": "number",
      "minimum": 0,
      "maximum": 1000
    },
    "terms": {
      "type": "string",
      "minLength": 1,
      "maxLength": 16384
    },
    "agreement": {
      "$ref": "#/definitions/loanRecordReference"
    },
    "notes": {
      "$ref": "https://enbox.id/schemas/common/note-text/v1"
    },
    "source": {
      "$ref": "#/definitions/loanSource"
    },
    "labels": {
      "$ref": "https://enbox.id/schemas/common/labels/v1"
    }
  },
  "required": [
    "direction",
    "counterparty",
    "principal",
    "state"
  ],
  "examples": [
    {
      "direction": "lent",
      "counterparty": "Alex",
      "principal": {
        "amount": "40",
        "currency": "GBP"
      },
      "state": "active"
    }
  ],
  "definitions": {
    "loanMoney": {
      "$ref": "https://enbox.id/schemas/common/money/v1"
    },
    "loanRecordReference": {
      "$ref": "https://enbox.id/schemas/common/record-reference/v1"
    },
    "loanSource": {
      "$ref": "https://enbox.id/schemas/common/provenance/v1"
    }
  }
}
