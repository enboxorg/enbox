{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://enbox.id/modules/relationships/v1/schemas/connection",
  "title": "ConnectionData",
  "description": "Relationships: connection record.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "peerDid": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^did:[a-z0-9]+:[^\\s]+$"
    },
    "direction": {
      "type": "string",
      "enum": [
        "incoming",
        "outgoing"
      ]
    },
    "state": {
      "type": "string",
      "enum": [
        "requested",
        "accepted",
        "declined",
        "ended"
      ]
    },
    "requestedAt": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "format": "date-time"
    },
    "respondedAt": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "format": "date-time"
    },
    "evidence": {
      "$ref": "#/definitions/connectionRecordReference"
    },
    "contact": {
      "$ref": "#/definitions/connectionRecordReference"
    },
    "notes": {
      "$ref": "https://enbox.id/schemas/common/note-text/v1"
    },
    "source": {
      "$ref": "#/definitions/connectionSource"
    },
    "labels": {
      "$ref": "https://enbox.id/schemas/common/labels/v1"
    }
  },
  "required": [
    "peerDid",
    "direction",
    "state"
  ],
  "examples": [
    {
      "peerDid": "did:example:friend",
      "direction": "outgoing",
      "state": "requested"
    }
  ],
  "definitions": {
    "connectionRecordReference": {
      "$ref": "https://enbox.id/schemas/common/record-reference/v1"
    },
    "connectionSource": {
      "$ref": "https://enbox.id/schemas/common/provenance/v1"
    }
  }
}
