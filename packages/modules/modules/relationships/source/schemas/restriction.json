{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://enbox.id/modules/relationships/v1/schemas/restriction",
  "title": "RestrictionData",
  "description": "Relationships: restriction record.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "targetDid": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^did:[a-z0-9]+:[^\\s]+$"
    },
    "kind": {
      "type": "string",
      "enum": [
        "block",
        "mute"
      ]
    },
    "active": {
      "type": "boolean"
    },
    "startsAt": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "format": "date-time"
    },
    "endsAt": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "format": "date-time"
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "notes": {
      "$ref": "https://enbox.id/schemas/common/note-text/v1"
    },
    "source": {
      "$ref": "#/definitions/restrictionSource"
    },
    "labels": {
      "$ref": "https://enbox.id/schemas/common/labels/v1"
    }
  },
  "required": [
    "targetDid",
    "kind",
    "active"
  ],
  "examples": [
    {
      "targetDid": "did:example:other",
      "kind": "mute",
      "active": true
    }
  ],
  "definitions": {
    "restrictionRecordReference": {
      "$ref": "https://enbox.id/schemas/common/record-reference/v1"
    },
    "restrictionSource": {
      "$ref": "https://enbox.id/schemas/common/provenance/v1"
    }
  }
}
