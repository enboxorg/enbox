{
  "id": "tasks",
  "name": "Tasks",
  "category": "General personal records",
  "description": "Actions, deadlines, completion state, and native alert/checklist data.",
  "moduleUri": "https://enbox.id/modules/tasks/v1",
  "exportName": "TasksModule",
  "status": "experimental",
  "definitionFile": "definition.json",
  "examplesFile": "examples.json",
  "captureExamples": [
    "I need to call the dentist tomorrow."
  ],
  "dependencies": {},
  "records": [
    {
      "path": "task",
      "type": "task",
      "dataFormats": [
        "application/json"
      ],
      "encryptionRequired": true,
      "schema": "https://enbox.id/modules/tasks/v1/schemas/task",
      "schemaFile": "schemas/task.json",
      "role": false,
      "immutable": false,
      "singleton": false
    },
    {
      "path": "task/checklistItem",
      "type": "checklistItem",
      "dataFormats": [
        "application/json"
      ],
      "encryptionRequired": true,
      "schema": "https://enbox.id/modules/tasks/v1/schemas/checklist-item",
      "schemaFile": "schemas/checklist-item.json",
      "role": false,
      "immutable": false,
      "singleton": false
    },
    {
      "path": "state",
      "type": "state",
      "dataFormats": [
        "application/json"
      ],
      "encryptionRequired": true,
      "schema": "https://enbox.id/modules/tasks/v1/schemas/state",
      "schemaFile": "schemas/state.json",
      "role": false,
      "immutable": false,
      "singleton": false
    },
    {
      "path": "task/editor",
      "type": "editor",
      "dataFormats": [
        "application/json"
      ],
      "encryptionRequired": false,
      "schema": "https://enbox.id/modules/tasks/v1/schemas/editor",
      "schemaFile": "schemas/editor.json",
      "role": true,
      "immutable": true,
      "singleton": false
    },
    {
      "path": "task/viewer",
      "type": "viewer",
      "dataFormats": [
        "application/json"
      ],
      "encryptionRequired": false,
      "schema": "https://enbox.id/modules/tasks/v1/schemas/viewer",
      "schemaFile": "schemas/viewer.json",
      "role": true,
      "immutable": true,
      "singleton": false
    }
  ]
}
