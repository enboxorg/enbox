{
  "id": "tasks",
  "name": "Tasks",
  "category": "General personal records",
  "description": "Actions, deadlines, completion state, and native alert/checklist data.",
  "moduleUri": "https://enbox.id/modules/tasks/v1",
  "exportName": "TasksModule",
  "status": "experimental",
  "definitionFile": "definition.json",
  "examplesFile": "examples.json",
  "captureExamples": [
    "I need to call the dentist tomorrow."
  ],
  "dependencies": {
    "collaboration": "https://enbox.id/modules/collaboration/v1"
  },
  "records": [
    {
      "path": "task",
      "type": "task",
      "dataFormats": [
        "application/json"
      ],
      "encryptionRequired": true,
      "schema": "https://enbox.id/modules/tasks/v1/schemas/task",
      "schemaFile": "schemas/task.json",
      "role": false,
      "immutable": false,
      "singleton": false
    },
    {
      "path": "task/checklistItem",
      "type": "checklistItem",
      "dataFormats": [
        "application/json"
      ],
      "encryptionRequired": true,
      "schema": "https://enbox.id/modules/tasks/v1/schemas/checklist-item",
      "schemaFile": "schemas/checklist-item.json",
      "role": false,
      "immutable": false,
      "singleton": false
    },
    {
      "path": "state",
      "type": "state",
      "dataFormats": [
        "application/json"
      ],
      "encryptionRequired": true,
      "schema": "https://enbox.id/modules/tasks/v1/schemas/state",
      "schemaFile": "schemas/state.json",
      "role": false,
      "immutable": false,
      "singleton": false
    },
    {
      "path": "task/editor",
      "type": "editor",
      "dataFormats": [
        "application/json"
      ],
      "encryptionRequired": false,
      "schema": "https://enbox.id/modules/tasks/v1/schemas/editor",
      "schemaFile": "schemas/editor.json",
      "role": true,
      "immutable": true,
      "singleton": false
    },
    {
      "path": "task/viewer",
      "type": "viewer",
      "dataFormats": [
        "application/json"
      ],
      "encryptionRequired": false,
      "schema": "https://enbox.id/modules/tasks/v1/schemas/viewer",
      "schemaFile": "schemas/viewer.json",
      "role": true,
      "immutable": true,
      "singleton": false
    },
    {
      "path": "space/task",
      "type": "task",
      "dataFormats": [
        "application/json"
      ],
      "encryptionRequired": true,
      "schema": "https://enbox.id/modules/tasks/v1/schemas/task",
      "schemaFile": "schemas/task.json",
      "role": false,
      "immutable": false,
      "singleton": false
    },
    {
      "path": "space/task/checklistItem",
      "type": "checklistItem",
      "dataFormats": [
        "application/json"
      ],
      "encryptionRequired": true,
      "schema": "https://enbox.id/modules/tasks/v1/schemas/checklist-item",
      "schemaFile": "schemas/checklist-item.json",
      "role": false,
      "immutable": false,
      "singleton": false
    }
  ],
  "capture": {
    "identity": "Match the selected task record, project and intended action.",
    "exclude": [
      "A calendar appointment or habit check-in as the same task fact."
    ],
    "workflow": "Maintain actionable state and shared checklists; keep private reminders and pinning in owner-local state."
  },
  "notes": [
    "The same module and payload schemas support two ownership choices. Use task for an independent record or space/task when the user selects an existing Collaboration space. The selected space supplies its membership."
  ]
}
