{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://enbox.id/modules/tasks/v1/schemas/checklist-item",
  "title": "ChecklistItemData",
  "description": "Tasks: checklistItem record.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "completed": {
      "type": "boolean"
    },
    "completedAt": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "format": "date-time"
    },
    "order": {
      "type": "number",
      "minimum": 0,
      "maximum": 1000000000
    },
    "notes": {
      "$ref": "https://enbox.id/schemas/common/note-text/v1"
    },
    "source": {
      "$ref": "#/definitions/checklistItemSource"
    },
    "labels": {
      "$ref": "https://enbox.id/schemas/common/labels/v1"
    }
  },
  "required": [
    "text",
    "completed"
  ],
  "examples": [
    {
      "text": "Find the phone number",
      "completed": false
    }
  ],
  "definitions": {
    "checklistItemRecordReference": {
      "$ref": "https://enbox.id/schemas/common/record-reference/v1"
    },
    "checklistItemSource": {
      "$ref": "https://enbox.id/schemas/common/provenance/v1"
    }
  }
}
