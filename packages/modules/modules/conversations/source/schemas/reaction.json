{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://enbox.id/modules/conversations/v1/schemas/reaction",
  "title": "ReactionData",
  "description": "Conversations: reaction record.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "value": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "reactedAt": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "format": "date-time"
    },
    "notes": {
      "$ref": "https://enbox.id/schemas/common/note-text/v1"
    },
    "source": {
      "$ref": "#/definitions/reactionSource"
    },
    "labels": {
      "$ref": "https://enbox.id/schemas/common/labels/v1"
    }
  },
  "required": [
    "value"
  ],
  "examples": [
    {
      "value": "\ud83d\udc4d",
      "reactedAt": "2026-01-15T12:00:00Z"
    }
  ],
  "definitions": {
    "reactionRecordReference": {
      "$ref": "https://enbox.id/schemas/common/record-reference/v1"
    },
    "reactionSource": {
      "$ref": "https://enbox.id/schemas/common/provenance/v1"
    }
  }
}
