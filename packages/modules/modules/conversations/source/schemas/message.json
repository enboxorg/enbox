{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://enbox.id/modules/conversations/v1/schemas/message",
  "title": "MessageData",
  "description": "Conversations: message record.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "role": {
      "type": "string",
      "enum": [
        "user",
        "assistant",
        "system",
        "tool"
      ],
      "description": "Source transcript role label. It does not confer instruction, execution, or DWN authorization authority."
    },
    "text": {
      "type": "string",
      "minLength": 0,
      "maxLength": 1000000
    },
    "sentAt": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "format": "date-time"
    },
    "replyTo": {
      "$ref": "#/definitions/messageRecordReference"
    },
    "attachments": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/messageRecordReference"
      },
      "minItems": 0,
      "maxItems": 100
    },
    "externalId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "toolCallId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "toolName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "notes": {
      "$ref": "https://enbox.id/schemas/common/note-text/v1"
    },
    "source": {
      "$ref": "#/definitions/messageSource"
    },
    "labels": {
      "$ref": "https://enbox.id/schemas/common/labels/v1"
    }
  },
  "required": [
    "role",
    "text",
    "sentAt"
  ],
  "examples": [
    {
      "role": "user",
      "text": "Let us plan the kitchen renovation.",
      "sentAt": "2026-01-15T12:00:00Z"
    }
  ],
  "definitions": {
    "messageRecordReference": {
      "$ref": "https://enbox.id/schemas/common/record-reference/v1"
    },
    "messageSource": {
      "$ref": "https://enbox.id/schemas/common/provenance/v1"
    }
  }
}
