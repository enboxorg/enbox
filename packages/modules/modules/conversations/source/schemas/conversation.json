{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://enbox.id/modules/conversations/v1/schemas/conversation",
  "title": "ConversationData",
  "description": "Conversations: conversation record.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "kind": {
      "type": "string",
      "enum": [
        "direct",
        "group",
        "assistant"
      ]
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8192
    },
    "externalId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "state": {
      "type": "string",
      "enum": [
        "active",
        "archived"
      ]
    },
    "notes": {
      "$ref": "https://enbox.id/schemas/common/note-text/v1"
    },
    "source": {
      "$ref": "#/definitions/conversationSource"
    },
    "labels": {
      "$ref": "https://enbox.id/schemas/common/labels/v1"
    }
  },
  "required": [
    "title",
    "kind"
  ],
  "examples": [
    {
      "title": "Kitchen renovation",
      "kind": "assistant"
    }
  ],
  "definitions": {
    "conversationRecordReference": {
      "$ref": "https://enbox.id/schemas/common/record-reference/v1"
    },
    "conversationSource": {
      "$ref": "https://enbox.id/schemas/common/provenance/v1"
    }
  }
}
