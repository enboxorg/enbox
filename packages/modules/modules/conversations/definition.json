{
  "module": "https://enbox.id/modules/conversations/v1",
  "published": true,
  "types": {
    "conversation": {
      "dataFormats": [
        "application/json"
      ],
      "encryptionRequired": true,
      "schema": "https://enbox.id/modules/conversations/v1/schemas/conversation"
    },
    "message": {
      "dataFormats": [
        "application/json"
      ],
      "encryptionRequired": true,
      "schema": "https://enbox.id/modules/conversations/v1/schemas/message"
    },
    "reaction": {
      "dataFormats": [
        "application/json"
      ],
      "encryptionRequired": true,
      "schema": "https://enbox.id/modules/conversations/v1/schemas/reaction"
    },
    "state": {
      "dataFormats": [
        "application/json"
      ],
      "encryptionRequired": true,
      "schema": "https://enbox.id/modules/conversations/v1/schemas/state"
    },
    "editor": {
      "schema": "https://enbox.id/modules/conversations/v1/schemas/editor",
      "dataFormats": [
        "application/json"
      ],
      "encryptionRequired": false
    },
    "viewer": {
      "schema": "https://enbox.id/modules/conversations/v1/schemas/viewer",
      "dataFormats": [
        "application/json"
      ],
      "encryptionRequired": false
    }
  },
  "structure": {
    "conversation": {
      "$size": {
        "max": 1048576
      },
      "$actions": [
        {
          "role": "conversation/editor",
          "can": [
            "read",
            "co-update"
          ]
        },
        {
          "role": "conversation/viewer",
          "can": [
            "read"
          ]
        }
      ],
      "message": {
        "$size": {
          "max": 1048576
        },
        "$actions": [
          {
            "role": "conversation/editor",
            "can": [
              "create",
              "read",
              "update",
              "delete",
              "prune"
            ]
          },
          {
            "role": "conversation/viewer",
            "can": [
              "read"
            ]
          }
        ],
        "reaction": {
          "$size": {
            "max": 1048576
          },
          "$immutable": true,
          "$actions": [
            {
              "role": "conversation/editor",
              "can": [
                "create",
                "read",
                "delete"
              ]
            },
            {
              "role": "conversation/viewer",
              "can": [
                "create",
                "read",
                "delete"
              ]
            }
          ]
        }
      },
      "editor": {
        "$role": true,
        "$immutable": true,
        "$size": {
          "max": 2
        },
        "$actions": [
          {
            "who": "recipient",
            "of": "conversation/editor",
            "can": [
              "read",
              "co-delete"
            ]
          }
        ]
      },
      "viewer": {
        "$role": true,
        "$immutable": true,
        "$size": {
          "max": 2
        },
        "$actions": [
          {
            "who": "recipient",
            "of": "conversation/viewer",
            "can": [
              "read",
              "co-delete"
            ]
          }
        ]
      }
    },
    "state": {
      "$size": {
        "max": 1048576
      }
    }
  }
}
