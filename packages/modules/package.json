{
  "name": "@enbox/modules",
  "version": "0.2.121",
  "description": "Standard reusable DWN module definitions for the Enbox ecosystem",
  "type": "module",
  "main": "./dist/esm/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/types/index.d.ts",
  "scripts": {
    "clean": "rm -rf dist",
    "build:esm": "rm -rf dist/esm dist/types && bun tsc -p tsconfig.json && bun run typecheck:contracts",
    "build": "bun run clean && bun run build:esm",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "test:node": "bun test .spec.ts",
    "test:node:coverage": "bun test --coverage --coverage-reporter=text --coverage-reporter=lcov --coverage-dir=coverage .spec.ts",
    "typecheck:contracts": "bun tsc -p type-tests/tsconfig.json"
  },
  "homepage": "https://github.com/enboxorg/enbox/tree/main/packages/modules#readme",
  "bugs": "https://github.com/enboxorg/enbox/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/enboxorg/enbox.git",
    "directory": "packages/modules"
  },
  "license": "Apache-2.0",
  "files": [
    "dist",
    "schemas",
    "src"
  ],
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/index.js"
    }
  },
  "keywords": [
    "decentralized",
    "dwn",
    "modules",
    "web5"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "bun": ">=1.4.4"
  },
  "dependencies": {
    "@enbox/api": "workspace:*",
    "@enbox/dwn-sdk-js": "workspace:*"
  },
  "devDependencies": {
    "@enbox/agent": "workspace:*",
    "@enbox/dids": "workspace:*",
    "@typescript-eslint/eslint-plugin": "8.72.0",
    "@typescript-eslint/parser": "8.72.0",
    "bun-types": "1.4.3",
    "eslint": "9.7.0",
    "typescript": "5.9.3"
  }
}
