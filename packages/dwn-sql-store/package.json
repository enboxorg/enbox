{
  "name": "@enbox/dwn-sql-store",
  "version": "0.0.45",
  "description": "SQL backed implementations of DWN MessageStore and DataStore",
  "type": "module",
  "license": "Apache-2.0",
  "homepage": "https://github.com/enboxorg/enbox/tree/main/packages/dwn-sql-store#readme",
  "bugs": "https://github.com/enboxorg/enbox/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/enboxorg/enbox.git",
    "directory": "packages/dwn-sql-store"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/esm/src/main.js",
  "module": "./dist/esm/src/main.js",
  "types": "./dist/types/src/main.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/src/main.d.ts",
      "import": "./dist/esm/src/main.js"
    },
    "./s3": {
      "types": "./dist/types/src/data-store-s3.d.ts",
      "import": "./dist/esm/src/data-store-s3.js"
    }
  },
  "react-native": "./dist/esm/src/main.js",
  "dependencies": {
    "@enbox/dwn-sdk-js": "workspace:*",
    "@ipld/dag-cbor": "10.0.1",
    "interface-blockstore": "7.0.1",
    "ipfs-unixfs-exporter": "16.0.2",
    "ipfs-unixfs-importer": "17.0.1",
    "kysely": "0.28.17",
    "multiformats": "14.0.3"
  },
  "peerDependencies": {
    "@aws-sdk/client-s3": "3.700.0",
    "@aws-sdk/lib-storage": "3.700.0"
  },
  "peerDependenciesMeta": {
    "@aws-sdk/client-s3": {
      "optional": true
    },
    "@aws-sdk/lib-storage": {
      "optional": true
    }
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "3.700.0",
    "@aws-sdk/lib-storage": "3.700.0",
    "@types/bun": "1.3.14",
    "@types/node": "22.19.15",
    "@types/pg": "8.10.2",
    "@types/pg-cursor": "2.7.0",
    "@typescript-eslint/eslint-plugin": "8.32.1",
    "@typescript-eslint/parser": "8.32.1",
    "bun-types": "1.3.14",
    "eslint": "9.7.0",
    "mysql2": "3.22.5",
    "pg": "8.11.2",
    "pg-cursor": "2.10.2",
    "typescript": "5.9.3"
  },
  "scripts": {
    "build:esm": "bun run clean && tsc",
    "build": "bun run clean && bun run build:esm",
    "clean": "rm -rf dist compiled",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "test": "bun test --timeout 10000 .spec.ts",
    "test:node:coverage": "bun test --timeout 10000 --coverage --coverage-reporter=text --coverage-reporter=lcov --coverage-dir=coverage .spec.ts"
  },
  "files": [
    "dist",
    "src"
  ],
  "engines": {
    "bun": ">=1.0.0"
  },
  "contributors": [
    {
      "name": "Adam Mika",
      "url": "https://github.com/amika-sq"
    },
    {
      "name": "Moe Jangda",
      "url": "https://github.com/mistermoe"
    },
    {
      "name": "Liran Cohen",
      "url": "https://github.com/lirancohen"
    }
  ]
}
