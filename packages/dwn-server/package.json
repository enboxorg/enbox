{
  "name": "@enbox/dwn-server",
  "type": "module",
  "version": "0.0.3",
  "files": [
    "dist",
    "src"
  ],
  "main": "./dist/esm/src/index.js",
  "module": "./dist/esm/src/index.js",
  "exports": {
    ".": {
      "import": "./dist/esm/src/index.js"
    }
  },
  "bin": {
    "dwn-server": "./dist/esm/src/main.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/enboxorg/enbox.git",
    "directory": "packages/dwn-server"
  },
  "homepage": "https://github.com/enboxorg/enbox/tree/main/packages/dwn-server#readme",
  "bugs": {
    "url": "https://github.com/enboxorg/enbox/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@enbox/common": "workspace:*",
    "@enbox/crypto": "workspace:*",
    "@enbox/dids": "workspace:*",
    "@enbox/dwn-sdk-js": "workspace:*",
    "@enbox/dwn-sql-store": "workspace:*",
    "bytes": "3.1.2",
    "kysely": "^0.26.3",
    "loglevel": "^1.8.1",
    "loglevel-plugin-prefix": "^0.8.4",
    "mysql2": "^3.9.7",
    "pg": "^8.11.2",
    "pg-cursor": "^2.10.2",
    "prom-client": "14.2.0",
    "uuid": "9.0.0",
    "ws": "8.18.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.9",
    "@types/bytes": "3.1.1",
    "@types/node": "20.14.8",
    "@types/sinon": "17.0.3",
    "@types/ws": "8.5.10",
    "@typescript-eslint/eslint-plugin": "8.32.1",
    "@typescript-eslint/parser": "8.32.1",
    "bun-types": "^1.2.4",
    "crypto-browserify": "^3.12.0",
    "esbuild": "0.16.17",
    "eslint": "9.7.0",
    "eslint-plugin-todo-plz": "^1.3.0",
    "http-proxy": "^1.18.1",
    "husky": "^8.0.0",
    "karma": "^6.4.2",
    "karma-chrome-launcher": "^3.2.0",
    "karma-esbuild": "2.2.5",
    "karma-mocha": "^2.0.1",
    "lint-staged": "^15.2.9",
    "multiformats": "11.0.2",
    "puppeteer": "^22.11.2",
    "rimraf": "^5.0.0",
    "sinon": "17.0.1",
    "typescript": "5.5.4"
  },
  "scripts": {
    "build:esm": "bun run clean && tsc",
    "build": "bun run clean && bun run build:esm",
    "clean": "rimraf dist && rimraf generated/*",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "test:node": "bun test .test.ts",
    "test:node:coverage": "bun test --coverage --coverage-reporter=text --coverage-reporter=lcov --coverage-dir=coverage .test.ts",
    "server": "bun run build:esm && bun dist/esm/src/main.js"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "*.{js,ts}": [
      "eslint --fix"
    ]
  }
}
