# Stage 1: Builder - Build the entire monorepo
FROM node:20.10.0-bookworm-slim AS builder

WORKDIR /app

# Enable corepack for pnpm
RUN corepack enable

# Copy monorepo configuration files
COPY pnpm-lock.yaml ./
COPY pnpm-workspace.yaml ./
COPY package.json ./
COPY tsconfig.json ./

# Copy all packages (since dwn-server depends on other packages in the monorepo)
COPY packages/ ./packages/

# Install all dependencies
RUN pnpm install --frozen-lockfile

# Build all packages
RUN pnpm --recursive --stream build

# Stage 2: Native builder - Build native dependencies separately
FROM node:20.10.0-bookworm-slim AS native-builder

# Install build tools with minimal dependencies
RUN apt-get update && \
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
    python3-minimal \
    make \
    g++ \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Build better-sqlite3 separately
WORKDIR /tmp/sqlite-build
RUN npm init -y && \
    npm install better-sqlite3@8.7.0 --build-from-source

# Stage 3: Runner - Minimal runtime image
FROM node:20.10.0-bookworm-slim AS runner

ARG DS_PORT
ENV DS_PORT=${DS_PORT:-3000}

WORKDIR /app

# Copy the entire built monorepo
COPY --from=builder /app ./

# Copy pre-built native modules
COPY --from=native-builder /tmp/sqlite-build/node_modules/better-sqlite3 /app/node_modules/better-sqlite3

# Set working directory to dwn-server for the entrypoint
WORKDIR /app/packages/dwn-server

# Copy and setup entrypoint script
COPY packages/dwn-server/entrypoint.sh ./
RUN chmod +x entrypoint.sh

# Create data directory
RUN mkdir -p data

# Copy package.json to expected location for /info endpoint
RUN mkdir -p /dwn-server && cp package.json /dwn-server/package.json

# Expose port
EXPOSE ${DS_PORT}

# Start the server
ENTRYPOINT ["./entrypoint.sh"]