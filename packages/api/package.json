{
  "name": "@enbox/api",
  "version": "0.0.5",
  "description": "SDK for accessing the features and capabilities of Web5",
  "type": "module",
  "main": "./dist/esm/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/types/index.d.ts",
  "scripts": {
    "clean": "rimraf dist",
    "build:esm": "rimraf dist/esm dist/types && bun tsc -p tsconfig.json",
    "build:browser": "rimraf dist/browser.mjs dist/browser.js && bun build/bundles.js",
    "build:tests:browser": "rimraf tests/compiled && bun build/esbuild-tests.cjs",
    "build": "bun run clean && bun run build:esm && bun run build:browser",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "test:node": "bun test --timeout 10000 .spec.ts",
    "test:node:coverage": "bun test --timeout 10000 --coverage --coverage-reporter=text --coverage-reporter=lcov --coverage-dir=coverage .spec.ts",
    "test:browser": "bun run build:tests:browser && bunx web-test-runner"
  },
  "homepage": "https://github.com/enboxorg/enbox/tree/main/packages/api#readme",
  "bugs": "https://github.com/enboxorg/enbox/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/enboxorg/enbox.git",
    "directory": "packages/api"
  },
  "license": "Apache-2.0",
  "contributors": [
    {
      "name": "Liran Cohen",
      "url": "https://github.com/LiranCohen"
    },
    {
      "name": "Daniel Buchner",
      "url": "https://github.com/csuwildcat"
    },
    {
      "name": "Frank Hinek",
      "url": "https://github.com/frankhinek"
    },
    {
      "name": "Moe Jangda",
      "url": "https://github.com/mistermoe"
    }
  ],
  "files": [
    "dist",
    "src"
  ],
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/index.js"
    },
    "./browser": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/browser.mjs"
    }
  },
  "react-native": "./dist/esm/index.js",
  "keywords": [
    "decentralized",
    "decentralized-applications",
    "decentralized-identity",
    "decentralized-web",
    "DID",
    "sdk",
    "verifiable-credentials",
    "web5",
    "web5-sdk"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "bun": ">=1.0.0"
  },
  "dependencies": {
    "@enbox/agent": "workspace:*",
    "@enbox/common": "workspace:*"
  },
  "devDependencies": {
    "@playwright/test": "1.45.3",
    "@enbox/crypto": "workspace:*",
    "@enbox/dids": "workspace:*",
    "@enbox/dwn-sdk-js": "workspace:*",
    "@types/node": "20.14.8",
    "@types/sinon": "17.0.3",
    "@typescript-eslint/eslint-plugin": "8.32.1",
    "@typescript-eslint/parser": "8.32.1",
    "@web/test-runner": "0.18.2",
    "@web/test-runner-playwright": "0.11.0",
    "bun-types": "latest",
    "esbuild": "0.19.8",
    "eslint": "9.7.0",
    "node-stdlib-browser": "1.2.0",
    "playwright": "1.45.3",
    "rimraf": "4.4.0",
    "sinon": "18.0.0",
    "source-map-loader": "4.0.2",
    "typescript": "5.5.4"
  }
}
