{
  "$schema": "https://railway.app/railway.schema.json",
  "name": "Enbox - DWN Server with Web Wallet and Demo App",
  "description": "Deploy a complete DWN (Decentralized Web Node) server with web wallet and demo applications",
  "icon": "🔐",
  "services": [
    {
      "name": "dwn-server",
      "source": {
        "type": "github",
        "repo": "enboxorg/enbox"
      },
      "build": {
        "builder": "dockerfile",
        "dockerfilePath": "packages/dwn-server/Dockerfile"
      },
      "deploy": {
        "numReplicas": 1,
        "restartPolicyType": "ON_FAILURE"
      },
      "envVars": {
        "DS_PORT": {
          "type": "reference",
          "value": "${{PORT}}"
        },
        "DWN_BASE_URL": {
          "type": "reference", 
          "value": "https://${{RAILWAY_PUBLIC_DOMAIN}}"
        },
        "DWN_TTL_CACHE_URL": {
          "type": "reference",
          "value": "${{postgres.DATABASE_URL}}"
        },
        "DWN_STORAGE_MESSAGES": {
          "type": "reference",
          "value": "${{postgres.DATABASE_URL}}"
        },
        "DWN_STORAGE_DATA": {
          "type": "reference",
          "value": "${{postgres.DATABASE_URL}}"
        },
        "DWN_STORAGE_EVENTS": {
          "type": "reference",
          "value": "${{postgres.DATABASE_URL}}"
        },
        "DWN_STORAGE_RESUMABLE_TASKS": {
          "type": "reference",
          "value": "${{postgres.DATABASE_URL}}"
        },
        "DS_WEBSOCKET_SERVER": "on",
        "MAX_RECORD_DATA_SIZE": "1gb",
        "DWN_SERVER_LOG_LEVEL": "info"
      }
    },
    {
      "name": "web-wallet",
      "source": {
        "type": "github",
        "repo": "enboxorg/enbox"
      },
      "build": {
        "builder": "nixpacks",
        "buildCommand": "cd examples/web-wallet && npm install && npm run build"
      },
      "deploy": {
        "numReplicas": 1,
        "restartPolicyType": "ON_FAILURE",
        "staticPublishPath": "examples/web-wallet/dist"
      },
      "envVars": {
        "VITE_DWN_URL": {
          "type": "reference",
          "value": "https://${{dwn-server.RAILWAY_PUBLIC_DOMAIN}}"
        }
      }
    },
    {
      "name": "dapp-demo",
      "source": {
        "type": "github",
        "repo": "enboxorg/enbox"
      },
      "build": {
        "builder": "nixpacks",
        "buildCommand": "cd examples/dapp-demo && npm install && npm run build"
      },
      "deploy": {
        "numReplicas": 1,
        "restartPolicyType": "ON_FAILURE",
        "staticPublishPath": "examples/dapp-demo/dist"
      },
      "envVars": {
        "VITE_DWN_URL": {
          "type": "reference",
          "value": "https://${{dwn-server.RAILWAY_PUBLIC_DOMAIN}}"
        }
      }
    },
    {
      "name": "postgres",
      "source": {
        "type": "image",
        "image": "postgres:15"
      },
      "envVars": {
        "POSTGRES_DB": "dwn",
        "POSTGRES_USER": "dwn_user",
        "POSTGRES_PASSWORD": {
          "type": "secret"
        }
      },
      "volumes": [
        {
          "mountPath": "/var/lib/postgresql/data",
          "name": "postgres_data"
        }
      ]
    }
  ]
}