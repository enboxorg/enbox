{
  "name": "DWN Server with PostgreSQL",
  "description": "Decentralized Web Node (DWN) server with managed PostgreSQL database for Web5 applications",
  "repository": "https://github.com/enboxorg/enbox",
  "services": [
    {
      "name": "dwn-server",
      "source": {
        "type": "repo",
        "repo": "enboxorg/enbox",
        "branch": "main"
      },
      "build": {
        "builder": "dockerfile",
        "dockerfilePath": "packages/dwn-server/Dockerfile"
      },
      "deploy": {
        "numReplicas": 1,
        "sleepApplication": false,
        "restartPolicyType": "on_failure"
      },
      "envVars": {
        "DS_PORT": "$PORT",
        "DWN_BASE_URL": "https://$RAILWAY_SERVICE_NAME-$RAILWAY_ENVIRONMENT.railway.app",
        "DWN_TTL_CACHE_URL": "$DATABASE_URL",
        "DWN_STORAGE_MESSAGES": "$DATABASE_URL",
        "DWN_STORAGE_DATA": "$DATABASE_URL",
        "DWN_STORAGE_EVENTS": "$DATABASE_URL", 
        "DWN_STORAGE_RESUMABLE_TASKS": "$DATABASE_URL",
        "DS_WEBSOCKET_SERVER": "on",
        "MAX_RECORD_DATA_SIZE": "1gb",
        "DWN_SERVER_LOG_LEVEL": "info"
      },
      "healthcheck": {
        "path": "/info",
        "intervalSeconds": 30,
        "timeoutSeconds": 10
      }
    },
    {
      "name": "postgres",
      "source": {
        "type": "image",
        "image": "postgres:15"
      },
      "envVars": {
        "POSTGRES_DB": "dwn",
        "POSTGRES_USER": "dwn_user", 
        "POSTGRES_PASSWORD": "$POSTGRES_PASSWORD"
      },
      "volume": {
        "name": "postgres_data",
        "path": "/var/lib/postgresql/data"
      }
    }
  ]
}