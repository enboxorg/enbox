{
  "name": "enbox",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/common",
    "packages/crypto",
    "packages/dids",
    "packages/agent",
    "packages/user-agent",
    "packages/proxy-agent",
    "packages/api",
    "packages/identity-agent",
    "packages/browser",
    "packages/dwn-sdk-js",
    "packages/dwn-sql-store",
    "packages/dwn-server",
    "examples/web-wallet",
    "examples/dapp-demo"
  ],
  "scripts": {
    "clean": "./scripts/clean.sh",
    "build": "pnpm --recursive --stream build",
    "test:node": "pnpm --recursive test:node",
    "lint": "pnpm --recursive lint",
    "lint:fix": "pnpm --recursive lint:fix"
  },
  "engines": {
    "node": ">=20.10.0",
    "pnpm": ">=8.0.0"
  },
  "volta": {
    "node": "20.10.0",
    "pnpm": "8.15.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/enboxorg/enbox.git"
  },
  "license": "Apache-2.0",
  "devDependencies": {
    "npkill": "^0.12.2"
  }
}