{
  "name": "enbox",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/common",
    "packages/crypto",
    "packages/dids",
    "packages/agent",
    "packages/user-agent",
    "packages/proxy-agent",
    "packages/api",
    "packages/identity-agent",
    "packages/browser",
    "packages/dwn-sdk-js",
    "packages/dwn-sql-store",
    "packages/dwn-server"
  ],
  "scripts": {
    "clean": "pnpm npkill -d $(pwd)/packages -t dist && pnpm npkill -d $(pwd) -t node_modules",
    "build": "pnpm --recursive --stream build",
    "test:node": "pnpm --recursive test:node",
    "lint": "pnpm --recursive lint",
    "lint:fix": "pnpm --recursive lint:fix",
    "changeset": "changeset",
    "version": "changeset version && pnpm install --no-frozen-lockfile",
    "release": "pnpm build && changeset publish",
    "changeset:status": "changeset status --verbose"
  },
  "engines": {
    "node": ">=20.10.0",
    "pnpm": ">=8.0.0"
  },
  "volta": {
    "node": "20.10.0",
    "pnpm": "8.15.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/enboxorg/enbox.git"
  },
  "license": "Apache-2.0",
  "devDependencies": {
    "@changesets/cli": "^2.29.5",
    "npkill": "^0.12.2"
  }
}