# Terraform local state & working files
*.tfstate
*.tfstate.backup
*.tfstate.*.backup
.terraform/
.terraform-build/
crash.log
crash.*.log

# Lock files in reusable modules (only commit in root configs like bootstrap/)
modules/**/.terraform.lock.hcl
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# tfvars may contain secrets — never commit
*.auto.tfvars
*.auto.tfvars.json
terraform.tfvars
