direction: right

# ---- Styling ----

classes: {
  aws-service: {
    style: {
      border-radius: 8
      fill: "#f0f4ff"
      stroke: "#4a6fa5"
      font-size: 13
    }
  }
  compute: {
    style: {
      border-radius: 8
      fill: "#dbeafe"
      stroke: "#2563eb"
      font-size: 13
    }
  }
  data: {
    style: {
      border-radius: 8
      fill: "#ede9fe"
      stroke: "#7c3aed"
      font-size: 13
    }
  }
  network: {
    style: {
      border-radius: 8
      fill: "#fef3c7"
      stroke: "#d97706"
      font-size: 13
    }
  }
}

# ---- Internet ----

client: {
  label: "Client / Browser"
  shape: cloud
  style: {
    fill: "#f8fafc"
    stroke: "#94a3b8"
    font-size: 14
  }
}

dns: {
  label: "dev.aws.dwn.enbox.id\n(DNS CNAME)"
  class: network
  shape: rectangle
}

# ---- AWS Account ----

aws: {
  label: "AWS Account (us-east-1)"
  style: {
    fill: "#fafafa"
    stroke: "#e2e8f0"
    font-size: 16
    bold: true
  }

  # ---- VPC ----

  vpc: {
    label: "VPC  10.0.0.0/16"
    style: {
      fill: "#ffffff"
      stroke: "#cbd5e1"
      font-size: 14
    }

    # ---- Public Subnets ----

    public: {
      label: "Public Subnets"
      style: {
        fill: "#fffbeb"
        stroke: "#f59e0b"
        font-size: 12
      }

      alb: {
        label: "Application Load Balancer\nHTTPS :443  |  HTTP :80 redirect"
        class: network
      }

      nat: {
        label: "NAT Gateway"
        class: network
      }
    }

    # ---- Private Subnets ----

    private: {
      label: "Private Subnets  (ECS Cluster: dwn-dev)"
      style: {
        fill: "#eff6ff"
        stroke: "#3b82f6"
        font-size: 12
      }

      http: {
        label: "DWN HTTP\nFargate  :3000\n512 CPU / 1024 MB"
        class: compute
      }

      ws: {
        label: "DWN WebSocket\nFargate  :3000\n512 CPU / 1024 MB"
        class: compute
      }

      nats: {
        label: "NATS JetStream\nFargate  :4222\nCloudMap: nats-0.nats.local"
        class: compute
      }
    }

    # ---- Data Subnets ----

    data: {
      label: "Data Subnets"
      style: {
        fill: "#f5f3ff"
        stroke: "#8b5cf6"
        font-size: 12
      }

      aurora: {
        label: "Aurora PostgreSQL 15.8\ndb.t4g.medium\nEncrypted, managed password"
        class: data
        shape: cylinder
      }
    }

    efs: {
      label: "EFS\nNATS persistent storage"
      class: data
      shape: cylinder
    }
  }

  # ---- AWS Services (outside VPC) ----

  services: {
    label: "AWS Services"
    style: {
      fill: "#f0fdf4"
      stroke: "#86efac"
      font-size: 12
    }

    acm: {
      label: "ACM Certificate\ndev.aws.dwn.enbox.id"
      class: aws-service
    }

    ecr: {
      label: "ECR\ndwn-server repo"
      class: aws-service
    }

    sm: {
      label: "Secrets Manager\ndatabase-url\nadmin-token"
      class: aws-service
    }

    s3: {
      label: "S3\ndwn-dev-store-us-east-1\nSSE-S3 encrypted"
      class: aws-service
      shape: cylinder
    }

    cw: {
      label: "CloudWatch\nLogs + Alarms"
      class: aws-service
    }
  }
}

# ---- Connections ----

# Traffic flow
client -> dns: HTTPS {
  style.stroke: "#2563eb"
}
dns -> aws.vpc.public.alb: {
  style.stroke: "#2563eb"
}
aws.vpc.public.alb -> aws.vpc.private.http: "default forward" {
  style.stroke: "#2563eb"
}
aws.vpc.public.alb -> aws.vpc.private.ws: "Upgrade: websocket" {
  style.stroke: "#2563eb"
}

# Internal service connections
aws.vpc.private.http -> aws.vpc.private.nats: "pub/sub" {
  style.stroke: "#059669"
}
aws.vpc.private.ws -> aws.vpc.private.nats: "pub/sub" {
  style.stroke: "#059669"
}

# Data connections
aws.vpc.private.http -> aws.vpc.data.aurora: ":5432" {
  style.stroke: "#7c3aed"
}
aws.vpc.private.ws -> aws.vpc.data.aurora: ":5432" {
  style.stroke: "#7c3aed"
}
aws.vpc.private.http -> aws.services.s3: "S3 API" {
  style.stroke: "#7c3aed"
}
aws.vpc.private.ws -> aws.services.s3: "S3 API" {
  style.stroke: "#7c3aed"
}
aws.vpc.private.nats -> aws.vpc.efs: "EFS mount /data" {
  style.stroke: "#7c3aed"
}

# Supporting service connections (dashed)
aws.vpc.public.alb -> aws.services.acm: "TLS termination" {
  style.stroke-dash: 5
  style.stroke: "#94a3b8"
}
aws.vpc.private.http -> aws.services.sm: "secrets injection" {
  style.stroke-dash: 5
  style.stroke: "#94a3b8"
}
aws.vpc.private.ws -> aws.services.sm: "secrets injection" {
  style.stroke-dash: 5
  style.stroke: "#94a3b8"
}
aws.vpc.private.http -> aws.services.ecr: "image pull" {
  style.stroke-dash: 5
  style.stroke: "#94a3b8"
}
aws.vpc.private.http -> aws.services.cw: "logs" {
  style.stroke-dash: 5
  style.stroke: "#94a3b8"
}
aws.vpc.private.ws -> aws.services.cw: "logs" {
  style.stroke-dash: 5
  style.stroke: "#94a3b8"
}
aws.vpc.private.nats -> aws.services.cw: "logs" {
  style.stroke-dash: 5
  style.stroke: "#94a3b8"
}

# Outbound
aws.vpc.private.http -> aws.vpc.public.nat: "outbound" {
  style.stroke-dash: 5
  style.stroke: "#94a3b8"
}
