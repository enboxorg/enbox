# DWN Server Docker Compose Configuration
# Copy this file to .env to customize the setup

# =====  SERVER CONFIGURATION =====
# Port for the DWN server (default: 3000)
DWN_SERVER_PORT=3000

# Base URL for the DWN server (used for Web5 Connect flows)
# Change this to your actual domain in production
DWN_BASE_URL=http://localhost:3000

# ===== DATABASE CONFIGURATION =====
# PostgreSQL configuration (customize if needed)
# Note: PostgreSQL runs on port 5433 to avoid conflicts with package-level docker-compose
POSTGRES_DB=dwn
POSTGRES_USER=dwn_user
POSTGRES_PASSWORD=dwn_password

# ===== OPTIONAL CONFIGURATION =====
# Maximum record data size (default: 1gb)
# MAX_RECORD_DATA_SIZE=1gb

# Enable debug logging
# LOG_LEVEL=debug

# Terms of service file path (if required)
# DWN_TERMS_OF_SERVICE_FILE_PATH=/app/terms-of-service.txt

# ===== PRODUCTION NOTES =====
# In production, consider:
# 1. Using Docker secrets or external secret management for passwords
# 2. Setting up proper SSL/TLS termination
# 3. Configuring backup strategies for PostgreSQL
# 4. Setting resource limits for containers
# 5. Using external PostgreSQL service for better scalability