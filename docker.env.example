# DWN Server Docker Compose Configuration
# Copy this file to .env to customize the setup

# =====  SERVER CONFIGURATION =====
# Port for the DWN server (default: 3000)
DWN_SERVER_PORT=3000

# Base URL for the DWN server (used for Web5 Connect flows)
# Change this to your actual domain in production
DWN_BASE_URL=http://localhost:3000

# Remote servers refuse an implicit open tenant gate and unbounded usage.
# The package Compose file is for local development; uncomment both lines there.
# Production should configure registration plus both finite quota limits instead.
# DWN_ALLOW_OPEN_TENANTS=true
# DWN_ALLOW_UNBOUNDED_TENANT_USAGE=true

# Metrics require admin authentication by default. Only expose them publicly
# behind an appropriate external network/authentication boundary.
# DWN_PUBLIC_METRICS_ENABLED=true

# ===== DATABASE CONFIGURATION =====
# PostgreSQL configuration (customize if needed)
# Note: PostgreSQL runs on port 5433 to avoid conflicts with package-level docker-compose
POSTGRES_DB=dwn
POSTGRES_USER=dwn_user
POSTGRES_PASSWORD=dwn_password

# ===== OPTIONAL CONFIGURATION =====
# Maximum record data size (default: 100mb; restart required after changing)
# MAX_RECORD_DATA_SIZE=100mb

# Startup-only WebSocket admission limits (all must remain positive)
# DWN_WEBSOCKET_MAX_CONNECTIONS=1000
# DWN_WEBSOCKET_MAX_CONNECTIONS_PER_IP=100
# DWN_WEBSOCKET_MAX_SUBSCRIPTIONS_PER_CONNECTION=64

# Startup-only global tenant quotas. Finite quotas require a SQL message store.
# DWN_QUOTA_MAX_MESSAGES=100000
# DWN_QUOTA_MAX_STORAGE_BYTES=1073741824

# Enable debug logging
# LOG_LEVEL=debug

# Terms of service file path (if required)
# DWN_TERMS_OF_SERVICE_FILE_PATH=/app/terms-of-service.txt

# ===== PRODUCTION NOTES =====
# In production, consider:
# 1. Using Docker secrets or external secret management for passwords
# 2. Setting up proper SSL/TLS termination
# 3. Configuring backup strategies for PostgreSQL
# 4. Setting resource limits for containers
# 5. Using external PostgreSQL service for better scalability
