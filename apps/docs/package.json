{
  "name": "@enbox/docs",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "next build",
    "dev": "next dev",
    "deploy": "wrangler pages deploy out --project-name=enbox-docs",
    "start": "vite preview --outDir out",
    "types:check": "fumadocs-mdx && next typegen && tsc --noEmit",
    "postinstall": "fumadocs-mdx",
    "lint": "biome lint --error-on-warnings",
    "format": "biome format --write"
  },
  "dependencies": {
    "fumadocs-core": "16.17.7",
    "fumadocs-mdx": "15.4.9",
    "fumadocs-ui": "16.17.7",
    "lucide-react": "0.575.0",
    "next": "16.4.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tailwind-merge": "3.5.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/mdx": "2.0.13",
    "@types/node": "25.3.5",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "postcss": "8.5.23",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "wrangler": "4.151.3",
    "@biomejs/biome": "2.4.6"
  }
}
